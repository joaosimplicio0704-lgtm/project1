GameConfig.PetById = {}
for _, pet in ipairs(GameConfig.Pets) do
	GameConfig.PetById[pet.id] = pet
end

function GameConfig.pet(id)
	return GameConfig.PetById[id]
end

---------------------------------------------------------------------------
-- OVOS
---------------------------------------------------------------------------
-- cost em moedas. weight = peso relativo dentro do ovo.

GameConfig.Eggs = {
	{
		id = "starter",
		name = "Ovo Inicial",
