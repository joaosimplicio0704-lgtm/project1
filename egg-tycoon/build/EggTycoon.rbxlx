		unlock = { kind = "rebirths", value = 1 },
		blurb = "Dunas, obeliscos e ruínas soterradas.",
		theme = "desert",
		center = { x = -190, y = 0, z = 329 },
		radius = 105,
		colors = {
			grass = { 248, 214, 136 },
			grassDark = { 232, 184, 104 },
			rock = { 224, 176, 118 },
			sand = { 246, 226, 176 },
			accent = { 255, 196, 90 },
			water = { 120, 220, 232 },
		},
		light = {
			ambience = { 255, 232, 186 },
			glow = { 255, 200, 110 },
			intensity = 1.8,
			range = 270,
			sky = { 255, 214, 160 },
