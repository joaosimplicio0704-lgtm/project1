---------------------------------------------------------------------------
-- FESTA DO HUB
---------------------------------------------------------------------------

-- A praça é o primeiro lugar que a criança vê. Aqui entram bandeirinhas
-- coloridas, balões, estátua do ovo gigante e postes de luz — tudo primitivo,
-- tudo colorido, nada pago. É o que separa "um mapa" de "um lugar".
function World.buildFestival()
	local model = Instance.new("Model")
	model.Name = "Festival"
	model.Parent = root

	-- ESTATUA DO OVO: o mascote do jogo, girando na entrada
	local statue = Instance.new("Model")
	statue.Name = "EggStatue"
	statue.Parent = model

	part({
		Name = "StatueBase",
		Size = Vector3.new(26, 6, 26),
		Position = Vector3.new(0, 3, 150),
		Color = PALETTE.white,
		Material = Style.flat,
	}, statue)

	part({
		Name = "StatueRing",
		Size = Vector3.new(22, 1, 22),
		Position = Vector3.new(0, 6.6, 150),
		Color = PALETTE.gold,
		Material = Enum.Material.Neon,
		CanCollide = false,
	}, statue)

	local bigEgg = ball({
		Name = "EggStatueBody",
		Size = Vector3.new(20, 27, 20),
		Position = Vector3.new(0, 21, 150),
		Color = Color3.fromRGB(255, 244, 214),
		Material = Enum.Material.SmoothPlastic,
	}, statue)
	bigEgg:SetAttribute("Spin", true)

	local rng = Random.new(99)
	for i = 1, 12 do
		local theta = rng:NextNumber() * math.pi * 2
		local phi = math.acos(2 * rng:NextNumber() - 1)
		ball({
			Name = "StatueSpot",
			Size = Vector3.new(3.4, 3.4, 3.4),
			Position = Vector3.new(0, 21, 150) + Vector3.new(
				math.sin(phi) * math.cos(theta) * 10,
				math.cos(phi) * 13,
				math.sin(phi) * math.sin(theta) * 10
			),
			Color = Color3.fromRGB(255, 178, 96),
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
		}, statue)
	end

	-- BANDEIRINHAS: dois arcos de linha colorida cruzando a praça
	local flagColors = {
		Color3.fromRGB(255, 96, 108),
		Color3.fromRGB(255, 206, 61),
		Color3.fromRGB(126, 217, 87),
		Color3.fromRGB(96, 186, 255),
		Color3.fromRGB(178, 130, 255),
	}
	for arc = 1, 2 do
		local angle = arc == 1 and 0.35 or math.pi - 0.35
		local ax = math.cos(angle)
		local az = math.sin(angle)
		for i = -9, 9 do
			local t = i / 9
			local px = ax * t * 150
			local pz = az * t * 150
			local height = 46 + math.cos(t * math.pi / 2) * 16
			local flag = part({
				Name = "Bunting",
				Size = Vector3.new(5.5, 7, 0.5),
				Position = Vector3.new(px, height, pz),
				Color = flagColors[(i % #flagColors) + 1],
				Material = Style.flat,
				CanCollide = false,
			}, model)
			flag.CFrame = CFrame.new(flag.Position) * CFrame.Angles(0, angle, math.rad(180))
		end
	end

	-- POSTES: dois anéis de luz, um na praça e um na borda do hub
	for ring = 1, 2 do
		local count = ring == 1 and 6 or 12
		local radius = ring == 1 and 128 or 220
		for i = 1, count do
			local angle = (i / count) * math.pi * 2
			local x = math.cos(angle) * radius
			local z = math.sin(angle) * radius
			part({
				Name = "HubPost",
				Size = Vector3.new(2.4, 22, 2.4),
				Position = Vector3.new(x, 12, z),
				Color = PALETTE.stoneDark,
				Material = Style.flat,
			}, model)
			local lamp = ball({
				Name = "HubLamp",
				Size = Vector3.new(7, 7, 7),
				Position = Vector3.new(x, 25, z),
				Color = ring == 1 and Color3.fromRGB(255, 236, 170) or Color3.fromRGB(170, 226, 255),
				Material = Enum.Material.Neon,
				Transparency = 0.1,
			}, model)
			local light = Instance.new("PointLight")
			light.Brightness = 1.1
			light.Range = 60
			light.Color = ring == 1 and Color3.fromRGB(255, 226, 160) or Color3.fromRGB(160, 220, 255)
			light.Parent = lamp
		end
	end

	-- BALÕES: sobem em espiral nas laterais, presos por um fio
	local balloonColors = {
		Color3.fromRGB(255, 110, 120),
		Color3.fromRGB(255, 214, 90),
		Color3.fromRGB(120, 220, 130),
		Color3.fromRGB(120, 180, 255),
		Color3.fromRGB(200, 150, 255),
	}
	for cluster = 1, 6 do
		local angle = (cluster / 6) * math.pi * 2 + 0.4
		local cx = math.cos(angle) * 168
		local cz = math.sin(angle) * 168
		for b = 1, 5 do
			local lift = 26 + b * 9
			local spread = 3 + b * 1.2
			ball({
				Name = "Balloon",
				Size = Vector3.new(8, 9.4, 8),
				Position = Vector3.new(cx + math.cos(b * 1.7) * spread, lift, cz + math.sin(b * 1.7) * spread),
				Color = balloonColors[(b % #balloonColors) + 1],
				Material = Style.flat,
				CanCollide = false,
			}, model)
		end
		part({
			Name = "BalloonString",
			Size = Vector3.new(0.3, 34, 0.3),
			Position = Vector3.new(cx, 24, cz),
			Color = Color3.fromRGB(240, 240, 240),
			Material = Style.flat,
			CanCollide = false,
		}, model)
	end
end

---------------------------------------------------------------------------
-- MARCOS (o icone gigante de cada ilha)
---------------------------------------------------------------------------

-- Cada bioma ganha um objeto grande e inconfundível, feito só de peças primitivas.
-- Nada de asset: esfera, cilindro, bloco e cunha em cores chapadas — o mesmo
-- vocabulário visual do resto do mapa, só em escala de "dá pra ver de longe".

-- Nuvem fofa: 4 esferas achatadas. Não colide, só decora.
local function cloud(parent, position, scale, color)
	-- Nuvem fofa de verdade: 7 esferas achatadas em arco, a maior no meio.
	-- Antes eram 4 esferas pequenas e de longe pareciam pedras de gelo.
	local puff = color or Color3.fromRGB(255, 255, 255)
	local lobes = {
		{ -1.55, -0.12, 0.0, 0.72 },
		{ -0.75, 0.16, 0.18, 0.95 },
		{ 0.05, 0.30, -0.10, 1.18 },
		{ 0.85, 0.14, 0.12, 0.92 },
		{ 1.60, -0.14, -0.05, 0.68 },
		{ -0.30, -0.20, 0.55, 0.62 },
		{ 0.45, -0.18, -0.52, 0.58 },
	}
	for i, lobe in ipairs(lobes) do
		local d = lobe[4] * 13 * scale
		part({
			Name = "CloudPuff" .. i,
			Size = Vector3.new(d, d * 0.72, d * 0.86),
			Position = position + Vector3.new(lobe[1] * 13 * scale, lobe[2] * 9 * scale, lobe[3] * 10 * scale),
			Color = puff,
			Material = Enum.Material.SmoothPlastic,
			Transparency = 0.02,
			CanCollide = false,
			Shape = Enum.PartType.Ball,
		}, parent)
	end
end

-- Solta nuvens em círculo ao redor de um ponto, em alturas diferentes.
local function cloudRing(parent, center, radius, height, count, scale, color)
	for i = 1, count do
		local angle = (i / count) * math.pi * 2
		local wobble = (i % 3) * 6
		cloud(
			parent,
			center + Vector3.new(math.cos(angle) * radius, height + wobble, math.sin(angle) * radius),
			scale,
			color
		)
	end
end

local function cone(parent, position, width, height, color, material)
	-- cone feito de cilindro invertido não existe no Roblox; empilhamos blocos
	-- decrescentes. Barato, e a silhueta fica triangular de longe.
	for tier = 1, 5 do
		local t = tier / 5
		local w = width * (1 - t * 0.78)
		part({
			Name = "Cone",
			Size = Vector3.new(w, height / 5 + 0.1, w),
			Position = position + Vector3.new(0, height * t - height / 10, 0),
			Color = color,
			Material = material or Enum.Material.SmoothPlastic,
		}, parent)
	end
end

function World.buildLandmark(biome, parent, base)
	local accent = biome.colors.accent
	local accentColor = Color3.fromRGB(accent[1], accent[2], accent[3])
	local grassColor = Color3.fromRGB(biome.colors.grass[1], biome.colors.grass[2], biome.colors.grass[3])
	local rockColor = Color3.fromRGB(biome.colors.rock[1], biome.colors.rock[2], biome.colors.rock[3])
	local id = biome.id

	-- pedestal comum: um morrinho de terra que assenta o marco
	part({
		Name = "LandmarkBase",
		Size = Vector3.new(46, 8, 46),
		Position = base + Vector3.new(0, 2, 0),
		Color = grassColor,
		Material = Style.flat,
	}, parent)

	if id == "meadow" then
		-- ARVORE MAE: tronco largo com copa de tres bolas gigantes
		part({
			Name = "MotherTrunk",
			Size = Vector3.new(14, 44, 14),
			Position = base + Vector3.new(0, 30, 0),
			Color = PALETTE.wood,
			Material = Style.flat,
		}, parent)
		for i, offset in ipairs({
			{ 0, 58, 0, 30 },
			{ -18, 50, 6, 20 },
			{ 17, 52, -7, 22 },
		}) do
			ball({
				Name = "MotherCrown" .. i,
				Size = Vector3.new(offset[4], offset[4] * 0.82, offset[4]),
				Position = base + Vector3.new(offset[1], offset[2], offset[3]),
				Color = i == 1 and Color3.fromRGB(96, 200, 84) or Color3.fromRGB(74, 176, 70),
				Material = Style.flat,
			}, parent)
		end
		-- balanço pendurado: criança adora
		part({
			Name = "SwingSeat",
			Size = Vector3.new(9, 1.2, 4),
			Position = base + Vector3.new(30, 26, 0),
			Color = PALETTE.woodDark,
			Material = Style.flat,
		}, parent)
		for side = -1, 1, 2 do
			part({
				Name = "SwingRope",
				Size = Vector3.new(0.6, 26, 0.6),
				Position = base + Vector3.new(30 + side * 3.6, 39, 0),
				Color = PALETTE.sand,
				Material = Style.flat,
			}, parent)
		end
	elseif id == "forest" then
		-- COGUMELO GIGANTE BRILHANTE
		part({
			Name = "ShroomStem",
			Size = Vector3.new(18, 40, 18),
			Position = base + Vector3.new(0, 28, 0),
			Color = Color3.fromRGB(255, 246, 232),
			Material = Enum.Material.SmoothPlastic,
		}, parent)
		ball({
			Name = "ShroomCap",
			Size = Vector3.new(52, 26, 52),
			Position = base + Vector3.new(0, 52, 0),
			Color = Color3.fromRGB(255, 96, 108),
			Material = Enum.Material.SmoothPlastic,
		}, parent)
		-- pintas do chapéu
		local spots = { { 0, 62, 0 }, { 18, 56, 8 }, { -17, 57, 6 }, { 6, 56, -18 }, { -8, 58, -14 } }
		for i, spot in ipairs(spots) do
			ball({
				Name = "ShroomSpot" .. i,
				Size = Vector3.new(7, 4, 7),
				Position = base + Vector3.new(spot[1], spot[2], spot[3]),
				Color = Color3.fromRGB(255, 255, 245),
				Material = Enum.Material.SmoothPlastic,
			}, parent)
		end
		local glow = ball({
			Name = "ShroomGlow",
			Size = Vector3.new(20, 14, 20),
			Position = base + Vector3.new(0, 56, 0),
			Color = Color3.fromRGB(168, 255, 200),
			Material = Enum.Material.Neon,
			Transparency = 0.55,
		}, parent)
		local light = Instance.new("PointLight")
		light.Brightness = 1.3
		light.Range = 90
		light.Color = Color3.fromRGB(150, 255, 170)
		light.Parent = glow
	elseif id == "desert" then
		-- PIRAMIDE com porta e sol dourado no topo
		for step = 0, 6 do
			local width = 60 - step * 7.4
			part({
				Name = "PyramidStep",
				Size = Vector3.new(width, 6, width),
				Position = base + Vector3.new(0, 8 + step * 6, 0),
				Color = Color3.fromRGB(240, 206, 140),
				Material = Style.flat,
			}, parent)
		end
		part({
			Name = "PyramidDoor",
			Size = Vector3.new(14, 18, 2),
			Position = base + Vector3.new(0, 15, 24),
			Color = Color3.fromRGB(120, 84, 50),
			Material = Style.flat,
		}, parent)
		ball({
			Name = "SunDisc",
			Size = Vector3.new(22, 22, 4),
			Position = base + Vector3.new(0, 64, 0),
			Color = Color3.fromRGB(255, 214, 70),
			Material = Enum.Material.Neon,
		}, parent)
	elseif id == "ice" then
		-- CRISTAL DE GELO gigante + flocos suspensos
		local spike = part({
			Name = "IceSpike",
			Size = Vector3.new(20, 70, 20),
			Position = base + Vector3.new(0, 40, 0),
			Color = Color3.fromRGB(186, 236, 255),
			Material = Style.flat,
			Transparency = 0.25,
		}, parent)
		spike.CFrame = CFrame.new(spike.Position) * CFrame.Angles(0.1, 0.6, 0.08)
		for i = 1, 4 do
			local angle = (i / 4) * math.pi * 2
			local px = math.cos(angle) * 26
			local pz = math.sin(angle) * 26
			local small = part({
				Name = "IceShard",
				Size = Vector3.new(9, 34, 9),
				Position = base + Vector3.new(px, 24, pz),
				Color = Color3.fromRGB(214, 244, 255),
				Material = Style.flat,
				Transparency = 0.3,
			}, parent)
			small.CFrame = CFrame.new(small.Position) * CFrame.Angles(0.16, angle, -0.2)
		end
		cloudRing(parent, base, 44, 66, 5, 1.5, Color3.fromRGB(240, 252, 255))
	elseif id == "shadow" then
		-- OBELISCO escuro com runas roxas flutuando
		part({
			Name = "Obelisk",
			Size = Vector3.new(18, 78, 18),
			Position = base + Vector3.new(0, 43, 0),
			Color = Color3.fromRGB(52, 44, 78),
			Material = Style.flat,
		}, parent)
		cone(parent, base + Vector3.new(0, 84, 0), 18, 22, Color3.fromRGB(70, 60, 100), Style.flat)
		for i = 1, 5 do
			local rune = part({
				Name = "Rune" .. i,
				Size = Vector3.new(6, 6, 1.6),
				Position = base + Vector3.new(0, 22 + i * 11, 9.4),
				Color = Color3.fromRGB(190, 130, 255),
				Material = Enum.Material.Neon,
				CanCollide = false,
			}, parent)
			local light = Instance.new("PointLight")
			light.Brightness = 1.4
			light.Range = 28
			light.Color = Color3.fromRGB(190, 130, 255)
			light.Parent = rune
		end
	elseif id == "halloween" then
		-- ABOBORA GIGANTE com cara esculpida e vela dentro
		ball({
			Name = "GreatPumpkin",
			Size = Vector3.new(70, 54, 70),
			Position = base + Vector3.new(0, 36, 0),
			Color = Color3.fromRGB(250, 138, 40),
			Material = Enum.Material.SmoothPlastic,
		}, parent)
		part({
			Name = "PumpkinStemLandmark",
			Size = Vector3.new(7, 14, 7),
			Position = base + Vector3.new(0, 66, 0),
			Color = Color3.fromRGB(96, 132, 62),
			Material = Style.flat,
		}, parent)
		-- olhos triangulares (dois blocos girados formam um X) e boca
		for side = -1, 1, 2 do
			local eye = part({
				Name = "Eye",
				Size = Vector3.new(10, 10, 2),
				Position = base + Vector3.new(side * 15, 44, 33),
				Color = Color3.fromRGB(255, 240, 130),
				Material = Enum.Material.Neon,
			}, parent)
			eye.CFrame = CFrame.new(eye.Position) * CFrame.Angles(0, 0, math.pi / 4)
		end
		for i = -2, 2 do
			part({
				Name = "MouthTooth",
				Size = Vector3.new(5, 9, 2),
				Position = base + Vector3.new(i * 7, 22, 34),
				Color = Color3.fromRGB(255, 240, 130),
				Material = Enum.Material.Neon,
			}, parent)
		end
		local fire = ball({
			Name = "PumpkinFire",
			Size = Vector3.new(16, 16, 16),
			Position = base + Vector3.new(0, 28, 0),
			Color = Color3.fromRGB(255, 170, 60),
			Material = Enum.Material.Neon,
			Transparency = 0.35,
		}, parent)
		local light = Instance.new("PointLight")
		light.Brightness = 1.8
		light.Range = 110
		light.Color = Color3.fromRGB(255, 150, 60)
		light.Parent = fire
	else
		-- COSMOS: anel de Saturno com planetinha flutuante
		local ring1 = Instance.new("Part")
		ring1.Name = "Planet"
		ring1.Shape = Enum.PartType.Ball
		ring1.Size = Vector3.new(52, 52, 52)
		ring1.Position = base + Vector3.new(0, 48, 0)
		ring1.Color = Color3.fromRGB(150, 120, 230)
		ring1.Material = Enum.Material.Neon
		ring1.Anchored = true
		ring1.CanCollide = false
		ring1.Parent = parent

		for i = 1, 16 do
			local angle = (i / 16) * math.pi * 2
			local ringPart = part({
				Name = "Ring",
				Size = Vector3.new(7, 0.8, 4),
				Position = base + Vector3.new(math.cos(angle) * 42, 48, math.sin(angle) * 42),
				Color = i % 2 == 0 and Color3.fromRGB(255, 220, 130) or Color3.fromRGB(190, 160, 255),
				Material = Enum.Material.Neon,
				CanCollide = false,
			}, parent)
			ringPart.CFrame = CFrame.new(ringPart.Position) * CFrame.Angles(0, -angle, 0)
		end

		for i, spot in ipairs({ { -34, 70, 14 }, { 30, 26, -18 }, { 16, 78, -26 } }) do
			ball({
				Name = "Moon" .. i,
				Size = Vector3.new(9 + i * 2, 9 + i * 2, 9 + i * 2),
				Position = base + Vector3.new(spot[1], spot[2], spot[3]),
				Color = Color3.fromRGB(220, 210, 255),
				Material = Enum.Material.Neon,
			}, parent)
		end
	end
end

---------------------------------------------------------------------------
-- ICONE DE PREVIA DO PORTAL
---------------------------------------------------------------------------

-- Versão em miniatura do marco de cada ilha, flutuando acima do portal no hub.
-- É a "vitrine" do mundo: quem está na praça vê os 7 destinos sem viajar.
function World.buildPortalIcon(biome, parent, top)
	local accent = biome.colors.accent
	local accentColor = Color3.fromRGB(accent[1], accent[2], accent[3])
	local id = biome.id

	local function blob(name, offset, size, color, material, transparency)
		return ball({
			Name = name,
			Size = size,
			Position = top + offset,
			Color = color,
			Material = material or Enum.Material.SmoothPlastic,
			Transparency = transparency or 0,
		}, parent)
	end

	if id == "meadow" then
		part({
			Name = "IconTrunk",
			Size = Vector3.new(4, 12, 4),
			Position = top + Vector3.new(0, 5, 0),
			Color = PALETTE.wood,
			Material = Style.flat,
		}, parent)
		blob("IconCrown", Vector3.new(0, 13, 0), Vector3.new(13, 11, 13), Color3.fromRGB(96, 200, 84), Style.flat)
		blob(
			"IconCrown",
			Vector3.new(-5, 11, 3),
			Vector3.new(8, 7, 8),
			Color3.fromRGB(255, 186, 214),
			Enum.Material.SmoothPlastic
		)
	elseif id == "forest" then
		part({
			Name = "IconStem",
			Size = Vector3.new(5, 9, 5),
			Position = top + Vector3.new(0, 4, 0),
			Color = Color3.fromRGB(255, 248, 236),
			Material = Enum.Material.SmoothPlastic,
		}, parent)
		blob(
			"IconCap",
			Vector3.new(0, 10, 0),
			Vector3.new(16, 8, 16),
			Color3.fromRGB(255, 96, 108),
			Enum.Material.SmoothPlastic
		)
		local glow = blob(
			"IconGlow",
			Vector3.new(0, 11, 0),
			Vector3.new(14, 9, 14),
			Color3.fromRGB(170, 255, 190),
			Enum.Material.Neon,
			0.55
		)
		local light = Instance.new("PointLight")
		light.Brightness = 1.6
		light.Range = 40
		light.Color = Color3.fromRGB(160, 255, 180)
		light.Parent = glow
	elseif id == "desert" then
		for step = 0, 3 do
			part({
				Name = "IconPyramid",
				Size = Vector3.new(15 - step * 3.2, 3.2, 15 - step * 3.2),
				Position = top + Vector3.new(0, 2 + step * 3.2, 0),
				Color = Color3.fromRGB(240, 206, 140),
				Material = Style.flat,
			}, parent)
		end
		blob("IconSun", Vector3.new(0, 17, 0), Vector3.new(8, 8, 1.6), Color3.fromRGB(255, 214, 70), Enum.Material.Neon)
	elseif id == "ice" then
		local spike = part({
			Name = "IconIce",
			Size = Vector3.new(6, 20, 6),
			Position = top + Vector3.new(0, 11, 0),
			Color = Color3.fromRGB(186, 236, 255),
			Material = Style.flat,
			Transparency = 0.25,
		}, parent)
		spike.CFrame = CFrame.new(spike.Position) * CFrame.Angles(0.12, 0.5, 0.1)
		blob("IconShard", Vector3.new(-7, 6, 2), Vector3.new(4, 12, 4), Color3.fromRGB(214, 244, 255), Style.flat, 0.3)
		blob(
			"IconShard",
			Vector3.new(6, 5, -3),
			Vector3.new(3.4, 10, 3.4),
			Color3.fromRGB(214, 244, 255),
			Style.flat,
			0.3
		)
	elseif id == "shadow" then
		part({
			Name = "IconObelisk",
			Size = Vector3.new(5.4, 21, 5.4),
			Position = top + Vector3.new(0, 11, 0),
			Color = Color3.fromRGB(52, 44, 78),
			Material = Style.flat,
		}, parent)
		local rune = part({
			Name = "IconRune",
			Size = Vector3.new(2.6, 2.6, 0.8),
			Position = top + Vector3.new(0, 13, 3),
			Color = Color3.fromRGB(190, 130, 255),
			Material = Enum.Material.Neon,
		}, parent)
		local light = Instance.new("PointLight")
		light.Brightness = 1.4
		light.Range = 34
		light.Color = Color3.fromRGB(190, 130, 255)
		light.Parent = rune
	elseif id == "halloween" then
		blob(
			"IconPumpkin",
			Vector3.new(0, 9, 0),
			Vector3.new(17, 13, 17),
			Color3.fromRGB(250, 138, 40),
			Enum.Material.SmoothPlastic
		)
		local eye = part({
			Name = "IconEye",
			Size = Vector3.new(2.6, 2.6, 0.8),
			Position = top + Vector3.new(-2.6, 10.5, 8),
			Color = Color3.fromRGB(255, 240, 130),
			Material = Enum.Material.Neon,
		}, parent)
		eye.CFrame = CFrame.new(eye.Position) * CFrame.Angles(0, 0, math.pi / 4)
		local eye2 = part({
			Name = "IconEye",
			Size = Vector3.new(2.6, 2.6, 0.8),
			Position = top + Vector3.new(2.6, 10.5, 8),
			Color = Color3.fromRGB(255, 240, 130),
			Material = Enum.Material.Neon,
		}, parent)
		eye2.CFrame = CFrame.new(eye2.Position) * CFrame.Angles(0, 0, math.pi / 4)
	else
		blob(
			"IconPlanet",
			Vector3.new(0, 10, 0),
			Vector3.new(15, 15, 15),
			Color3.fromRGB(150, 120, 230),
			Enum.Material.Neon
		)
		for i = 1, 8 do
			local angle = (i / 8) * math.pi * 2
			local dot = part({
				Name = "IconRing",
				Size = Vector3.new(2.4, 0.4, 1.4),
				Position = top + Vector3.new(math.cos(angle) * 12, 10, math.sin(angle) * 12),
				Color = i % 2 == 0 and Color3.fromRGB(255, 220, 130) or Color3.fromRGB(190, 160, 255),
				Material = Enum.Material.Neon,
				CanCollide = false,
			}, parent)
			dot.CFrame = CFrame.new(dot.Position) * CFrame.Angles(0, -angle, 0)
		end
	end

	-- brilho embaixo do ícone: separa do céu
	local halo =
		blob("IconHalo", Vector3.new(0, -3, 0), Vector3.new(18, 1.4, 18), accentColor, Enum.Material.Neon, 0.35)
	halo.Shape = Enum.PartType.Cylinder
end

---------------------------------------------------------------------------
-- BIOMAS
---------------------------------------------------------------------------

-- Toda ilha de bioma e feita dos mesmos ingredientes: base rochosa, praia,
-- relevo em grade, decoracao, portal, pedestal do ovo e area de spawn.
-- O que muda vem de Biomes.List (paleta, relevo, quantidades).

local biomeRoot

local function rgb(triple, transparency)
	local c = Color3.fromRGB(triple[1], triple[2], triple[3])
	return c, transparency
end

-- Portais: dois pilares + arco neon + plataforma de ativacao.
-- `targetBiome == nil` significa "portal de volta pro hub".
local function buildPortal(position, look, targetBiome, parent, name)
	local model = Instance.new("Model")
	model.Name = name or ("Portal_" .. (targetBiome and targetBiome.id or "hub"))
	model.Parent = parent

	local accent = look.accent

	-- base
	part({
		Name = "Base",
		Size = Vector3.new(38, 3, 38),
		Position = position + Vector3.new(0, 1.5, 0),
		Color = PALETTE.stone,
		Material = Style.flat,
	}, model)

	part({
		Name = "BaseGlow",
		Size = Vector3.new(33, 0.6, 33),
		Position = position + Vector3.new(0, 3.3, 0),
		Color = Color3.fromRGB(accent[1], accent[2], accent[3]),
		Material = Enum.Material.Neon,
		CanCollide = false,
	}, model)

	-- pilares
	for side = -1, 1, 2 do
		part({
			Name = "Pillar",
			Size = Vector3.new(6, 34, 6),
			Position = position + Vector3.new(side * 15.5, 19, 0),
			Color = PALETTE.stone,
			Material = Style.flat,
		}, model)

		part({
			Name = "PillarCap",
			Size = Vector3.new(8.6, 2, 8.6),
			Position = position + Vector3.new(side * 15.5, 36.4, 0),
			Color = Color3.fromRGB(accent[1], accent[2], accent[3]),
			Material = Enum.Material.Neon,
			CanCollide = false,
		}, model)
	end

	-- arco
	part({
		Name = "Arch",
		Size = Vector3.new(37, 5.4, 6),
		Position = position + Vector3.new(0, 36.4, 0),
		Color = PALETTE.stone,
		Material = Style.flat,
	}, model)

	part({
		Name = "ArchGlow",
		Size = Vector3.new(34, 1, 6.4),
		Position = position + Vector3.new(0, 38.6, 0),
		Color = Color3.fromRGB(accent[1], accent[2], accent[3]),
		Material = Enum.Material.Neon,
		CanCollide = false,
	}, model)

	-- veu do portal (nao colide: o jogador atravessa andando)
	local veil = part({
		Name = "Veil",
		Size = Vector3.new(29, 30, 0.8),
		Position = position + Vector3.new(0, 20, 0),
		Color = Color3.fromRGB(accent[1], accent[2], accent[3]),
		Material = Enum.Material.Neon,
		Transparency = 0.45,
		CanCollide = false,
	}, model)

	local light = Instance.new("PointLight")
	light.Brightness = 1.2
	light.Range = 52
	light.Color = Color3.fromRGB(accent[1], accent[2], accent[3])
	light.Parent = veil

	-- detector de clique para teletransporte
	local detector = Instance.new("ClickDetector")
	detector.Name = "PortalClick"
	detector.MaxActivationDistance = 36
	detector.Parent = veil

	veil:SetAttribute("BiomeId", targetBiome and targetBiome.id or "meadow")
	veil:SetAttribute("Portal", true)

	local zoneName = targetBiome and ("portal_" .. targetBiome.id) or "portal_hub"
	zoneBindings[zoneName] = {
		part = veil,
		detector = detector,
		biomeId = targetBiome and targetBiome.id or nil,
		portal = true,
	}

	-- placa com o nome do destino
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(22, 6)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 44, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = veil

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0
	label.TextStrokeColor3 = Color3.fromRGB(40, 30, 60)
	label.Text = targetBiome and (targetBiome.emoji .. " " .. targetBiome.name) or "🏠 HUB"
	label.Parent = billboard

	-- Prévia do destino: um ícone flutuante grande acima do portal, feito de
	-- peças. A criança vê o que tem do outro lado antes de entrar, e o hub
	-- ganha 7 "estátuas" que dá vontade de visitar.
	if targetBiome then
		local iconModel = Instance.new("Model")
		iconModel.Name = "PortalIcon"
		iconModel.Parent = model
		local top = position + Vector3.new(0, 56, 0)
		World.buildPortalIcon(targetBiome, iconModel, top)
	end

	return model
end

-- Pedestal do ovo: base, anel neon e o ovo com pintinhas + placa.
local function buildEggPedestal(egg, position, parent)
	local model = Instance.new("Model")
	model.Name = "EggStand_" .. egg.id
	model.Parent = parent

	part({
		Name = "Pedestal",
		Size = Vector3.new(14, 3.6, 14),
		Position = position + Vector3.new(0, 1.8, 0),
		Color = PALETTE.white,
		Material = Style.flat,
	}, model)

	part({
		Name = "PedestalRing",
		Size = Vector3.new(11.5, 1, 11.5),
		Position = position + Vector3.new(0, 3.9, 0),
		Color = PALETTE.gold,
		Material = Enum.Material.Neon,
		CanCollide = false,
	}, model)

	local eggPart = ball({
		Name = "Egg_" .. egg.id,
		Size = Vector3.new(9.6, 13.2, 9.6),
		Position = position + Vector3.new(0, 10.6, 0),
		Color = egg.color,
		Material = Enum.Material.SmoothPlastic,
	}, model)

	local rng = Random.new(#egg.id * 977 + 13)
	for i = 1, 9 do
		local theta = rng:NextNumber() * math.pi * 2
		local phi = math.acos(2 * rng:NextNumber() - 1)
		local radius = 4.8
		ball({
			Name = "Spot",
			Size = Vector3.new(1.9, 1.9, 1.9),
			Position = eggPart.Position + Vector3.new(
				math.sin(phi) * math.cos(theta) * radius,
				math.cos(phi) * radius * 1.38,
				math.sin(phi) * math.sin(theta) * radius
			),
			Color = egg.spot,
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
		}, model)
	end

	-- ovo balanca de leve: o cliente anima pela atributo Spin
	eggPart:SetAttribute("EggId", egg.id)
	eggPart:SetAttribute("Spin", true)

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(15, 6)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 10, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = eggPart

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 0.55)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0
	label.TextStrokeColor3 = Color3.fromRGB(70, 55, 90)
	label.Text = egg.name
	label.Parent = billboard

	local price = Instance.new("TextLabel")
	price.Size = UDim2.fromScale(1, 0.4)
	price.Position = UDim2.fromScale(0, 0.58)
	price.BackgroundTransparency = 1
	price.Font = Enum.Font.FredokaOne
	price.TextScaled = true
	price.TextColor3 = PALETTE.gold
	price.TextStrokeTransparency = 0
	price.TextStrokeColor3 = Color3.fromRGB(70, 45, 10)
	price.Text = "🪙 " .. require(ReplicatedStorage.Shared.Format).number(egg.cost)
	price.Parent = billboard

	local detector = Instance.new("ClickDetector")
	detector.Name = "EggClick"
	detector.MaxActivationDistance = 26
	detector.Parent = eggPart

	zoneBindings["egg_" .. egg.id] = { part = eggPart, detector = detector, eggId = egg.id }
	return model
end

-- Decoração por tema, apoiada na altura real do relevo.
-- Enfeites que só aquele bioma tem. É aqui que a ilha deixa de ser "grama com
-- árvore" e vira um lugar com cara própria: flor de cerejeira no vale, cogumelo
-- na floresta, cacto no deserto, boneco de neve no gelo, lápide no sombrio,
-- abóbora no halloween e asteroide no cosmos.
local function themedDecor(biome, cells, home, center, rng)
	local accent = biome.colors.accent
	local accentColor = Color3.fromRGB(accent[1], accent[2], accent[3])
	local id = biome.id

	local function groundAt(angle, radius)
		local lx = math.cos(angle) * radius
		local lz = math.sin(angle) * radius
		return center + Vector3.new(lx, Terrain.heightAtCell(biome, cells, lx, lz), lz)
	end

	local function meadow()
		-- cerejeiras cor-de-rosa e bancos de madeira
		for i = 1, 7 do
			local angle = rng:NextNumber() * math.pi * 2
			local radius = biome.radius * (0.42 + rng:NextNumber() * 0.36)
			local pos = groundAt(angle, radius)
			local scale = 0.8 + rng:NextNumber() * 0.4
			part({
				Name = "CherryTrunk",
				Size = Vector3.new(3 * scale, 14 * scale, 3 * scale),
				Position = pos + Vector3.new(0, 7 * scale, 0),
				Color = Color3.fromRGB(120, 84, 62),
				Material = Style.flat,
			}, home)
			for k = 1, 3 do
				ball({
					Name = "CherryBloom",
					Size = Vector3.new((11 - k) * scale, (7 - k * 0.6) * scale, (11 - k) * scale),
					Position = pos + Vector3.new((k - 2) * 4, (14 + k * 2.4) * scale, (k % 2) * 3),
					Color = k == 2 and Color3.fromRGB(255, 196, 220) or Color3.fromRGB(255, 168, 200),
					Material = Enum.Material.SmoothPlastic,
				}, home)
			end
		end
		for i = 1, 4 do
			local angle = (i / 4) * math.pi * 2 + 0.4
			local pos = groundAt(angle, biome.radius * 0.4)
			part({
				Name = "Bench",
				Size = Vector3.new(10, 1.2, 4),
				Position = pos + Vector3.new(0, 2, 0),
				Color = PALETTE.wood,
				Material = Style.flat,
			}, home)
			for side = -1, 1, 2 do
				part({
					Name = "BenchLeg",
					Size = Vector3.new(1.4, 2.4, 3.4),
					Position = pos + Vector3.new(side * 3.6, 0.8, 0),
					Color = PALETTE.woodDark,
					Material = Style.flat,
				}, home)
			end
		end
	end

	local function forest()
		-- cogumelos luminosos e troncos caídos
		for i = 1, 12 do
			local angle = rng:NextNumber() * math.pi * 2
			local radius = biome.radius * (0.3 + rng:NextNumber() * 0.5)
			local pos = groundAt(angle, radius)
			local scale = 0.5 + rng:NextNumber() * 0.9
			part({
				Name = "ShroomStem",
				Size = Vector3.new(2.4 * scale, 5 * scale, 2.4 * scale),
				Position = pos + Vector3.new(0, 2.5 * scale, 0),
				Color = Color3.fromRGB(255, 248, 236),
				Material = Enum.Material.SmoothPlastic,
			}, home)
			local cap = ball({
				Name = "ShroomCap",
				Size = Vector3.new(7 * scale, 3.4 * scale, 7 * scale),
				Position = pos + Vector3.new(0, 5.4 * scale, 0),
				Color = i % 3 == 0 and Color3.fromRGB(255, 120, 140) or Color3.fromRGB(180, 140, 255),
				Material = Enum.Material.Neon,
				Transparency = 0.15,
			}, home)
			if i % 3 == 0 then
				local glow = Instance.new("PointLight")
				glow.Brightness = 1.1
				glow.Range = 22
				glow.Color = Color3.fromRGB(190, 255, 190)
				glow.Parent = cap
			end
		end
		for i = 1, 5 do
			local angle = rng:NextNumber() * math.pi * 2
			local radius = biome.radius * (0.35 + rng:NextNumber() * 0.45)
			local pos = groundAt(angle, radius)
			local log = part({
				Name = "FallenLog",
				Size = Vector3.new(4, 4, 18),
				Position = pos + Vector3.new(0, 2, 0),
				Color = Color3.fromRGB(96, 72, 52),
				Material = Style.flat,
			}, home)
			log.CFrame = CFrame.new(log.Position) * CFrame.Angles(0, rng:NextNumber() * 3.14, 0)
		end
	end

	local function desert()
		-- cactos com braços, e ossadas de pedra
		for i = 1, 11 do
			local angle = rng:NextNumber() * math.pi * 2
			local radius = biome.radius * (0.3 + rng:NextNumber() * 0.5)
			local pos = groundAt(angle, radius)
			local scale = 0.7 + rng:NextNumber() * 0.8
			part({
				Name = "Cactus",
				Size = Vector3.new(4 * scale, 14 * scale, 4 * scale),
				Position = pos + Vector3.new(0, 7 * scale, 0),
				Color = Color3.fromRGB(96, 168, 96),
				Material = Style.flat,
			}, home)
			for side = -1, 1, 2 do
				part({
					Name = "CactusArm",
					Size = Vector3.new(6 * scale, 1.6 * scale, 2.4 * scale),
					Position = pos + Vector3.new(side * 2.6 * scale, 8 * scale, 0),
					Color = Color3.fromRGB(96, 168, 96),
					Material = Style.flat,
				}, home)
			end
		end
		for i = 1, 3 do
			local angle = (i / 3) * math.pi * 2
			local pos = groundAt(angle, biome.radius * 0.55)
			local rib = part({
				Name = "BoneRib",
				Size = Vector3.new(14, 1.2, 1.2),
				Position = pos + Vector3.new(0, 3, 0),
				Color = Color3.fromRGB(246, 238, 214),
				Material = Style.flat,
			}, home)
			rib.CFrame = CFrame.new(rib.Position) * CFrame.Angles(0.3, angle, 0.25)
		end
	end

	local function ice()
		-- boneco de neve e pinheiros pequenos de gelo
		for i = 1, 3 do
			local angle = (i / 3) * math.pi * 2 + 0.5
			local pos = groundAt(angle, biome.radius * 0.42)
			ball({
				Name = "SnowBase",
				Size = Vector3.new(11, 9, 11),
				Position = pos + Vector3.new(0, 4.5, 0),
				Color = Color3.fromRGB(252, 254, 255),
				Material = Style.flat,
			}, home)
			ball({
				Name = "SnowBelly",
				Size = Vector3.new(8, 7, 8),
				Position = pos + Vector3.new(0, 11.5, 0),
				Color = Color3.fromRGB(252, 254, 255),
				Material = Style.flat,
			}, home)
			ball({
				Name = "SnowHead",
				Size = Vector3.new(5.6, 5.4, 5.6),
				Position = pos + Vector3.new(0, 17, 0),
				Color = Color3.fromRGB(252, 254, 255),
				Material = Style.flat,
			}, home)
			-- cenoura do nariz
			local nose = part({
				Name = "SnowNose",
				Size = Vector3.new(3, 1.2, 1.2),
				Position = pos + Vector3.new(0, 17, 3),
				Color = Color3.fromRGB(255, 150, 60),
				Material = Enum.Material.SmoothPlastic,
			}, home)
			nose.CFrame = CFrame.new(nose.Position) * CFrame.Angles(0, 0, math.rad(-8))
			part({
				Name = "SnowHat",
				Size = Vector3.new(4.4, 3.4, 4.4),
				Position = pos + Vector3.new(0, 20.4, 0),
				Color = Color3.fromRGB(60, 60, 76),
				Material = Style.flat,
			}, home)
			part({
				Name = "SnowScarf",
				Size = Vector3.new(6.8, 1.4, 6.8),
				Position = pos + Vector3.new(0, 14.6, 0),
				Color = Color3.fromRGB(240, 90, 96),
				Material = Style.flat,
			}, home)
		end
		for i = 1, 8 do
			local angle = rng:NextNumber() * math.pi * 2
			local radius = biome.radius * (0.32 + rng:NextNumber() * 0.5)
			local pos = groundAt(angle, radius)
			local scale = 0.6 + rng:NextNumber() * 0.7
			part({
				Name = "IceTreeTrunk",
				Size = Vector3.new(2.4 * scale, 8 * scale, 2.4 * scale),
				Position = pos + Vector3.new(0, 4 * scale, 0),
				Color = Color3.fromRGB(140, 128, 150),
				Material = Style.flat,
			}, home)
			for tier = 1, 3 do
				local w = (7.5 - tier * 1.6) * scale
				part({
					Name = "IceTreeLeaf",
					Size = Vector3.new(w, 4 * scale, w),
					Position = pos + Vector3.new(0, (6.6 + tier * 2.8) * scale, 0),
					Color = Color3.fromRGB(232, 248, 255),
					Material = Style.flat,
				}, home)
			end
		end
	end

	local function shadow()
		-- lápides tortas e lanternas de alma
		for i = 1, 10 do
			local angle = rng:NextNumber() * math.pi * 2
			local radius = biome.radius * (0.28 + rng:NextNumber() * 0.55)
			local pos = groundAt(angle, radius)
			local stone = part({
				Name = "Grave",
				Size = Vector3.new(5, 9, 1.6),
				Position = pos + Vector3.new(0, 4, 0),
				Color = Color3.fromRGB(88, 84, 110),
				Material = Style.flat,
			}, home)
			stone.CFrame = CFrame.new(stone.Position)
				* CFrame.Angles(0, rng:NextNumber() * 3.14, math.rad(rng:NextNumber() * 14 - 7))
			ball({
				Name = "GraveTop",
				Size = Vector3.new(5, 5, 1.6),
				Position = pos + Vector3.new(0, 8.4, 0),
				Color = Color3.fromRGB(88, 84, 110),
				Material = Style.flat,
			}, home)
		end
		for i = 1, 6 do
			local angle = rng:NextNumber() * math.pi * 2
			local radius = biome.radius * (0.34 + rng:NextNumber() * 0.4)
			local pos = groundAt(angle, radius)
			part({
				Name = "LanternPost",
				Size = Vector3.new(1.2, 9, 1.2),
				Position = pos + Vector3.new(0, 4.5, 0),
				Color = Color3.fromRGB(48, 42, 62),
				Material = Style.flat,
			}, home)
			local flame = ball({
				Name = "SoulFlame",
				Size = Vector3.new(3.6, 4.4, 3.6),
				Position = pos + Vector3.new(0, 10.4, 0),
				Color = accentColor,
				Material = Enum.Material.Neon,
				Transparency = 0.25,
			}, home)
			local glow = Instance.new("PointLight")
			glow.Brightness = 1.0
			glow.Range = 30
			glow.Color = accentColor
			glow.Parent = flame
		end
	end

	local function halloween()
		-- abóboras pequenas e velas flutuantes
		for i = 1, 14 do
			local angle = rng:NextNumber() * math.pi * 2
			local radius = biome.radius * (0.28 + rng:NextNumber() * 0.5)
			local pos = groundAt(angle, radius)
			local scale = 0.5 + rng:NextNumber() * 0.8
			ball({
				Name = "SmallPumpkin",
				Size = Vector3.new(7 * scale, 5.4 * scale, 7 * scale),
				Position = pos + Vector3.new(0, 2.7 * scale, 0),
				Color = i % 4 == 0 and Color3.fromRGB(255, 190, 70) or Color3.fromRGB(246, 140, 46),
				Material = Enum.Material.SmoothPlastic,
			}, home)
			part({
				Name = "SmallStem",
				Size = Vector3.new(1.2 * scale, 2 * scale, 1.2 * scale),
				Position = pos + Vector3.new(0, 5.6 * scale, 0),
				Color = Color3.fromRGB(96, 132, 62),
				Material = Style.flat,
			}, home)
		end
		for i = 1, 5 do
			local angle = rng:NextNumber() * math.pi * 2
			local radius = biome.radius * (0.4 + rng:NextNumber() * 0.35)
			local pos = groundAt(angle, radius)
			local candle = ball({
				Name = "GhostCandle",
				Size = Vector3.new(3.2, 5, 3.2),
				Position = pos + Vector3.new(0, 6, 0),
				Color = accentColor,
				Material = Enum.Material.Neon,
				Transparency = 0.3,
			}, home)
			local glow = Instance.new("PointLight")
			glow.Brightness = 1.2
			glow.Range = 26
			glow.Color = accentColor
			glow.Parent = candle
		end
	end

	local function cosmos()
		-- asteroides girando e estrelas caídas
		for i = 1, 10 do
			local angle = rng:NextNumber() * math.pi * 2
			local radius = biome.radius * (0.3 + rng:NextNumber() * 0.55)
			local pos = groundAt(angle, radius)
			local scale = 0.6 + rng:NextNumber() * 1.1
			local rock = ball({
				Name = "Asteroid",
				Size = Vector3.new(6 * scale, 5 * scale, 6.4 * scale),
				Position = pos + Vector3.new(0, 2 * scale, 0),
				Color = Color3.fromRGB(92, 84, 130),
				Material = Style.flat,
			}, home)
			rock.CFrame = CFrame.new(rock.Position)
				* CFrame.Angles(rng:NextNumber(), rng:NextNumber(), rng:NextNumber())
		end
		for i = 1, 7 do
			local angle = rng:NextNumber() * math.pi * 2
			local radius = biome.radius * (0.35 + rng:NextNumber() * 0.45)
			local pos = groundAt(angle, radius)
			local star = ball({
				Name = "FallenStar",
				Size = Vector3.new(3.6, 3.6, 3.6),
				Position = pos + Vector3.new(0, 4, 0),
				Color = Color3.fromRGB(255, 236, 160),
				Material = Enum.Material.Neon,
			}, home)
			local glow = Instance.new("PointLight")
			glow.Brightness = 0.9
			glow.Range = 24
			glow.Color = Color3.fromRGB(255, 236, 160)
			glow.Parent = star
		end
	end

	local themes = {
		meadow = meadow,
		forest = forest,
		desert = desert,
		ice = ice,
		shadow = shadow,
		halloween = halloween,
		cosmos = cosmos,
	}
	local build = themes[id]
	if build then
		build()
	end
end

local function decorateBiome(biome, cells, home, center)
	local spec = biome.decor
	local accent = biome.colors.accent
	local rng = Random.new(biome.seed or 11)

	local function groundAt(angle, radius)
		local lx = math.cos(angle) * radius
		local lz = math.sin(angle) * radius
		return lx, lz, Terrain.heightAtCell(biome, cells, lx, lz)
	end

	-- anel onde a decoração pode nascer: fora do platô do ovo, dentro da ilha
	-- A cerca fica em 0.92 do raio. Aqui a conta desconta o RAIO DA COPA, não
	-- só um número mágico: o perfil "gordo" tem spread 1.25 e a copa chega a
	-- ~10 studs, então uma árvore centrada em 0.82 encostava na cerca.
	-- 0.74 deixa folga para a copa mais larga e mais a escala 1.5.
	local placeable = biome.radius * 0.74
	local innerRing = biome.radius * 0.30

	-- árvores (ou pinheiros / abóboras, conforme o tema)
	for i = 1, spec.trees do
		local angle = rng:NextNumber() * math.pi * 2
		local radius = innerRing + (placeable - innerRing) * rng:NextNumber()
		local x, z, y = groundAt(angle, radius)
		local scale = 0.7 + rng:NextNumber() * 0.8

		if biome.id == "halloween" then
			-- abóbora gigante
			local pos = center + Vector3.new(x, y + 3 * scale, z)
			local pumpkin = ball({
				Name = "Pumpkin",
				Size = Vector3.new(9 * scale, 7 * scale, 9 * scale),
				Position = pos,
				Color = Color3.fromRGB(250, 140, 40),
				Material = Enum.Material.SmoothPlastic,
			}, home)
			ball({
				Name = "PumpkinShade",
				Size = Vector3.new(9.6 * scale, 5 * scale, 9.6 * scale),
				Position = pos,
				Color = Color3.fromRGB(214, 104, 26),
				Material = Enum.Material.SmoothPlastic,
				Transparency = 0.55,
				CanCollide = false,
			}, home)
			part({
				Name = "PumpkinStem",
				Size = Vector3.new(1.6, 3 * scale, 1.6),
				Position = pos + Vector3.new(0, 5 * scale, 0),
				Color = Color3.fromRGB(90, 130, 60),
				Material = Style.flat,
			}, home)
		elseif biome.id == "ice" or biome.id == "forest" then
			-- pinheiro: tronco + 3 cones empilhados
			local pos = center + Vector3.new(x, y, z)
			local trunkColor = biome.id == "ice" and Color3.fromRGB(150, 140, 150) or Color3.fromRGB(110, 80, 55)
			local leafColor = biome.id == "ice" and Color3.fromRGB(226, 244, 255) or Color3.fromRGB(52, 140, 88)
			part({
				Name = "Trunk",
				Size = Vector3.new(2.6 * scale, 9 * scale, 2.6 * scale),
				Position = pos + Vector3.new(0, 4.5 * scale, 0),
				Color = trunkColor,
				Material = Style.flat,
			}, home)
			for tier = 1, 3 do
				local w = (8.5 - tier * 1.7) * scale
				part({
					Name = "Leaf",
					Size = Vector3.new(w, 5.2 * scale, w),
					Position = pos + Vector3.new(0, (7 + tier * 3.4) * scale, 0),
					Color = leafColor,
					Material = Style.flat,
				}, home)
			end
		else
			-- sorteia o perfil: 4 silhuetas diferentes na mesma ilha
			local shape = 1 + math.floor(rng:NextNumber() * #TREE_SHAPES)
			tree(center + Vector3.new(x, y, z), scale, home, biome.colors, shape)
		end
	end

	-- pedras
	for i = 1, spec.rocks do
		local angle = rng:NextNumber() * math.pi * 2
		local radius = innerRing + (placeable - innerRing) * rng:NextNumber()
		local x, z, y = groundAt(angle, radius)
		local scale = 0.8 + rng:NextNumber() * 1.4
		ball({
			Name = "Rock",
			Size = Vector3.new(5 * scale, 4 * scale, 5.5 * scale),
			Position = center + Vector3.new(x, y + 1.2 * scale, z),
			Color = Color3.fromRGB(biome.colors.rock[1], biome.colors.rock[2], biome.colors.rock[3]),
			Material = Style.flat,
		}, home)
	end

	-- flores (só bioma de grama)
	for i = 1, spec.flowers do
		local angle = rng:NextNumber() * math.pi * 2
		local radius = innerRing + (placeable - innerRing) * rng:NextNumber()
		local x, z, y = groundAt(angle, radius)
		flower(center + Vector3.new(x, y, z), home)
	end

	themedDecor(biome, cells, home, center, rng)

	-- cristais brilhantes (gelo, sombrio, cosmos, deserto)
	for i = 1, spec.crystals do
		local angle = rng:NextNumber() * math.pi * 2
		local radius = innerRing + (placeable - innerRing) * rng:NextNumber()
		local x, z, y = groundAt(angle, radius)
		local height = 4 + rng:NextNumber() * 9
		local crystal = part({
			Name = "Crystal",
			Size = Vector3.new(2.4, height, 2.4),
			Position = center + Vector3.new(x, y + height / 2, z),
			Color = Color3.fromRGB(accent[1], accent[2], accent[3]),
			Material = Enum.Material.Neon,
		}, home)
		crystal.CFrame = CFrame.new(crystal.Position) * CFrame.Angles(0.18, rng:NextNumber() * 6.28, -0.14)
	end
end

---------------------------------------------------------------------------
-- CERCA (barreira visual em volta da ilha)
---------------------------------------------------------------------------

-- Cerca cartoon: estacas de madeira gordas com ponta arredondada (uma bola
-- no topo, que é o "cap" do desenho) e duas travessas horizontais.
--
-- Por que cerca e não muro: muro de pedra some no casco da ilha e parece
-- terreno. Estaca com cap lê na hora como "aqui acaba o mapa", que é a
-- função de uma barreira. E é o elemento que separa "plataforma solta no
-- mar" de "ilha de verdade" — todo pack low-poly de ilha tem uma.
--
-- `radius` é onde a cerca fica (um pouco dentro da borda), `segments` é
-- quantas estacas. A cerca acompanha a curva, então usa CFrame para girar
-- cada estaca apontando para o centro.
-- `gateAngle` abre um vão na cerca (o portão). Sem ele a cerca fecha a ilha
-- e o jogador não sai — e uma estaca pode nascer em cima do spawn.
buildFence = function(center, radius, segments, color, accent, parent, yOffset, gateAngle)
	local height = 12
	local postW = 2.6
	local y = yOffset or 0

	-- travessas: dois anéis finos, um no meio e um em cima
	for ring = 0, 1 do
		local railY = y + (ring == 0 and height * 0.42 or height * 0.80)
		for i = 1, segments do
			local a1 = ((i - 1) / segments) * math.pi * 2
			local a2 = (i / segments) * math.pi * 2
			local mid = (a1 + a2) / 2
			local chord = 2 * radius * math.sin((a2 - a1) / 2) * 1.06
			local rail = part({
				Name = "FenceRail",
				Size = Vector3.new(0.9, 0.9, chord),
				Position = center + Vector3.new(math.cos(mid) * radius, railY, math.sin(mid) * radius),
				Color = accent,
				Material = Style.flat,
				CanCollide = true,
			}, parent)
			rail.CFrame = CFrame.new(rail.Position) * CFrame.Angles(0, -mid, 0)
		end
	end

	-- estacas com cap arredondado no topo
	for i = 1, segments do
		local angle = (i / segments) * math.pi * 2
		-- vao do portao: pula as estacas que caem dentro do arco
		local skip = false
		if gateAngle then
			local diff = math.abs(((angle - gateAngle + math.pi) % (math.pi * 2)) - math.pi)
			if diff < 0.30 then
				skip = true
			end
		end
		if not skip then
			local post = part({
				Name = "FencePost",
				Size = Vector3.new(postW, height, postW),
				Position = center + Vector3.new(math.cos(angle) * radius, y + height / 2, math.sin(angle) * radius),
				Color = color,
				Material = Style.flat,
				CanCollide = true,
			}, parent)
			post.CFrame = CFrame.new(post.Position) * CFrame.Angles(0, -angle, 0)

			-- cap: bolinha no topo, o "traço" do desenho
			ball({
				Name = "FenceCap",
				Size = Vector3.new(postW * 1.5, postW * 1.5, postW * 1.5),
				Position = center + Vector3.new(math.cos(angle) * radius, y + height, math.sin(angle) * radius),
				Color = Style.lighten(color, 0.12),
				Material = Style.flat,
				CanCollide = false,
			}, parent)
		end
	end
end

-- Constroi um bioma inteiro e devolve as referências que o servidor precisa.
function World.buildBiome(biome, portalPosition, parent)
	local home = Instance.new("Model")
	home.Name = "Biome_" .. biome.id
	home.Parent = parent

	local center = Biomes.centerVector(biome)
	local colors = biome.colors

	-- CASCO DA ILHA
	-- Uma laje quadrada de 26 studs vira uma "plaquinha" vista de longe. O
	-- casco é feito de camadas cilíndricas que afunilam para baixo, com rocha
	-- irregular na borda: a silhueta fica orgânica e a ilha ganha peso.
	local rockColor = Color3.fromRGB(colors.rock[1], colors.rock[2], colors.rock[3])
	local rockDeep = Color3.fromRGB(colors.rock[1] - 42, colors.rock[2] - 42, colors.rock[3] - 42)
	local rockUnder = Color3.fromRGB(colors.rock[1] - 70, colors.rock[2] - 70, colors.rock[3] - 70)

	for tier = 1, 4 do
		local t = (tier - 1) / 3
		local diameter = biome.radius * (2.24 - t * 0.95)
		local thickness = 11
		local tierPart = part({
			Name = tier == 1 and "Base" or "BaseTier",
			Size = Vector3.new(thickness, diameter, diameter),
			Position = center + Vector3.new(0, -8 - (tier - 1) * 10.2, 0),
			Color = tier == 1 and rockColor or (tier == 2 and rockDeep or rockUnder),
			Material = Style.flat,
			Shape = Enum.PartType.Cylinder,
			CanCollide = tier == 1,
		}, home)
		-- PartType.Cylinder cresce no eixo X: deitar para virar disco
		tierPart.CFrame = CFrame.new(tierPart.Position) * CFrame.Angles(0, 0, math.pi / 2)
	end

	-- ponta cônica embaixo: fecha a ilha com uma agulha de pedra
	for tier = 1, 5 do
		local t = tier / 5
		local diameter = biome.radius * (1.25 - t * 1.05)
		if diameter > 2 then
			local spike = part({
				Name = "BaseSpike",
				Size = Vector3.new(12, diameter, diameter),
				Position = center + Vector3.new(0, -50 - tier * 9, 0),
				Color = rockUnder,
				Material = Style.flat,
				Shape = Enum.PartType.Cylinder,
				CanCollide = false,
			}, home)
			spike.CFrame = CFrame.new(spike.Position) * CFrame.Angles(0, 0, math.pi / 2)
		end
	end

	-- rochas na borda: quebram o círculo perfeito do cilindro
	local edgeRng = Random.new((biome.seed or 7) + 91)
	for i = 1, 18 do
		local angle = (i / 18) * math.pi * 2 + edgeRng:NextNumber() * 0.2
		local radius = biome.radius * (1.04 + edgeRng:NextNumber() * 0.12)
		local scale = 0.5 + edgeRng:NextNumber() * 0.9
		local rock = part({
			Name = "EdgeRock",
			Size = Vector3.new(14 * scale, 11 * scale, 14 * scale),
			Position = center
				+ Vector3.new(math.cos(angle) * radius, -16 - edgeRng:NextNumber() * 14, math.sin(angle) * radius),
			Color = rockDeep,
			Material = Style.flat,
		}, home)
		rock.CFrame = CFrame.new(rock.Position)
			* CFrame.Angles(edgeRng:NextNumber() * 0.6, edgeRng:NextNumber() * 6.28, edgeRng:NextNumber() * 0.6)
	end

	-- PRAIA: disco circular (cilindro achatado) em vez de quadrado
	local beach = part({
		Name = "Beach",
		Size = Vector3.new(3.2, biome.radius * 2.16, biome.radius * 2.16),
		Position = center + Vector3.new(0, -1, 0),
		Color = Color3.fromRGB(colors.sand[1], colors.sand[2], colors.sand[3]),
		Material = Enum.Material.Sand,
		Shape = Enum.PartType.Cylinder,
	}, home)
	beach.CFrame = CFrame.new(beach.Position) * CFrame.Angles(0, 0, math.pi / 2)

	-- relevo em grade
	local cells = Terrain.generate(biome)
	-- Altura do chão no miolo. Serve para assentar ovo, placa, pad e luz: se o
	-- relevo mudar, tudo acompanha em vez de afundar.
	local groundY = Terrain.heightAtCell(biome, cells, 0, 0)
	local cellModel = Instance.new("Model")
	cellModel.Name = "Terrain"
	cellModel.Parent = home

	-- CHÃO CONTÍNUO
	-- As células são blocos de alturas diferentes empilhados em degraus.
	-- Vistos de cima, cada bloco é um quadrado com vão em volta: o chão
	-- parecia um xadrez flutuando sobre a praia, não terreno maciço.
	-- Esta laje única, logo abaixo do relevo, fecha todos os vãos de uma vez.
	-- Material "Ground" e cor da terra: se aparecer em alguma fresta, lê
	-- como solo, não como buraco.
	local floorTop = groundY - Terrain.CellThickness * 0.6
	local groundDisc = part({
		Name = "GroundDisc",
		Size = Vector3.new(Terrain.CellThickness * 2.2, biome.radius * 1.94, biome.radius * 1.94),
		Position = center + Vector3.new(0, floorTop, 0),
		Color = Color3.fromRGB(
			math.max(0, colors.grassDark[1] - 18),
			math.max(0, colors.grassDark[2] - 18),
			math.max(0, colors.grassDark[3] - 18)
		),
		Material = Style.flat,
		CanCollide = true,
		Shape = Enum.PartType.Cylinder,
	}, cellModel)
	groundDisc.CFrame = CFrame.new(groundDisc.Position) * CFrame.Angles(0, 0, math.pi / 2)

	for _, cell in ipairs(cells) do
		local cellPart = part({
			Name = cell.top and "CellTop" or "CellFill",
			Size = Vector3.new(cell.sx, cell.sy, cell.sz),
			Position = center + Vector3.new(cell.x, cell.y, cell.z),
			Color = Color3.fromRGB(cell.color[1], cell.color[2], cell.color[3]),
			Material = cell.kind == "sand" and Enum.Material.Sand or Style.flat,
			CanCollide = true,
		}, cellModel)
		cellPart.TopSurface = Enum.SurfaceType.Smooth
	end

	decorateBiome(biome, cells, home, center)

	-- BARREIRA
	-- A cerca vai na borda da grama (0.92 do raio: dentro do terreno, fora
	-- do caminho do ovo e da decoração, que ocupam até 0.86).
	-- A cor vem do bioma; as travessas são um tom mais claro para dar
	-- contraste sem virar duas cores brigando.
	local fenceRadius = biome.radius * 0.92
	-- portão virado para o hub (caminho de chegada); portal de volta fica dentro
	local toHub = Vector3.new(-center.X, 0, -center.Z)
	local gateAngle = toHub.Magnitude > 1 and math.atan2(toHub.Z, toHub.X) or 0
	-- yOffset é RELATIVO ao centro: buildFence soma center.Y sozinho.
	buildFence(center, fenceRadius, 26, Style.color.wood, Style.color.woodDark, home, groundY + 1.6, gateAngle)

	-- LUZ DO BIOMA
	-- Cada ilha tem a própria luz: sem isso, sombra e ambiente iguais em todo
	-- lugar e a floresta fica com a cara do deserto. São três coisas:
	--   1. uma luz central grande que "aquece" a ilha inteira
	--   2. postes de luz espalhados (visíveis e coloridos, criança adora)
	--   3. um PointLight na placa do bioma, para ler o nome no escuro
	local spec = biome.light
	local ambientColor = Color3.fromRGB(spec.ambience[1], spec.ambience[2], spec.ambience[3])
	local glowColor = Color3.fromRGB(spec.glow[1], spec.glow[2], spec.glow[3])

	-- A LUZ QUE LAVAVA A ILHA.
	--
	-- Antes isto era uma PointLight com Range 220-270 e Brightness 1.2-1.9,
	-- pendurada 46 studs acima do chão. Range de 250 cobre a ilha inteira a
	-- partir de um ponto só: a face virada para ela recebe a luz de frente e
	-- satura em branco. Era EXATAMENTE o "tudo branco" que aparece na tela
	-- do jogador — e no meu render não aparecia porque o preview limitava o
	-- ganho em 1.0, então ele mentia dizendo que estava tudo bem.
	--
	-- Duas correções:
	--   1. Range curto e altura menor: a luz ilumina o chão ao redor em vez
	--      de atravessar a ilha.
	--   2. Brilho baixo. O papel desta luz é dar TOM (a floresta mais verde,
	--      o deserto mais quente), não clarear. Tom se dá com cor e pouca
	--      intensidade; intensidade alta vira branco e apaga o matiz.
	local sun = Instance.new("PointLight")
	sun.Name = "BiomeLight"
	sun.Brightness = math.min(spec.intensity, 0.55)
	-- 0.42 do raio: chega na metade da ilha, não na borda de fora. Ilha de
	-- raio 105 fica com alcance ~44 — luz de ambiente, não holofote.
	sun.Range = math.max(34, biome.radius * 0.42)
	sun.Color = ambientColor
	sun.Shadows = false
	sun.Parent = part({
		Name = "LightAnchor",
		Size = Vector3.new(2, 2, 2),
		Position = center + Vector3.new(0, groundY + 22, 0),
		Color = glowColor,
		Material = Enum.Material.Neon,
		Transparency = 1,
		CanCollide = false,
	}, home)

	-- postes: um anel de luzes na borda da ilha, virados para o centro
	local postCount = biome.id == "cosmos" and 6 or 8
	for i = 1, postCount do
		local angle = (i / postCount) * math.pi * 2
		local radius = biome.radius * 0.62
		local lx, lz = math.cos(angle) * radius, math.sin(angle) * radius
		local gy = Terrain.heightAtCell(biome, cells, lx, lz)
		local base = Vector3.new(center.X + lx, center.Y + gy, center.Z + lz)

		part({
			Name = "Post",
			Size = Vector3.new(1.6, 14, 1.6),
			Position = base + Vector3.new(0, 7, 0),
			Color = PALETTE.stoneDark,
			Material = Style.flat,
		}, home)

		local bulb = ball({
			Name = "PostBulb",
			Size = Vector3.new(4.6, 4.6, 4.6),
			Position = base + Vector3.new(0, 15, 0),
			Color = glowColor,
			Material = Enum.Material.Neon,
			Transparency = 0.1,
		}, home)

		local bulbLight = Instance.new("PointLight")
		bulbLight.Brightness = 0.9
		bulbLight.Range = 46
		bulbLight.Color = glowColor
		bulbLight.Parent = bulb
	end

	-- pedestal do ovo no miolo plano, na altura real do chão
	local egg = GameConfig.EggById[biome.eggId]
	local eggSpot = Vector3.new(center.X, center.Y + groundY, center.Z)
	if egg then
		buildEggPedestal(egg, eggSpot, home)
	end

	-- ICONE GIGANTE DO BIOMA
	-- Peça central que a criança identifica de longe: cada ilha tem um objeto
	-- grande, na altura, virado para o hub. Serve de ponto de referência ao
	-- viajar e dá personalidade — antes todas as ilhas eram "grama + árvore".
	local iconBase = Vector3.new(
		center.X,
		center.Y + Terrain.heightAtCell(biome, cells, biome.radius * 0.34, 0),
		center.Z + biome.radius * 0.02
	)
	local iconModel = Instance.new("Model")
	iconModel.Name = "Landmark"
	iconModel.Parent = home
	World.buildLandmark(biome, iconModel, iconBase)

	-- portal de volta para o hub
	local spawn = Biomes.spawnPoint(biome)
	local portal = buildPortal(portalPosition, {
		accent = colors.accent,
	}, nil, home, "Portal_Return")

	-- placa do bioma
	makeSign(Vector3.new(center.X, center.Y + groundY + 34, center.Z), biome.name, Color3.fromRGB(255, 255, 255), home)

	-- area de chegada: plataforma discreta onde o jogador aparece
	part({
		Name = "ArrivalPad",
		Size = Vector3.new(30, 1, 30),
		Position = Vector3.new(spawn.X, center.Y + groundY + 0.6, spawn.Z),
		Color = Color3.fromRGB(colors.accent[1], colors.accent[2], colors.accent[3]),
		Material = Enum.Material.Neon,
		Transparency = 0.55,
		CanCollide = false,
	}, home)

	return {
		biome = biome,
		model = home,
		center = center,
		eggSpot = eggSpot,
		spawn = spawn,
		portal = portal,
	}
end

-- Portais do hub: um por bioma, no anel externo da praça, alinhados com a
-- direção real da ilha. Assim o jogador vê para onde o portal leva.
local biomeRefs = {}

function World.buildBiomes()
	biomeRoot = Instance.new("Folder")
	biomeRoot.Name = "Biomes"
	biomeRoot.Parent = root

	-- Céu do arquipélago: nuvens altas entre as ilhas. Dão a sensação de
	-- distância (sem elas o vazio parece fim do mapa) e são o tipo de enfeite
	-- que criança nota na hora.
	local skyFolder = Instance.new("Folder")
	skyFolder.Name = "Sky"
	skyFolder.Parent = root

	cloudRing(root, Vector3.new(0, 0, 0), 620, 230, 11, 2.6)
	cloudRing(root, Vector3.new(0, 0, 0), 980, 300, 13, 3.4)
	cloudRing(root, Vector3.new(0, 0, 0), 1450, 380, 15, 4.4)
	cloudRing(skyFolder, Vector3.new(0, Biomes.SkyHeight, 0), 190, 70, 7, 1.6, Color3.fromRGB(226, 214, 255))

	-- Ilhas flutuantes de enfeite no caminho entre o hub e os biomas. Não
	-- colidem e não têm função: existem para o percurso parecer um mundo.
	-- Ilhas flutuantes de enfeite no caminho entre o hub e os biomas.
	--
	-- Antes elas tinham a MESMA assinatura visual de uma ilha de verdade:
	-- topo plano de grama sobre um bloco de pedra. Algumas nasciam altas
	-- (height ate +80) e de longe pareciam pedaços arrancados do mapa
	-- boiando no céu — foi a origem dos "quadrados verdes" no render.
	-- Agora são rochas flutuantes de verdade: pedra pura, sem grama, em
	-- altura baixa. Ninguém confunde com uma ilha jogável.
	local rngIslets = Random.new(4711)
	for i = 1, 14 do
		local angle = (i / 14) * math.pi * 2 + 0.3
		local distance = 320 + rngIslets:NextNumber() * 460
		-- altura baixa: entre a linha d'água e pouco acima dela
		local height = -18 + rngIslets:NextNumber() * 34
		local size = 14 + rngIslets:NextNumber() * 22
		local x = math.cos(angle) * distance
		local z = math.sin(angle) * distance
		local rock = ball({
			Name = "SkyRock",
			Size = Vector3.new(size * 1.7, size * 0.9, size * 1.5),
			Position = Vector3.new(x, height, z),
			Color = PALETTE.rockDark,
			Material = Style.flat,
		}, skyFolder)
		rock.CanCollide = false
		rock.CanQuery = false
		-- uma pedra menor de apoio, para a silhueta não ser uma bola só
		ball({
			Name = "SkyRock",
			Size = Vector3.new(size * 0.9, size * 0.6, size * 0.8),
			Position = Vector3.new(x + size * 0.6, height - size * 0.4, z - size * 0.3),
			Color = PALETTE.rock,
			Material = Style.flat,
			CanCollide = false,
		}, skyFolder)
	end

	for _, biome in ipairs(Biomes.List) do
		local center = Biomes.centerVector(biome)

		-- direção no plano entre o hub e a ilha
		local flat = Vector3.new(center.X, 0, center.Z)
		if flat.Magnitude < 1 then
			flat = Vector3.new(0, 0, -1) -- cosmos fica no alto (centro do hub)
		end

		-- portal do hub
		local portalPosition = Vector3.new(0, 0, 0)
		if flat.Magnitude > 1 then
			portalPosition = flat.Unit * 138
		end
		buildPortal(portalPosition, { accent = biome.colors.accent }, biome, root, "PortalTo_" .. biome.id)

		-- Portal de volta: na encosta, virado para o hub. A altura vem do
		-- próprio relevo — o portal fica em cima do chão, não afundado na base.
		local direction = flat.Magnitude < 1 and Vector3.new(0, 0, 1) or flat.Unit
		local portalRadius = biome.radius * 0.66
		local portalX = center.X + direction.X * portalRadius
		local portalZ = center.Z + direction.Z * portalRadius
		local cells = Terrain.generate(biome)
		local localX = portalX - center.X
		local localZ = portalZ - center.Z
		local backPosition =
			Vector3.new(portalX, center.Y + Terrain.heightAtCell(biome, cells, localX, localZ), portalZ)

		biomeRefs[biome.id] = World.buildBiome(biome, backPosition, biomeRoot)
	end
end

function World.getBiomeRefs()
	return biomeRefs
end

function World.biomeArrival(biomeId)
	local ref = biomeRefs[biomeId]
	if not ref then
		return nil
	end
	return CFrame.new(ref.spawn)
		* CFrame.Angles(0, math.atan2(ref.center.X - ref.spawn.X, ref.center.Z - ref.spawn.Z), 0)
end

function World.centerOf(biomeId)
	local ref = biomeRefs[biomeId]
	return ref and ref.center or nil
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="21">
    <Properties>
      <string name="Name">SoundService</string>
      <token name="AmbientReverb">20</token>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="22">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">220</float>
      <float name="CameraMinZoomDistance">16</float>
      <float name="CharacterJumpPower">60</float>
      <float name="CharacterWalkSpeed">22</float>
      <bool name="EnableMouseLockOption">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="23">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="24">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[-- init.client
-- Monta a UI inteira e liga a rede. Nenhuma regra de jogo aqui.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Format = require(Shared.Format)

local Theme = require(script.Theme)
local State = require(script.State)
local NetClient = require(script.NetClient)
local Hud = require(script.Hud)
local TapButton = require(script.TapButton)
local EggPanel = require(script.EggPanel)
local PetsPanel = require(script.PetsPanel)
local ShopPanel = require(script.ShopPanel)
local Toasts = require(script.Toasts)
local WorldUI = require(script.WorldUI)
local BiomesPanel = require(script.BiomesPanel)
local MinePanel = require(script.MinePanel)

---------------------------------------------------------------------------
-- GUI RAIZ
---------------------------------------------------------------------------

local gui = Instance.new("ScreenGui")
gui.Name = "EggTycoonGui"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Global
gui.DisplayOrder = 20
gui.Parent = playerGui

Toasts.init(gui)

---------------------------------------------------------------------------
-- PAINEIS
---------------------------------------------------------------------------

EggPanel.build(gui)
PetsPanel.build(gui)
ShopPanel.build(gui)
BiomesPanel.build(gui)
MinePanel.build(gui)

local function closeAll()
	EggPanel.hide()
	PetsPanel.hide()
	ShopPanel.hide()
	BiomesPanel.hide()
	MinePanel.hide()
end

local function openEggs(eggId)
	PetsPanel.hide()
	ShopPanel.hide()
	if eggId then
		EggPanel.select(eggId)
	end
	EggPanel.show()
end

Hud.build(gui, {
	shop = function()
		closeAll()
		ShopPanel.show("coins")
	end,
	trade = function()
		closeAll()
		PetsPanel.show()
	end,
	settings = function()
		Toasts.push("⚙️ em breve", "info")
	end,
	ranks = function()
		local snapshot = State.snapshot
		if snapshot then
			Toasts.push(string.format("🏆 Rebirths: %d · Pets: %d", snapshot.rebirths, #snapshot.pets), "info")
		end
	end,
})

TapButton.build(gui, function()
	NetClient.action(Net.ActionKind.Tap, 1)
	local snapshot = State.snapshot
	TapButton.showReward(snapshot and snapshot.tapPower or 1)
end)

---------------------------------------------------------------------------
-- BOTÕES EXTRAS (OVOS / PETS / REBIRTH) no canto superior esquerdo
---------------------------------------------------------------------------

local topLeft = Instance.new("Frame")
topLeft.BackgroundTransparency = 1
topLeft.Size = UDim2.fromOffset(430, 62)
topLeft.Position = UDim2.fromOffset(18, 16)
topLeft.Parent = gui
Theme.list(topLeft, {
	direction = Enum.FillDirection.Horizontal,
	padding = 10,
	hAlign = Enum.HorizontalAlignment.Left,
})

local function toolbarButton(text, icon, color, order, onClick)
	local btn = Theme.button(topLeft, {
		text = icon .. "  " .. text,
		size = UDim2.fromOffset(136, 56),
		color = color,
		textSize = 19,
		layoutOrder = order,
		radius = 28,
	})
	btn.MouseButton1Click:Connect(onClick)
	return btn
end

toolbarButton("Ovos", "🥚", Color3.fromRGB(255, 196, 90), 1, function()
	openEggs()
end)

toolbarButton("Pets", "🐾", Color3.fromRGB(160, 210, 255), 2, function()
	closeAll()
	PetsPanel.show()
end)

toolbarButton("Rebirth", "♻️", Color3.fromRGB(150, 235, 190), 3, function()
	local snapshot = State.snapshot
	if not snapshot then
		return
	end
	if snapshot.coins >= snapshot.rebirthCost then
		NetClient.action(Net.ActionKind.Rebirth)
	else
		Toasts.push("Ainda não dá pra renascer 💪", "error")
	end
end)

---------------------------------------------------------------------------
-- MUNDO
---------------------------------------------------------------------------

WorldUI.build({
	selectEgg = function(eggId)
		-- o servidor precisa saber qual ovo foi escolhido, senão o hatch
		-- sempre usa o selectedEgg antigo
		NetClient.action(Net.ActionKind.SelectEgg, eggId)
		openEggs(eggId)
	end,
	zone = function(zone)
		if zone == Net.Zones.Shop then
			closeAll()
			ShopPanel.show("coins")
		elseif zone == Net.Zones.GemShop then
			closeAll()
			ShopPanel.show("gems")
		elseif zone == Net.Zones.Golden then
			NetClient.action(Net.ActionKind.Golden)
		elseif zone == Net.Zones.Fusion then
			closeAll()
			PetsPanel.show()
		elseif zone == Net.Zones.Rebirth then
			local snapshot = State.snapshot
			if snapshot then
				local cost = snapshot.rebirthCost
				if snapshot.coins >= cost then
					NetClient.action(Net.ActionKind.Rebirth)
				else
					Toasts.push("Faltam " .. Format.number(cost - snapshot.coins) .. " moedas", "error")
				end
			end
		elseif zone == Net.Zones.Mine then
			closeAll()
			MinePanel.show()
		elseif zone == Net.Zones.Trade then
			closeAll()
			PetsPanel.show()
		elseif zone == "egg_halloween" then
			openEggs()
		end
	end,
	-- Portal: o servidor valida o desbloqueio e devolve erro se faltar.
	travel = function(biomeId)
		NetClient.action(Net.ActionKind.Travel, biomeId)
	end,
})

---------------------------------------------------------------------------
-- REDE
---------------------------------------------------------------------------

NetClient.state.OnClientEvent:Connect(function(snapshot)
	State.set(snapshot)
	WorldUI.syncPets(snapshot)
	if EggPanel and EggPanel.refresh then
		EggPanel.refresh()
	end
	if BiomesPanel and BiomesPanel.refresh then
		BiomesPanel.refresh()
	end
end)

NetClient.on(function(kind, payload)
	if kind == Net.EventKind.Toast then
		Toasts.push(payload.text, payload.kind)
	elseif kind == Net.EventKind.Hatch then
		EggPanel.onHatch(payload)
	elseif kind == Net.EventKind.Rebirth then
		Toasts.push(string.format("♻️ Rebirth %d! +%d 💎", payload.rebirths, payload.crystals), "success")
	elseif kind == Net.EventKind.Mine then
		-- O que o pet trouxe. Sem este aviso, o jogador recolhe e não vê
		-- nada: o dinheiro some no HUD e o momento passa batido.
		local names = {}
		for _, ore in ipairs(payload.ores or {}) do
			names[#names + 1] = ore.name
		end
		Toasts.push(
			string.format("⛏️ %s · +%s moedas", table.concat(names, ", "), Format.number(payload.coins)),
			"success"
		)
		MinePanel.update()
	elseif kind == Net.EventKind.Zone then
		-- servidor abrindo UI remotamente
	end
end)

---------------------------------------------------------------------------
-- LOOP
---------------------------------------------------------------------------

local last = os.clock()
local mineClock = 0

RunService.RenderStepped:Connect(function()
	local now = os.clock()
	local dt = math.min(now - last, 0.2)
	last = now
	WorldUI.stepPets(dt)

	-- O snapshot vem do servidor a cada tick, então a barrinha ficaria
	-- congelada entre envios. Aqui ela avança de forma otimista com o
	-- tempo local: o servidor manda o valor real e corrige. Sem isto a
	-- mina parece travada, que é pior do que um número levemente errado.
	mineClock = mineClock + dt
	if mineClock >= 0.1 and MinePanel.isOpen and MinePanel.isOpen() then
		mineClock = 0
		MinePanel.tick(dt)
	end
end)

---------------------------------------------------------------------------
-- ATAJOS
---------------------------------------------------------------------------

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	local key = input.KeyCode

	if key == Enum.KeyCode.M then
		BiomesPanel.toggle()
	elseif key == Enum.KeyCode.E then
		openEggs()
	elseif key == Enum.KeyCode.P then
		closeAll()
		PetsPanel.show()
	elseif key == Enum.KeyCode.B then
		closeAll()
		ShopPanel.show("coins")
	elseif key == Enum.KeyCode.G then
		closeAll()
		ShopPanel.show("gems")
	elseif key == Enum.KeyCode.Escape then
		closeAll()
	end
end)

task.delay(1.5, function()
	Toasts.push("👆 Toque pra ganhar  ·  🥚 abra ovos  ·  🐾 equipe pets", "info")
end)

print("[EggTycoon] Cliente pronto ·", player.Name)
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">BiomesPanel</string>
            <string name="Source"><![CDATA[-- BiomesPanel
-- Mapa-múndi do jogo: um cartão por bioma, com o ovo daquele mundo, o preço
-- do ovo e o requisito de desbloqueio. Tecla M abre; clicar viaja.
--
-- O painel NUNCA decide se pode viajar: mostra o cadeado a partir do snapshot
-- (biomes = mapa de desbloqueio vindo do servidor) e manda o pedido. Quem
-- barra é o servidor, em Game.handlers.travel.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Format = require(Shared.Format)
local Net = require(Shared.Net)
local Biomes = require(Shared.Biomes)

local Theme = require(script.Parent.Theme)
local State = require(script.Parent.State)
local NetClient = require(script.Parent.NetClient)

local BiomesPanel = {}

local refs = { cards = {}, root = nil }
local gui

local CARD_W = 176
local CARD_H = 232
local PER_ROW = 4
local GAP = 12

local function makeCard(parent, biome, index)
	local card = Instance.new("TextButton")
	card.Name = "Biome_" .. biome.id
	card.Size = UDim2.fromOffset(CARD_W, CARD_H)
	card.Position = UDim2.fromOffset((index % PER_ROW) * (CARD_W + GAP), math.floor(index / PER_ROW) * (CARD_H + GAP))
	card.BackgroundColor3 = Color3.fromRGB(biome.colors.grass[1], biome.colors.grass[2], biome.colors.grass[3])
	card.BorderSizePixel = 0
	card.AutoButtonColor = true
	card.Text = ""
	card.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 16)
	corner.Parent = card

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(biome.colors.grassDark[1], biome.colors.grassDark[2], biome.colors.grassDark[3])
	stroke.Thickness = 3
	stroke.Parent = card

	local emoji = Instance.new("TextLabel")
	emoji.Size = UDim2.fromScale(1, 0.34)
	emoji.Position = UDim2.fromScale(0, 0.06)
	emoji.BackgroundTransparency = 1
	emoji.Text = biome.emoji
	emoji.TextScaled = true
	emoji.Font = Theme.font
	emoji.Parent = card

	local name = Instance.new("TextLabel")
	name.Size = UDim2.fromScale(0.94, 0.16)
	name.Position = UDim2.fromScale(0.03, 0.375)
	name.BackgroundTransparency = 1
	name.Text = biome.name
	name.TextScaled = true
	name.Font = Theme.font
	name.TextColor3 = Theme.white
	name.TextStrokeTransparency = 0
	name.TextStrokeColor3 = Theme.outline
	name.Parent = card

	-- faixa de descricao: diz em uma linha o que tem na ilha. É o que faz a
	-- criança escolher para onde ir em vez de clicar no primeiro.
	local blurb = Instance.new("TextLabel")
	blurb.Name = "Blurb"
	blurb.Size = UDim2.fromScale(0.94, 0.12)
	blurb.Position = UDim2.fromScale(0.03, 0.51)
	blurb.BackgroundTransparency = 1
	blurb.Text = biome.blurb
	blurb.TextScaled = true
	blurb.Font = Theme.font
	blurb.TextColor3 = Theme.white
	blurb.TextStrokeTransparency = 0.55
	blurb.TextStrokeColor3 = Theme.outline
	blurb.TextWrapped = true
	blurb.Parent = card

	local egg = GameConfig.EggById[biome.eggId]
	local detail = Instance.new("TextLabel")
	detail.Name = "Detail"
	detail.Size = UDim2.fromScale(0.94, 0.14)
	detail.Position = UDim2.fromScale(0.03, 0.655)
	detail.BackgroundTransparency = 1
	detail.Text = egg and (egg.emoji .. " " .. Format.number(egg.cost)) or "—"
	detail.TextScaled = true
	detail.Font = Theme.font
	detail.TextColor3 = Theme.yellow
	detail.TextStrokeTransparency = 0
	detail.TextStrokeColor3 = Theme.outline
	detail.Parent = card

	-- cadeado / status
	local lock = Instance.new("TextLabel")
	lock.Name = "Lock"
	lock.Size = UDim2.fromScale(0.94, 0.16)
	lock.Position = UDim2.fromScale(0.03, 0.825)
	lock.BackgroundTransparency = 1
	lock.Text = ""
	lock.TextScaled = true
	lock.Font = Theme.font
	lock.TextColor3 = Theme.white
	lock.TextStrokeTransparency = 0
	lock.TextStrokeColor3 = Theme.outline
	lock.Parent = card

	-- selo de "você está aqui"
	local here = Instance.new("TextLabel")
	here.Name = "Here"
	here.Size = UDim2.fromOffset(64, 22)
	here.Position = UDim2.fromOffset(CARD_W - 70, 8)
	here.BackgroundColor3 = Theme.green
	here.BorderSizePixel = 0
	here.Text = "AQUI"
	here.TextScaled = true
	here.Font = Theme.font
	here.TextColor3 = Theme.white
	here.Visible = false
	here.Parent = card

	local hereCorner = Instance.new("UICorner")
	hereCorner.CornerRadius = UDim.new(0, 8)
	hereCorner.Parent = here

	card.MouseButton1Click:Connect(function()
		local snapshot = State.snapshot
		local unlocked = snapshot and snapshot.biomes and snapshot.biomes[biome.id]
		if not unlocked then
			local label = Biomes.unlockLabel(biome)
			require(script.Parent.Toasts).push("🔒 " .. biome.name .. " — " .. label, "error")
			return
		end
		NetClient.action(Net.ActionKind.Travel, biome.id)
		BiomesPanel.hide()
	end)

	refs.cards[biome.id] = { card = card, lock = lock, here = here, detail = detail }
	return card
end

function BiomesPanel.build(parent)
	gui = parent

	local overlay = Instance.new("TextButton")
	overlay.Name = "BiomesPanel"
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.BackgroundColor3 = Color3.fromRGB(20, 12, 8)
	overlay.BackgroundTransparency = 0.45
	overlay.BorderSizePixel = 0
	overlay.Text = ""
	overlay.Visible = false
	overlay.ZIndex = 40
	overlay.Parent = parent
	refs.root = overlay

	local frame = Instance.new("Frame")
	frame.Name = "Card"
	frame.Size = UDim2.fromOffset(PER_ROW * CARD_W + (PER_ROW - 1) * GAP + 48, 470)
	frame.Position = UDim2.fromScale(0.5, 0.5)
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.BackgroundColor3 = Theme.panel
	frame.BorderSizePixel = 0
	frame.ZIndex = 41
	frame.Parent = overlay

	local frameCorner = Instance.new("UICorner")
	frameCorner.CornerRadius = UDim.new(0, 20)
	frameCorner.Parent = frame

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, -32, 0, 44)
	title.Position = UDim2.fromOffset(16, 12)
	title.BackgroundTransparency = 1
	title.Text = "🗺️ MUNDOS"
	title.TextScaled = true
	title.Font = Theme.font
	title.TextColor3 = Theme.textDark
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.ZIndex = 42
	title.Parent = frame

	local closeButton = Instance.new("TextButton")
	closeButton.Size = UDim2.fromOffset(40, 40)
	closeButton.Position = UDim2.new(1, -52, 0, 12)
	closeButton.BackgroundColor3 = Theme.red
	closeButton.BorderSizePixel = 0
	closeButton.Text = "✕"
	closeButton.TextScaled = true
	closeButton.Font = Theme.font
	closeButton.TextColor3 = Theme.white
	closeButton.ZIndex = 42
	closeButton.Parent = frame
	closeButton.MouseButton1Click:Connect(function()
		BiomesPanel.hide()
	end)

	local closeCorner = Instance.new("UICorner")
	closeCorner.CornerRadius = UDim.new(0, 12)
	closeCorner.Parent = closeButton

	local grid = Instance.new("Frame")
	grid.Name = "Grid"
	grid.Size = UDim2.new(1, -32, 1, -78)
	grid.Position = UDim2.fromOffset(16, 64)
	grid.BackgroundTransparency = 1
	grid.ZIndex = 42
	grid.Parent = frame

	for index, biome in ipairs(Biomes.List) do
		makeCard(grid, biome, index - 1)
	end

	BiomesPanel.refresh()
end

function BiomesPanel.refresh()
	local snapshot = State.snapshot
	for _, biome in ipairs(Biomes.List) do
		local entry = refs.cards[biome.id]
		if entry then
			local unlocked = snapshot and snapshot.biomes and snapshot.biomes[biome.id]
			local current = snapshot and snapshot.biome == biome.id
			entry.lock.Text = unlocked and "✅ aberto" or ("🔒 " .. Biomes.unlockLabel(biome))
			entry.lock.TextColor3 = unlocked and Theme.white or Color3.fromRGB(255, 220, 220)
			entry.here.Visible = current == true
			entry.card.BackgroundTransparency = unlocked and 0 or 0.35
		end
	end
end

function BiomesPanel.show()
	refs.root.Visible = true
	BiomesPanel.refresh()
end

function BiomesPanel.hide()
	refs.root.Visible = false
end

function BiomesPanel.toggle()
	if refs.root.Visible then
		BiomesPanel.hide()
	else
		BiomesPanel.show()
	end
end

return BiomesPanel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">EggPanel</string>
            <string name="Source"><![CDATA[-- EggPanel
-- Painel de ovos: lista de ovos, botão ABRIR, e a animação de chocar
-- (ovo balançando -> estilhaços -> pet aparecendo), igual aos prints.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Format = require(Shared.Format)
local Net = require(Shared.Net)

local Theme = require(script.Parent.Theme)
local State = require(script.Parent.State)
local NetClient = require(script.Parent.NetClient)

local EggPanel = {}

local refs = {}
local gui
local selected = "starter"
local hatching = false

---------------------------------------------------------------------------
-- CARD DE OVO
---------------------------------------------------------------------------

local function eggCard(parent, egg, order)
	local card = Instance.new("TextButton")
	card.Name = "EggCard_" .. egg.id
	card.Size = UDim2.fromOffset(268, 96)
	card.BackgroundColor3 = Theme.white
	card.BorderSizePixel = 0
	card.AutoButtonColor = false
	card.Text = ""
	card.LayoutOrder = order
	card.Parent = parent
	Theme.corner(card, 20)
	local stroke = Theme.stroke(card, Color3.fromRGB(225, 210, 190), 3)

	local iconFrame = Instance.new("Frame")
	iconFrame.Size = UDim2.fromOffset(64, 64)
	iconFrame.Position = UDim2.fromOffset(12, 16)
	iconFrame.BackgroundColor3 = egg.color
	iconFrame.BorderSizePixel = 0
	iconFrame.ZIndex = 2
	iconFrame.Parent = card
	Theme.corner(iconFrame, 32)
	Theme.stroke(iconFrame, Theme.outline, 3)

	Theme.label(iconFrame, {
		text = egg.emoji,
		size = UDim2.fromScale(1, 1),
		textSize = 34,
		strokeTransparency = 1,
		zIndex = 3,
	})

	Theme.label(card, {
		text = egg.name,
		size = UDim2.new(1, -96, 0, 26),
		position = UDim2.fromOffset(86, 12),
		xAlign = Enum.TextXAlignment.Left,
		textSize = 20,
		color = Theme.textDark,
		strokeTransparency = 1,
		zIndex = 3,
	})

	local cost = Theme.label(card, {
		text = "🪙 " .. Format.number(egg.cost),
		size = UDim2.new(1, -96, 0, 22),
		position = UDim2.fromOffset(86, 36),
		xAlign = Enum.TextXAlignment.Left,
		textSize = 18,
		color = Color3.fromRGB(230, 160, 30),
		strokeTransparency = 1,
		zIndex = 3,
	})

	local statusLabel = Theme.label(card, {
		text = "",
		size = UDim2.new(1, -96, 0, 18),
		position = UDim2.fromOffset(86, 60),
		xAlign = Enum.TextXAlignment.Left,
		textSize = 14,
		color = Color3.fromRGB(150, 150, 160),
		strokeTransparency = 1,
		zIndex = 3,
	})

	card.MouseButton1Click:Connect(function()
		EggPanel.select(egg.id)
	end)

	return {
		card = card,
		stroke = stroke,
		cost = cost,
		status = statusLabel,
		egg = egg,
	}
end

---------------------------------------------------------------------------
-- ANIMAÇÃO DE CHOCAR
---------------------------------------------------------------------------

local function playHatchAnimation(petId, rarityId)
	local overlay = Instance.new("Frame")
	overlay.Name = "HatchOverlay"
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	overlay.BackgroundTransparency = 0.55
	overlay.BorderSizePixel = 0
	overlay.ZIndex = 40
	overlay.Parent = gui

	local rarity = GameConfig.rarity(rarityId)
	local pet = GameConfig.pet(petId)

	local eggFrame = Instance.new("Frame")
	eggFrame.Size = UDim2.fromOffset(180, 220)
	eggFrame.Position = UDim2.fromScale(0.5, 0.5)
	eggFrame.AnchorPoint = Vector2.new(0.5, 0.5)
	eggFrame.BackgroundColor3 = Color3.fromRGB(255, 245, 220)
	eggFrame.BorderSizePixel = 0
	eggFrame.ZIndex = 41
	eggFrame.Parent = overlay
	Theme.corner(eggFrame, 90)
	Theme.stroke(eggFrame, Theme.outline, 5)

	local eggEmoji = Theme.label(eggFrame, {
		text = "🥚",
		size = UDim2.fromScale(1, 1),
		textSize = 110,
		strokeTransparency = 1,
		zIndex = 42,
	})

	local scale = Instance.new("UIScale")
	scale.Parent = eggFrame

	-- balançar
	local wobble = 0
	local wobbleConnection
	wobbleConnection = game:GetService("RunService").RenderStepped:Connect(function(dt)
		wobble += dt * 18
		eggFrame.Rotation = math.sin(wobble) * 12
	end)

	task.delay(1.1, function()
		if wobbleConnection then
			wobbleConnection:Disconnect()
		end
		eggFrame.Rotation = 0
		eggEmoji.Text = "💥"

		TweenService:Create(scale, TweenInfo.new(0.25), { Scale = 1.6 }):Play()
		task.wait(0.12)
		eggEmoji.Text = pet.emoji
		eggFrame.BackgroundColor3 = rarity.color
		TweenService:Create(scale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Scale = 1,
		}):Play()

		-- flash dourado se lendário+
		if GameConfig.rarity(rarityId).order >= 5 then
			local flash = Instance.new("Frame")
			flash.Size = UDim2.fromScale(1, 1)
			flash.BackgroundColor3 = rarity.color
			flash.BackgroundTransparency = 0.5
			flash.BorderSizePixel = 0
			flash.ZIndex = 43
			flash.Parent = overlay
			TweenService:Create(flash, TweenInfo.new(0.7), { BackgroundTransparency = 1 }):Play()
			task.delay(0.8, function()
				flash:Destroy()
			end)
		end
	end)

	task.delay(1.7, function()
		local name = Theme.label(overlay, {
			text = pet.name,
			size = UDim2.fromOffset(600, 70),
			position = UDim2.fromScale(0.5, 0.28),
			anchor = Vector2.new(0.5, 0.5),
			textSize = 52,
			color = rarity.color,
			strokeTransparency = 0,
			strokeColor = Theme.outline,
			zIndex = 44,
		})
		local rarityLabel = Theme.label(overlay, {
			text = rarity.name:upper() .. "!",
			size = UDim2.fromOffset(600, 40),
			position = UDim2.fromScale(0.5, 0.34),
			anchor = Vector2.new(0.5, 0.5),
			textSize = 26,
			color = Color3.fromRGB(255, 255, 255),
			strokeTransparency = 0.2,
			zIndex = 44,
		})
		TweenService:Create(name, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Position = UDim2.fromScale(0.5, 0.24),
		}):Play()
		rarityLabel.TextTransparency = 0

		task.delay(1.6, function()
			TweenService:Create(overlay, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
			TweenService:Create(name, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
			TweenService:Create(rarityLabel, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
			TweenService:Create(eggFrame, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
			TweenService:Create(eggEmoji, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
			task.wait(0.35)
			overlay:Destroy()
			EggPanel.setHatching(false)
		end)
	end)
end

---------------------------------------------------------------------------
-- PAINEL
---------------------------------------------------------------------------

function EggPanel.build(parentGui)
	gui = parentGui

	local root = Theme.panel(gui, {
		name = "EggPanel",
		size = UDim2.fromOffset(600, 560),
		position = UDim2.new(0.5, 0, 0.5, 0),
		color = Theme.white,
		radius = 30,
		zIndex = 25,
	})
	root.Visible = false
	refs.root = root

	-- cabeçalho com título estilo "Ovos"

	local title = Theme.titleTag(root, "OVOS", { width = 190, offset = -26, zIndex = 25, textSize = 26 })

	local close = Theme.button(root, {
		text = "✕",
		size = UDim2.fromOffset(52, 52),
		position = UDim2.new(1, -18, 0, 14),
		anchor = Vector2.new(1, 0),
		color = Theme.red,
		textSize = 26,
		radius = 26,
		shadow = false,
		zIndex = 30,
	})
	close.MouseButton1Click:Connect(function()
		EggPanel.hide()
	end)

	-- lista com scroll
	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = UDim2.new(1, -40, 1, -216)
	scroll.Position = UDim2.fromOffset(20, 88)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 5
	scroll.ScrollBarImageColor3 = Color3.fromRGB(220, 180, 130)
	scroll.CanvasSize = UDim2.fromOffset(0, 0)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.ZIndex = 26
	scroll.Parent = root
	Theme.list(scroll, { padding = 8 })

	refs.cards = {}
	for index, egg in ipairs(GameConfig.Eggs) do
		refs.cards[egg.id] = eggCard(scroll, egg, index)
	end

	-- rodapé: botão gigante ABRIR
	local footer = Instance.new("Frame")
	footer.Size = UDim2.new(1, -40, 0, 104)
	footer.Position = UDim2.new(0, 20, 1, -114)
	footer.BackgroundTransparency = 1
	footer.ZIndex = 26
	footer.Parent = root

	local openButton = Theme.button(footer, {
		text = "ABRIR OVO",
		size = UDim2.new(1, 0, 0, 82),
		position = UDim2.new(0, 0, 0, 10),
		color = Theme.green,
		textSize = 34,
		radius = 41,
		zIndex = 27,
	})
	Theme.gradient(openButton, Color3.fromRGB(190, 245, 140), Color3.fromRGB(90, 190, 80))
	refs.openButton = openButton

	openButton.MouseButton1Click:Connect(function()
		if hatching then
			return
		end
		local egg = GameConfig.egg(selected)
		local snapshot = State.snapshot
		if not egg or not snapshot then
			return
		end
		local bought = snapshot.eggBought and snapshot.eggBought[egg.id] or 0
		if snapshot.coins < GameConfig.eggPrice(egg.id, bought) then
			EggPanel.flashError()
			return
		end
		EggPanel.setHatching(true)
		NetClient.action(Net.ActionKind.Hatch)
		-- se o servidor não responder (sem moedas etc.), destrava em 2s
		task.delay(2, function()
			if hatching then
				EggPanel.setHatching(false)
			end
		end)
	end)

	Theme.makeDraggable(root, header)

	return root
end

function EggPanel.select(eggId)
	selected = eggId
	EggPanel.refresh()
end

function EggPanel.refresh()
	if not State.snapshot then
		return
	end
	local snapshot = State.snapshot
	for eggId, cardRef in pairs(refs.cards) do
		local egg = cardRef.egg
		local isSelected = eggId == selected
		cardRef.stroke.Color = isSelected and Color3.fromRGB(120, 205, 110) or Color3.fromRGB(225, 210, 190)
		cardRef.stroke.Thickness = isSelected and 5 or 3

		local bought = snapshot.eggBought and snapshot.eggBought[eggId] or 0
		local price = GameConfig.eggPrice(eggId, bought)
		cardRef.cost.Text = "🪙 " .. Format.number(price)
		if snapshot.coins >= price then
			cardRef.status.Text = "disponível"
			cardRef.status.TextColor3 = Color3.fromRGB(110, 180, 90)
		else
			cardRef.status.Text = "faltam " .. Format.number(price - snapshot.coins)
			cardRef.status.TextColor3 = Color3.fromRGB(200, 130, 130)
		end
	end

	local egg = GameConfig.egg(selected)
	if refs.openButton and egg then
		local bought = snapshot.eggBought and snapshot.eggBought[egg.id] or 0
		refs.openButton.Text = "ABRIR "
			.. egg.name:upper()
			.. "  ·  🪙 "
			.. Format.number(GameConfig.eggPrice(egg.id, bought))
	end
end

function EggPanel.flashError()
	if not refs.root then
		return
	end
	local original = refs.root.BackgroundColor3
	refs.root.BackgroundColor3 = Color3.fromRGB(255, 190, 190)
	task.delay(0.15, function()
		if refs.root then
			refs.root.BackgroundColor3 = original
		end
	end)
end

function EggPanel.setHatching(value)
	hatching = value
	if refs.openButton then
		refs.openButton.Text = value and "CHOCANDO..." or refs.openButton.Text
	end
end

function EggPanel.show()
	refs.root.Visible = true
	EggPanel.refresh()
end

function EggPanel.hide()
	refs.root.Visible = false
end

function EggPanel.toggle()
	if refs.root.Visible then
		EggPanel.hide()
	else
		EggPanel.show()
	end
end

function EggPanel.onHatch(payload)
	EggPanel.setHatching(true)
	local overlay = gui:FindFirstChild("HatchOverlay")
	if overlay then
		overlay:Destroy()
	end
	playHatchAnimation(payload.petId, payload.rarity)
end

return EggPanel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[-- Hud
-- Canto inferior esquerdo: renascimentos, moedas (+renda/s), gemas.
-- Topo: barra "PRÓXIMO!" com o objetivo atual. Botões Loja / Troca na esquerda.
-- Exatamente o layout dos prints.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)
local GameConfig = require(Shared.GameConfig)

local Theme = require(script.Parent.Theme)
local State = require(script.Parent.State)

local Hud = {}

local refs = {}

---------------------------------------------------------------------------
-- LINHA DE STAT (ícone + número + label)
---------------------------------------------------------------------------

local function statRow(parent, config)
	local row = Instance.new("Frame")
	row.BackgroundTransparency = 1
	row.Size = UDim2.fromOffset(230, 52)
	row.Parent = parent

	local shadow = Instance.new("TextLabel")
	shadow.BackgroundTransparency = 1
	shadow.Size = UDim2.fromOffset(52, 52)
	shadow.Font = Enum.Font.FredokaOne
	shadow.TextScaled = true
	shadow.Text = config.icon
	shadow.TextColor3 = Color3.fromRGB(40, 30, 20)
	shadow.TextTransparency = 0.65
	shadow.Position = UDim2.fromOffset(3, 3)
	shadow.ZIndex = 2
	shadow.Parent = row

	local icon = Instance.new("TextLabel")
	icon.BackgroundTransparency = 1
	icon.Size = UDim2.fromOffset(52, 52)
	icon.Font = Enum.Font.FredokaOne
	icon.TextScaled = true
	icon.Text = config.icon
	icon.ZIndex = 3
	icon.Parent = row

	local value = Theme.label(row, {
		text = "0",
		size = UDim2.fromOffset(140, 34),
		position = UDim2.fromOffset(58, 0),
		xAlign = Enum.TextXAlignment.Left,
		textSize = 30,
		strokeTransparency = 0.15,
		strokeColor = Theme.outline,
		zIndex = 3,
	})
	value.Name = config.name .. "_Value"

	local label = Theme.label(row, {
		text = config.label,
		size = UDim2.fromOffset(140, 20),
		position = UDim2.fromOffset(62, 26),
		xAlign = Enum.TextXAlignment.Left,
		textSize = 15,
		color = Color3.fromRGB(255, 255, 255),
		strokeTransparency = 0.2,
		zIndex = 3,
	})

	refs[config.name] = value
	refs[config.name .. "_Label"] = label
	return { row = row, value = value, label = label, icon = icon, shadow = shadow }
end

---------------------------------------------------------------------------
-- BARRA DE MISSÃO (topo)
---------------------------------------------------------------------------

local function questBar(parent)
	local bar = Theme.panel(parent, {
		name = "QuestBar",
		size = UDim2.fromOffset(560, 96),
		position = UDim2.new(0.5, 0, 0, 16),
		anchor = Vector2.new(0.5, 0),
		color = Theme.white,
		radius = 22,
		zIndex = 5,
	})
	Theme.stroke(bar, Color3.fromRGB(150, 195, 235), 4)

	local title = Theme.label(bar, {
		text = "PRÓXIMO!",
		size = UDim2.fromOffset(200, 26),
		position = UDim2.fromOffset(28, 8),
		xAlign = Enum.TextXAlignment.Left,
		textSize = 22,
		color = Color3.fromRGB(240, 170, 40),
		strokeTransparency = 0.3,
		strokeColor = Color3.fromRGB(120, 70, 20),
		zIndex = 6,
	})

	local icon = Theme.label(bar, {
		text = "🥚",
		size = UDim2.fromOffset(66, 66),
		position = UDim2.fromOffset(24, 26),
		textSize = 52,
		strokeTransparency = 1,
		zIndex = 6,
	})

	local text = Theme.label(bar, {
		text = "Abra seu primeiro ovo!",
		size = UDim2.new(1, -140, 0, 40),
		position = UDim2.fromOffset(100, 26),
		xAlign = Enum.TextXAlignment.Left,
		textSize = 28,
		color = Color3.fromRGB(60, 110, 180),
		strokeTransparency = 1,
		zIndex = 6,
	})

	local track = Instance.new("Frame")
	track.Size = UDim2.new(1, -64, 0, 12)
	track.Position = UDim2.fromOffset(32, 72)
	track.BackgroundColor3 = Color3.fromRGB(225, 235, 245)
	track.BorderSizePixel = 0
	track.ZIndex = 6
	track.Parent = bar
	Theme.corner(track, 6)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = Color3.fromRGB(120, 205, 110)
	fill.BorderSizePixel = 0
	fill.ZIndex = 7
	fill.Parent = track
	Theme.corner(fill, 6)

	refs.questText = text
	refs.questFill = fill
	refs.questIcon = icon
	refs.questTitle = title
	return bar
end

---------------------------------------------------------------------------
-- BOTÕES LATERAIS
---------------------------------------------------------------------------

local function sideButton(parent, text, icon, color, order, onClick)
	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.fromOffset(120, 120)
	holder.Position = UDim2.fromOffset(20, 0)
	holder.LayoutOrder = order
	holder.Parent = parent

	local shadow = Instance.new("Frame")
	shadow.Size = UDim2.fromOffset(112, 112)
	shadow.Position = UDim2.fromOffset(4, 8)
	shadow.BackgroundColor3 = Theme.shadow
	shadow.BackgroundTransparency = 0.6
	shadow.BorderSizePixel = 0
	shadow.ZIndex = 3
	shadow.Parent = holder
	Theme.corner(shadow, 24)

	local button = Instance.new("TextButton")
	button.Size = UDim2.fromOffset(112, 112)
	button.BackgroundColor3 = color
	button.BorderSizePixel = 0
	button.AutoButtonColor = false
	button.Text = ""
	button.ZIndex = 4
	button.Parent = holder
	Theme.corner(button, 24)
	Theme.stroke(button, Theme.outline, 4)
	Theme.gradient(button, Color3.new(1, 1, 1), Color3.fromRGB(215, 215, 215))

	local iconLabel = Theme.label(button, {
		text = icon,
		size = UDim2.fromScale(1, 0.66),
		position = UDim2.fromScale(0, 0.02),
		textSize = 52,
		strokeTransparency = 1,
		zIndex = 5,
	})

	Theme.label(button, {
		text = text,
		size = UDim2.fromScale(1, 0.3),
		position = UDim2.fromScale(0, 0.66),
		textSize = 22,
		strokeTransparency = 0.1,
		zIndex = 5,
	})

	local scale = Instance.new("UIScale")
	scale.Parent = button
	button.MouseButton1Down:Connect(function()
		scale.Scale = 0.92
	end)
	button.MouseButton1Up:Connect(function()
		scale.Scale = 1
	end)
	button.MouseLeave:Connect(function()
		scale.Scale = 1
	end)

	button.MouseButton1Click:Connect(onClick)
	return button, iconLabel
end

---------------------------------------------------------------------------
-- BUILD
---------------------------------------------------------------------------

function Hud.build(gui, callbacks)
	-- STATS (inferior esquerdo)
	local statsHolder = Instance.new("Frame")
	statsHolder.BackgroundTransparency = 1
	statsHolder.Size = UDim2.fromOffset(250, 190)
	statsHolder.Position = UDim2.new(0, 18, 1, -18)
	statsHolder.AnchorPoint = Vector2.new(0, 1)
	statsHolder.Parent = gui
	Theme.list(statsHolder, { padding = 2, hAlign = Enum.HorizontalAlignment.Left })

	statRow(statsHolder, { name = "Rebirths", icon = "♻️", label = "Rensamentos" })
	statRow(statsHolder, { name = "Coins", icon = "🪙", label = "+0/s" })
	statRow(statsHolder, { name = "Gems", icon = "💎", label = "Gemas" })

	-- BOTÕES LATERAIS (esquerda, meio)
	local sideHolder = Instance.new("Frame")
	sideHolder.BackgroundTransparency = 1
	sideHolder.Size = UDim2.fromOffset(130, 260)
	sideHolder.Position = UDim2.new(0, 16, 0.5, -130)
	sideHolder.Parent = gui
	Theme.list(sideHolder, { padding = 12, hAlign = Enum.HorizontalAlignment.Left })

	refs.shopButton = sideButton(sideHolder, "Loja", "🧺", Theme.red, 1, function()
		if callbacks and callbacks.shop then
			callbacks.shop()
		end
	end)
	refs.tradeButton = sideButton(sideHolder, "Troca", "🔀", Color3.fromRGB(255, 150, 60), 2, function()
		if callbacks and callbacks.trade then
			callbacks.trade()
		end
	end)

	-- MISSÃO (topo)
	questBar(gui)

	-- DEBUG/INFO do canto superior direito (config e som)
	local topRight = Instance.new("Frame")
	topRight.BackgroundTransparency = 1
	topRight.Size = UDim2.fromOffset(180, 52)
	topRight.Position = UDim2.new(1, -18, 0, 16)
	topRight.AnchorPoint = Vector2.new(1, 0)
	topRight.Parent = gui
	local layout = Theme.list(topRight, {
		direction = Enum.FillDirection.Horizontal,
		padding = 10,
		hAlign = Enum.HorizontalAlignment.Right,
	})
	layout.SortOrder = Enum.SortOrder.LayoutOrder

	local function circleButton(icon, order, onClick)
		local btn = Theme.button(topRight, {
			text = icon,
			size = UDim2.fromOffset(52, 52),
			color = Color3.fromRGB(120, 200, 255),
			textSize = 26,
			layoutOrder = order,
			radius = 26,
			shadow = false,
		})
		btn.MouseButton1Click:Connect(onClick)
		return btn
	end

	circleButton("⚙️", 1, function()
		if callbacks and callbacks.settings then
			callbacks.settings()
		end
	end)
	circleButton("🏆", 2, function()
		if callbacks and callbacks.ranks then
			callbacks.ranks()
		end
	end)

	-- assinatura de update
	local last = {}

	State.subscribe(function(snapshot)
		local Format_number = Format.number

		if last.coins ~= math.floor(snapshot.coins) then
			refs.Coins.Text = Format_number(snapshot.coins)
			last.coins = math.floor(snapshot.coins)
		end
		if last.income ~= math.floor(snapshot.income * 10) then
			refs.Coins_Label.Text = "+" .. Format_number(snapshot.income) .. "/s"
			last.income = math.floor(snapshot.income * 10)
		end
		if last.gems ~= snapshot.gems then
			refs.Gems.Text = Format_number(snapshot.gems)
			last.gems = snapshot.gems
		end
		if last.rebirths ~= snapshot.rebirths then
			refs.Rebirths.Text = tostring(snapshot.rebirths)
			last.rebirths = snapshot.rebirths
		end

		local quest = GameConfig.Quests[snapshot.questIndex]
		if quest then
			local progress = GameConfig.questProgress(snapshot, quest)
			refs.questText.Text = quest.text
			refs.questFill.Size = UDim2.fromScale(math.clamp(progress / quest.target, 0, 1), 1)
			refs.questTitle.Text = "PRÓXIMO!"
			refs.questTitle.TextColor3 = Color3.fromRGB(240, 170, 40)
		else
			refs.questText.Text = "Você completou tudo! 🏆"
			refs.questFill.Size = UDim2.fromScale(1, 1)
			refs.questTitle.Text = "COMPLETO!"
			refs.questTitle.TextColor3 = Color3.fromRGB(120, 200, 110)
		end
	end)

	return refs
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">MinePanel</string>
            <string name="Source"><![CDATA[-- MinePanel
-- O painel da Mina dos Pets: mostra cada pet equipado trabalhando, o que ele
-- trouxe e o botão de recolher.
--
-- O desenho desta tela é o que explica a mecânica sem texto nenhum:
--   - um trilho de progresso por pet (quanto falta para voltar)
--   - quando volta, o minério aparece com a cor dele
--   - o minério mais raro já achado fica no topo, como um troféu
-- Criança que não lê entende pelo movimento da barrinha.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)
local Net = require(Shared.Net)

local Theme = require(script.Parent.Theme)
local State = require(script.Parent.State)
local NetClient = require(script.Parent.NetClient)

local MinePanel = {}

local refs = { rows = {}, best = nil, total = nil }
local gui

local ROW_H = 66
local ROW_GAP = 8

local function rgb(color)
	return Color3.fromRGB(color[1], color[2], color[3])
end

local function buildRow(parent, index)
	local row = Instance.new("Frame")
	row.Name = "MineRow" .. index
	row.Size = UDim2.new(1, -32, 0, ROW_H)
	row.Position = UDim2.fromOffset(16, 78 + (index - 1) * (ROW_H + ROW_GAP))
	row.BackgroundColor3 = Color3.fromRGB(246, 250, 255)
	row.BorderSizePixel = 0
	row.ZIndex = 26
	row.Parent = parent
	Theme.corner(row, 18)

	-- bolinha do pet
	local dot = Instance.new("Frame")
	dot.Size = UDim2.fromOffset(30, 30)
	dot.Position = UDim2.fromOffset(14, 18)
	dot.BackgroundColor3 = Color3.fromRGB(200, 200, 210)
	dot.BorderSizePixel = 0
	dot.ZIndex = 27
	dot.Parent = row
	Theme.corner(dot, 15)

	-- barra de progresso: o trilho
	local track = Instance.new("Frame")
	track.Size = UDim2.new(1, -230, 0, 14)
	track.Position = UDim2.fromOffset(56, 14)
	track.BackgroundColor3 = Color3.fromRGB(214, 224, 236)
	track.BorderSizePixel = 0
	track.ZIndex = 27
	track.Parent = row
	Theme.corner(track, 7)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(0, 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(120, 200, 255)
	fill.BorderSizePixel = 0
	fill.ZIndex = 28
	fill.Parent = track
	Theme.corner(fill, 7)

	local status = Theme.label(row, {
		text = "escavando...",
		size = UDim2.new(1, -230, 0, 24),
		position = UDim2.fromOffset(56, 32),
		textSize = 17,
		align = Enum.TextXAlignment.Left,
		color = Color3.fromRGB(110, 120, 135),
		zIndex = 28,
	})

	-- botão de ação: "Apressar" enquanto escava, "Recolher" quando volta
	local action = Theme.button(row, {
		text = "⚡",
		size = UDim2.fromOffset(74, 40),
		position = UDim2.new(1, -88, 0, 13),
		color = Color3.fromRGB(255, 200, 90),
		textSize = 24,
		zIndex = 28,
		radius = 20,
	})

	local uid = nil
	action.MouseButton1Click:Connect(function()
		if not uid then
			return
		end
		local trip = refs.rows[index] and refs.rows[index].trip
		if not trip then
			return
		end
		if trip.ready then
			NetClient.action(Net.ActionKind.CollectMine, uid)
		else
			NetClient.action(Net.ActionKind.RushMine, uid)
		end
	end)

	refs.rows[index] = { row = row, dot = dot, fill = fill, status = status, action = action }
	return refs.rows[index]
end

function MinePanel.build(parentGui)
	gui = parentGui

	local root = Theme.panel(gui, {
		name = "MinePanel",
		size = UDim2.fromOffset(620, 600),
		position = UDim2.new(0.5, 0, 0.5, 0),
		color = Theme.white,
		radius = 30,
		zIndex = 25,
	})
	root.Visible = false
	refs.root = root

	-- placa pendurada, como nas referências: o nome fica FORA do painel,
	-- numa plaquinha escura. Dá a sensação de loja/postinho de verdade.
	Theme.titleTag(root, "⛏️ MINA DOS PETS", { width = 300, offset = -26, zIndex = 25 })

	local close = Theme.button(root, {
		text = "✕",
		size = UDim2.fromOffset(52, 52),
		position = UDim2.new(1, -18, 0, 14),
		color = Color3.fromRGB(255, 120, 120),
		textSize = 26,
		zIndex = 28,
		radius = 26,
	})
	close.MouseButton1Click:Connect(function()
		MinePanel.hide()
	end)

	-- troféu: melhor minério já achado + total de viagens
	refs.best = Theme.label(root, {
		text = "melhor achado: —",
		size = UDim2.new(1, -32, 0, 26),
		position = UDim2.fromOffset(16, 44),
		textSize = 20,
		align = Enum.TextXAlignment.Left,
		color = Color3.fromRGB(90, 100, 120),
		zIndex = 27,
	})

	-- botão de recolher tudo
	refs.collectAll = Theme.button(root, {
		text = "RECOLHER TUDO",
		size = UDim2.new(1, -32, 0, 46),
		position = UDim2.new(0, 16, 1, -58),
		color = Color3.fromRGB(120, 220, 160),
		textSize = 22,
		zIndex = 28,
		radius = 23,
	})
	refs.collectAll.MouseButton1Click:Connect(function()
		NetClient.action(Net.ActionKind.CollectMine)
	end)

	-- mensagem de mina vazia
	refs.empty = Theme.label(root, {
		text = "equipe um pet para ele começar a trabalhar",
		size = UDim2.new(1, -80, 0, 80),
		position = UDim2.new(0, 40, 0.42, 0),
		textSize = 22,
		color = Color3.fromRGB(150, 158, 172),
		zIndex = 27,
	})
	refs.empty.Visible = false
end

function MinePanel.update()
	local snapshot = State.snapshot
	if not snapshot or not refs.root then
		return
	end
	local mine = snapshot.mine
	if not mine then
		return
	end

	local trips = mine.trips or {}
	refs.empty.Visible = #trips == 0
	if refs.collectAll then
		refs.collectAll.Visible = #trips > 0
	end

	if refs.best then
		local bestName = "—"
		for _, ore in ipairs(mine.ores or {}) do
			if ore.id == mine.best then
				bestName = ore.name
			end
		end
		refs.best.Text = string.format("🏆 melhor achado: %s   ·   viagens: %d", bestName, mine.dug or 0)
	end

	for index = 1, 7 do
		local view = refs.rows[index]
		if not view then
			view = buildRow(refs.root, index)
		end
		local trip = trips[index]
		-- o tick local precisa saber a duração da viagem para avançar a barra
		if trip then
			trip.tripSeconds = mine.tripSeconds or 7
		end
		view.trip = trip
		if trip then
			view.row.Visible = true
			view.fill.Size = UDim2.new(trip.progress or 0, 0, 1, 0)

			local ore = nil
			for _, entry in ipairs(mine.ores or {}) do
				if entry.id == trip.oreId then
					ore = entry
				end
			end

			if trip.ready and ore then
				view.dot.BackgroundColor3 = rgb(ore.color)
				view.fill.BackgroundColor3 = rgb(ore.color)
				view.status.Text = string.format("%s · +%s moedas", ore.name, Format.number(ore.value))
				view.action.Text = "✔"
				view.action.BackgroundColor3 = Color3.fromRGB(120, 220, 160)
			else
				view.dot.BackgroundColor3 = Color3.fromRGB(200, 200, 210)
				view.fill.BackgroundColor3 = Color3.fromRGB(120, 200, 255)
				view.status.Text = string.format("escavando... %d%%", math.floor((trip.progress or 0) * 100))
				view.action.Text = "⚡"
				view.action.BackgroundColor3 = Color3.fromRGB(255, 200, 90)
			end
		else
			view.row.Visible = false
		end
	end
end

function MinePanel.isOpen()
	return refs.root ~= nil and refs.root.Visible
end

-- Avança as barras com o tempo local entre um snapshot e outro, para a mina
-- não parecer travada. O servidor manda o valor real e corrige sozinho.
function MinePanel.tick(dt)
	for _, view in pairs(refs.rows) do
		local trip = view.trip
		if trip and not trip.ready and view.row.Visible then
			trip.progress = math.min(1, (trip.progress or 0) + dt / (trip.tripSeconds or 7))
			view.fill.Size = UDim2.new(trip.progress, 0, 1, 0)
			view.status.Text = string.format("escavando... %d%%", math.floor(trip.progress * 100))
			if trip.progress >= 1 then
				-- chegou no fim do trilho: pede o estado real ao servidor
				trip.readyPending = true
			end
		end
	end
end

function MinePanel.show()
	if not refs.root then
		return
	end
	refs.root.Visible = true
	MinePanel.update()
end

function MinePanel.hide()
	if refs.root then
		refs.root.Visible = false
	end
end

function MinePanel.toggle()
	if refs.root and refs.root.Visible then
		MinePanel.hide()
	else
		MinePanel.show()
	end
end

return MinePanel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">NetClient</string>
            <string name="Source"><![CDATA[-- NetClient
-- Fio de rede do cliente.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local NetClient = {}

local folder = ReplicatedStorage:WaitForChild(Net.FolderName)
local state = folder:WaitForChild(Net.State)
local action = folder:WaitForChild(Net.Action)
local event = folder:WaitForChild(Net.Event)

NetClient.state = state
NetClient.event = event

function NetClient.action(kind, payload)
	action:FireServer(kind, payload)
end

function NetClient.on(callback)
	return event.OnClientEvent:Connect(callback)
end

return NetClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">PetsPanel</string>
            <string name="Source"><![CDATA[-- PetsPanel
-- Inventário em grade: equipar, vender, e a fusão dos 3 selecionados.
-- Clique no pet = equipar/desequipar. Segurar = modo venda.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Format = require(Shared.Format)
local Net = require(Shared.Net)

local Theme = require(script.Parent.Theme)
local State = require(script.Parent.State)
local NetClient = require(script.Parent.NetClient)

local PetsPanel = {}

local refs = { cards = {} }
local gui
local fuseMode = false
local fuseSelection = {}
local sellMode = false

local CARD = 92
local PER_ROW = 6

local function sortedPets(snapshot)
	local list = {}
	for _, instance in ipairs(snapshot.pets or {}) do
		table.insert(list, instance)
	end
	table.sort(list, function(a, b)
		local petA = GameConfig.pet(a.petId)
		local petB = GameConfig.pet(b.petId)
		if not petA or not petB then
			return false
		end
		local ra = GameConfig.rarity(petA.rarity).order
		local rb = GameConfig.rarity(petB.rarity).order
		if ra ~= rb then
			return ra > rb
		end
		return petA.income > petB.income
	end)
	return list
end

local function isEquipped(snapshot, uid)
	for _, id in ipairs(snapshot.equipped or {}) do
		if id == uid then
			return true
		end
	end
	return false
end

local function inFuse(uid)
	for _, id in ipairs(fuseSelection) do
		if id == uid then
			return true
		end
	end
	return false
end

---------------------------------------------------------------------------
-- CARD
---------------------------------------------------------------------------

local function buildCard(parent, instance)
	local pet = GameConfig.pet(instance.petId)
	if not pet then
		return nil
	end
	local rarity = GameConfig.rarity(pet.rarity)

	local card = Instance.new("TextButton")
	card.Size = UDim2.fromOffset(CARD, CARD + 22)
	card.BackgroundColor3 = Color3.fromRGB(255, 252, 246)
	card.BorderSizePixel = 0
	card.AutoButtonColor = false
	card.Text = ""
	card.ClipsDescendants = false
	card.Parent = parent
	Theme.corner(card, 18)
	local stroke = Theme.stroke(card, rarity.color, 4)

	local iconHolder = Instance.new("Frame")
	iconHolder.Size = UDim2.fromOffset(CARD - 20, CARD - 20)
	iconHolder.Position = UDim2.fromOffset(10, 8)
	iconHolder.BackgroundColor3 = pet.color
	iconHolder.BorderSizePixel = 0
	iconHolder.ZIndex = 2
	iconHolder.Parent = card
	Theme.corner(iconHolder, math.floor((CARD - 20) / 2))
	Theme.stroke(iconHolder, Theme.outline, 2)

	Theme.label(iconHolder, {
		text = pet.emoji,
		size = UDim2.fromScale(1, 1),
		textSize = 44,
		strokeTransparency = 1,
		zIndex = 3,
	})

	local name = Theme.label(card, {
		text = pet.name,
		size = UDim2.new(1, -8, 0, 18),
		position = UDim2.fromOffset(4, CARD - 10),
		textSize = 13,
		color = Theme.textDark,
		strokeTransparency = 1,
		zIndex = 3,
	})

	local income = Theme.label(card, {
		text = "🪙 " .. Format.number(pet.income * (instance.golden and 1.5 or 1)),
		size = UDim2.new(1, -8, 0, 16),
		position = UDim2.fromOffset(4, CARD + 4),
		textSize = 13,
		color = Color3.fromRGB(220, 150, 30),
		strokeTransparency = 1,
		zIndex = 3,
	})

	-- selo EQUIPADO
	local badge = Theme.label(card, {
		text = "✓",
		size = UDim2.fromOffset(26, 26),
		position = UDim2.new(1, -6, 0, -6),
		anchor = Vector2.new(1, 0),
		textSize = 18,
		color = Color3.fromRGB(255, 255, 255),
		strokeTransparency = 1,
		zIndex = 6,
	})
	local badgeBg = Instance.new("Frame")
	badgeBg.Size = UDim2.fromOffset(26, 26)
	badgeBg.Position = UDim2.new(1, -6, 0, -6)
	badgeBg.AnchorPoint = Vector2.new(1, 0)
	badgeBg.BackgroundColor3 = Color3.fromRGB(110, 205, 110)
	badgeBg.BorderSizePixel = 0
	badgeBg.ZIndex = 5
	badgeBg.Visible = false
	badgeBg.Parent = card
	Theme.corner(badgeBg, 13)
	Theme.stroke(badgeBg, Theme.outline, 2)
	badge.Parent = badgeBg
	badge.Position = UDim2.fromScale(0.5, 0.5)
	badge.AnchorPoint = Vector2.new(0.5, 0.5)
	badge.Size = UDim2.fromScale(1, 1)

	if instance.golden then
		local glow = Instance.new("UIStroke")
		glow.Color = Color3.fromRGB(255, 210, 80)
		glow.Thickness = 5
		glow.Transparency = 0.2
		glow.Parent = card
	end

	card.MouseButton1Click:Connect(function()
		if fuseMode then
			local found = nil
			for index, id in ipairs(fuseSelection) do
				if id == instance.uid then
					found = index
					break
				end
			end
			if found then
				table.remove(fuseSelection, found)
			elseif #fuseSelection < 3 then
				table.insert(fuseSelection, instance.uid)
			end
			PetsPanel.refresh()
			return
		end

		if sellMode then
			PetsPanel.confirmSell(instance.uid)
			return
		end

		if isEquipped(State.snapshot, instance.uid) then
			NetClient.action(Net.ActionKind.Unequip, instance.uid)
		else
			NetClient.action(Net.ActionKind.Equip, instance.uid)
		end
	end)

	return {
		card = card,
		stroke = stroke,
		badgeBg = badgeBg,
		instance = instance,
		pet = pet,
	}
end

---------------------------------------------------------------------------
-- BUILD
---------------------------------------------------------------------------

function PetsPanel.build(parentGui)
	gui = parentGui

	local root = Theme.panel(gui, {
		name = "PetsPanel",
		size = UDim2.fromOffset(660, 600),
		position = UDim2.new(0.5, 0, 0.5, 0),
		color = Theme.white,
		radius = 30,
		zIndex = 25,
	})
	root.Visible = false
	refs.root = root

	Theme.titleTag(root, "MEUS PETS", { width = 240, offset = -26, zIndex = 24 })

	local close = Theme.button(root, {
		text = "✕",
		size = UDim2.fromOffset(52, 52),
		position = UDim2.new(1, -18, 0, 14),
		anchor = Vector2.new(1, 0),
		color = Theme.red,
		textSize = 26,
		radius = 26,
		shadow = false,
		zIndex = 30,
	})
	close.MouseButton1Click:Connect(function()
		PetsPanel.hide()
	end)

	refs.countLabel = Theme.label(root, {
		text = "0 / 0 equipados",
		size = UDim2.new(1, -40, 0, 24),
		position = UDim2.fromOffset(24, 88),
		xAlign = Enum.TextXAlignment.Left,
		textSize = 17,
		color = Theme.textDark,
		strokeTransparency = 1,
		zIndex = 27,
	})

	-- botões de modo
	local modeBar = Instance.new("Frame")
	modeBar.Size = UDim2.new(1, -40, 0, 46)
	modeBar.Position = UDim2.fromOffset(20, 116)
	modeBar.BackgroundTransparency = 1
	modeBar.ZIndex = 27
	modeBar.Parent = root
	Theme.list(modeBar, {
		direction = Enum.FillDirection.Horizontal,
		padding = 8,
		hAlign = Enum.HorizontalAlignment.Left,
	})

	local function modeButton(text, order, color)
		local btn = Theme.button(modeBar, {
			text = text,
			size = UDim2.fromOffset(150, 46),
			color = color,
			textSize = 17,
			layoutOrder = order,
			radius = 23,
			shadow = false,
			zIndex = 28,
		})
		return btn
	end

	local fuseButton = modeButton("FUNDIR", 1, Theme.purple)
	local sellButton = modeButton("VENDER", 2, Theme.red)

	fuseButton.MouseButton1Click:Connect(function()
		fuseMode = not fuseMode
		sellMode = false
		fuseSelection = {}
		PetsPanel.refresh()
	end)

	sellButton.MouseButton1Click:Connect(function()
		sellMode = not sellMode
		fuseMode = false
		PetsPanel.refresh()
	end)

	local confirmFuse = Theme.button(modeBar, {
		text = "CONFIRMAR FUSÃO",
		size = UDim2.fromOffset(200, 46),
		color = Theme.pink,
		textSize = 16,
		layoutOrder = 3,
		radius = 23,
		shadow = false,
		zIndex = 28,
	})
	refs.confirmFuse = confirmFuse
	confirmFuse.MouseButton1Click:Connect(function()
		if #fuseSelection == 3 then
			NetClient.action(Net.ActionKind.Fuse, fuseSelection)
			fuseSelection = {}
			fuseMode = false
			PetsPanel.refresh()
		end
	end)

	-- grade
	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = UDim2.new(1, -40, 1, -190)
	scroll.Position = UDim2.fromOffset(20, 172)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 5
	scroll.ScrollBarImageColor3 = Color3.fromRGB(200, 210, 225)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.CanvasSize = UDim2.fromOffset(0, 0)
	scroll.ZIndex = 26
	scroll.Parent = root

	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.fromOffset(CARD, CARD + 22)
	grid.CellPadding = UDim2.fromOffset(10, 10)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.HorizontalAlignment = Enum.HorizontalAlignment.Left
	grid.Parent = scroll
	refs.grid = scroll

	refs.empty = Theme.label(root, {
		text = "Nenhum pet ainda.\nAbra um ovo na aba OVOS 🥚",
		size = UDim2.new(1, -60, 0, 120),
		position = UDim2.fromScale(0.5, 0.55),
		anchor = Vector2.new(0.5, 0.5),
		textSize = 22,
		color = Color3.fromRGB(170, 170, 180),
		strokeTransparency = 1,
		wrapped = true,
		zIndex = 27,
	})

	Theme.makeDraggable(root, header)

	State.subscribe(function()
		if root.Visible then
			PetsPanel.refresh()
		end
	end)

	return root
end

function PetsPanel.confirmSell(uid)
	local instance = nil
	for _, cardRef in pairs(refs.cards) do
		if cardRef.instance.uid == uid then
			instance = cardRef.instance
			break
		end
	end
	if not instance then
		return
	end
	-- venda direta (o servidor devolve o valor via toast)
	NetClient.action(Net.ActionKind.SellPet, uid)
end

function PetsPanel.refresh()
	local snapshot = State.snapshot
	if not snapshot or not refs.root then
		return
	end

	for _, cardRef in pairs(refs.cards) do
		cardRef.card:Destroy()
	end
	refs.cards = {}

	local list = sortedPets(snapshot)
	refs.empty.Visible = #list == 0

	for index, instance in ipairs(list) do
		local cardRef = buildCard(refs.grid, instance)
		if cardRef then
			cardRef.card.LayoutOrder = index
			cardRef.badgeBg.Visible = isEquipped(snapshot, instance.uid)

			if inFuse(instance.uid) then
				cardRef.stroke.Color = Theme.cyan
				cardRef.stroke.Thickness = 7
			end
			if sellMode then
				cardRef.card.BackgroundColor3 = Color3.fromRGB(255, 235, 235)
			end
			refs.cards[instance.uid] = cardRef
		end
	end

	refs.countLabel.Text = string.format(
		"%d pets · %d/%d equipados · renda +%s/s",
		#list,
		#snapshot.equipped,
		snapshot.slots,
		Format.number(snapshot.income)
	)

	refs.confirmFuse.Visible = fuseMode
	refs.confirmFuse.Text = string.format("CONFIRMAR FUSÃO (%d/3)", #fuseSelection)
	refs.confirmFuse.BackgroundColor3 = #fuseSelection == 3 and Theme.green or Color3.fromRGB(190, 190, 200)
end

function PetsPanel.show()
	refs.root.Visible = true
	PetsPanel.refresh()
end

function PetsPanel.hide()
	refs.root.Visible = false
	fuseMode = false
	sellMode = false
	fuseSelection = {}
end

function PetsPanel.toggle()
	if refs.root.Visible then
		PetsPanel.hide()
	else
		PetsPanel.show()
	end
end

return PetsPanel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">ShopPanel</string>
            <string name="Source"><![CDATA[-- ShopPanel
-- Loja de moedas (toque, slots, multiplicador) e loja de gemas
-- (renda, sorte, toque, slots) — duas abas no mesmo painel, como nos prints.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Format = require(Shared.Format)
local Net = require(Shared.Net)

local Theme = require(script.Parent.Theme)
local State = require(script.Parent.State)
local NetClient = require(script.Parent.NetClient)

local ShopPanel = {}

local refs = { rows = {} }
local gui
local currentTab = "coins"

local COIN_META = {
	tap = { icon = "👆", desc = "Mais moedas por toque" },
	slots = { icon = "🎒", desc = "Equipe mais pets" },
	mult = { icon = "✨", desc = "Multiplica toda a renda" },
}

local GEM_META = {
	gemsIncome = { icon = "💎", desc = "Renda de pets permanente" },
	gemsLuck = { icon = "🍀", desc = "Mais chance de pets raros" },
	gemsTap = { icon = "👊", desc = "Toque mais forte, pra sempre" },
	gemsSlots = { icon = "🎒", desc = "Slot extra permanente" },
}

local function clearRows()
	for _, row in pairs(refs.rows) do
		row:Destroy()
	end
	refs.rows = {}
end

local function buildRow(parent, order, icon, title, subtitle, buttonText, affordable, onClick)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -8, 0, 76)
	row.BackgroundColor3 = Color3.fromRGB(255, 250, 240)
	row.BorderSizePixel = 0
	row.LayoutOrder = order
	row.Parent = parent
	Theme.corner(row, 18)
	Theme.stroke(row, Color3.fromRGB(230, 215, 195), 3)

	local iconFrame = Instance.new("Frame")
	iconFrame.Size = UDim2.fromOffset(52, 52)
	iconFrame.Position = UDim2.fromOffset(12, 12)
	iconFrame.BackgroundColor3 = Color3.fromRGB(255, 235, 200)
	iconFrame.BorderSizePixel = 0
	iconFrame.ZIndex = 2
	iconFrame.Parent = row
	Theme.corner(iconFrame, 16)

	Theme.label(iconFrame, {
		text = icon,
		size = UDim2.fromScale(1, 1),
		textSize = 28,
		strokeTransparency = 1,
		zIndex = 3,
	})

	Theme.label(row, {
		text = title,
		size = UDim2.new(1, -230, 0, 22),
		position = UDim2.fromOffset(76, 12),
		xAlign = Enum.TextXAlignment.Left,
		textSize = 18,
		color = Theme.textDark,
		strokeTransparency = 1,
		zIndex = 3,
	})

	Theme.label(row, {
		text = subtitle,
		size = UDim2.new(1, -230, 0, 18),
		position = UDim2.fromOffset(76, 36),
		xAlign = Enum.TextXAlignment.Left,
		textSize = 14,
		color = Color3.fromRGB(160, 150, 140),
		strokeTransparency = 1,
		zIndex = 3,
	})

	local buy = Theme.button(row, {
		text = buttonText,
		size = UDim2.fromOffset(150, 46),
		position = UDim2.new(1, -12, 0.5, 0),
		anchor = Vector2.new(1, 0.5),
		color = affordable and Theme.green or Color3.fromRGB(200, 200, 205),
		textSize = 16,
		radius = 23,
		shadow = false,
		zIndex = 4,
	})
	buy.MouseButton1Click:Connect(function()
		if affordable then
			onClick()
		end
	end)

	refs.rows[#refs.rows + 1] = row
	return row
end

function ShopPanel.build(parentGui)
	gui = parentGui

	local root = Theme.panel(gui, {
		name = "ShopPanel",
		size = UDim2.fromOffset(560, 580),
		position = UDim2.new(0.5, 0, 0.5, 0),
		color = Theme.white,
		radius = 30,
		zIndex = 25,
	})
	root.Visible = false
	refs.root = root

	-- titleTag devolve o TextLabel interno, então refs.title.Text continua
	-- funcionando quando alterna entre LOJA e GEMAS.
	refs.title = Theme.titleTag(root, "LOJA", { width = 190, offset = -26, zIndex = 25, textSize = 26 })

	local close = Theme.button(root, {
		text = "✕",
		size = UDim2.fromOffset(52, 52),
		position = UDim2.new(1, -18, 0, 14),
		anchor = Vector2.new(1, 0),
		color = Theme.red,
		textSize = 26,
		radius = 26,
		shadow = false,
		zIndex = 30,
	})
	close.MouseButton1Click:Connect(function()
		ShopPanel.hide()
	end)

	-- barra de abas
	local tabs = Instance.new("Frame")
	tabs.Size = UDim2.new(1, -40, 0, 52)
	tabs.Position = UDim2.fromOffset(20, 88)
	tabs.BackgroundTransparency = 1
	tabs.ZIndex = 27
	tabs.Parent = root
	Theme.list(tabs, {
		direction = Enum.FillDirection.Horizontal,
		padding = 8,
		hAlign = Enum.HorizontalAlignment.Left,
	})

	local function tabButton(text, id, order, color)
		local btn = Theme.button(tabs, {
			text = text,
			size = UDim2.fromOffset(240, 50),
			color = color,
			textSize = 19,
			layoutOrder = order,
			radius = 25,
			shadow = false,
			zIndex = 28,
		})
		btn.MouseButton1Click:Connect(function()
			currentTab = id
			ShopPanel.refresh()
		end)
		return btn
	end

	refs.coinTab = tabButton("🪙 MOEDAS", "coins", 1, Theme.yellow)
	refs.gemTab = tabButton("💎 GEMAS", "gems", 2, Theme.purple)

	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = UDim2.new(1, -32, 1, -176)
	scroll.Position = UDim2.fromOffset(16, 152)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 5
	scroll.ScrollBarImageColor3 = Color3.fromRGB(210, 200, 190)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.CanvasSize = UDim2.fromOffset(0, 0)
	scroll.ZIndex = 26
	scroll.Parent = root
	Theme.list(scroll, { padding = 8 })
	refs.scroll = scroll

	Theme.makeDraggable(root, header)

	State.subscribe(function()
		if root.Visible then
			ShopPanel.refresh()
		end
	end)

	return root
end

function ShopPanel.refresh()
	local snapshot = State.snapshot
	if not snapshot or not refs.root then
		return
	end

	clearRows()
	refs.coinTab.BackgroundColor3 = currentTab == "coins" and Theme.yellow or Color3.fromRGB(220, 220, 220)
	refs.gemTab.BackgroundColor3 = currentTab == "gems" and Theme.purple or Color3.fromRGB(220, 220, 220)

	if currentTab == "coins" then
		refs.title.Text = "LOJA"
		local order = 0
		for _, kind in ipairs({ "tap", "slots", "mult" }) do
			order += 1
			local meta = COIN_META[kind]
			local upgrade = GameConfig.Upgrades[kind]
			local tier = snapshot.upgrades[kind]
			local cost = GameConfig.upgradeCost(kind, tier)
			local prefix = "Nível " .. tier .. "/" .. upgrade.maxTier .. " · " .. meta.desc

			local text
			if cost then
				text = "🪙 " .. Format.number(cost)
			else
				text = "MÁXIMO"
			end

			buildRow(
				refs.scroll,
				order,
				meta.icon,
				upgrade.name,
				prefix,
				text,
				cost ~= nil and snapshot.coins >= cost,
				function()
					NetClient.action(Net.ActionKind.BuyUpgrade, kind)
				end
			)
		end
	else
		refs.title.Text = "GEMAS"
		local order = 0
		for _, kind in ipairs({ "gemsIncome", "gemsLuck", "gemsTap", "gemsSlots" }) do
			order += 1
			local meta = GEM_META[kind]
			local upgrade = GameConfig.GemUpgrades[kind]
			local rank = snapshot.gemUpgrades[kind]
			local cost = GameConfig.gemCost(kind, rank)
			local prefix = "Rank " .. rank .. "/" .. upgrade.maxRank .. " · " .. meta.desc

			local text
			if cost then
				text = "💎 " .. cost
			else
				text = "MÁXIMO"
			end

			buildRow(
				refs.scroll,
				order,
				meta.icon,
				upgrade.name,
				prefix,
				text,
				cost ~= nil and snapshot.gems >= cost,
				function()
					NetClient.action(Net.ActionKind.BuyGemUpgrade, kind)
				end
			)
		end

		-- troca de gemas (informativo)
		order += 1
		buildRow(
			refs.scroll,
			order,
			"💠",
			"Ganhe gemas",
			"Rebirth dá gemas · ranking semanal",
			"—",
			false,
			function() end
		)
	end
end

function ShopPanel.show(tab)
	if tab then
		currentTab = tab
	end
	refs.root.Visible = true
	ShopPanel.refresh()
end

function ShopPanel.hide()
	refs.root.Visible = false
end

function ShopPanel.toggle()
	if refs.root.Visible then
		ShopPanel.hide()
	else
		ShopPanel.show()
	end
end

return ShopPanel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[-- State
-- Snapshot mais recente + assinatura. Sem framework.

local State = {}

State.snapshot = nil
State.static = nil
State.listeners = {}

function State.set(snapshot)
	State.snapshot = snapshot
	for _, callback in ipairs(State.listeners) do
		task.spawn(callback, snapshot)
	end
end

function State.setStatic(data)
	State.static = data
end

function State.subscribe(callback)
	table.insert(State.listeners, callback)
	if State.snapshot then
		task.spawn(callback, State.snapshot)
	end
	return function()
		for index, listener in ipairs(State.listeners) do
			if listener == callback then
				table.remove(State.listeners, index)
				break
			end
		end
	end
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">TapButton</string>
            <string name="Source"><![CDATA[-- TapButton
-- O botão gigante de toque no canto inferior direito, com o "+1" flutuando
-- igual aos prints. Também aceita clique direto no mundo (mouse) pra tocar.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)

local Theme = require(script.Parent.Theme)
local State = require(script.Parent.State)

local TapButton = {}

local refs = {}
local gui
local onTap

local function spawnPlusOne(amount)
	local parent = refs.holder
	if not parent then
		return
	end

	local plus = Theme.label(parent, {
		text = "+" .. Format.number(amount),
		size = UDim2.fromOffset(150, 60),
		position = UDim2.fromScale(0.5, 0.1),
		anchor = Vector2.new(0.5, 1),
		textSize = 34,
		color = Theme.yellow,
		strokeTransparency = 0,
		strokeColor = Theme.outline,
		zIndex = 20,
	})
	plus.Rotation = math.random(-8, 8)

	TweenService:Create(plus, TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Position = plus.Position - UDim2.fromScale(0, 0.5),
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	}):Play()

	task.delay(0.75, function()
		plus:Destroy()
	end)
end

function TapButton.build(parentGui, tapCallback)
	gui = parentGui
	onTap = tapCallback

	local holder = Instance.new("Frame")
	holder.Name = "TapHolder"
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.fromOffset(210, 210)
	holder.Position = UDim2.new(1, -30, 1, -30)
	holder.AnchorPoint = Vector2.new(1, 1)
	holder.Parent = gui
	refs.holder = holder

	-- sombra
	local shadow = Instance.new("Frame")
	shadow.Size = UDim2.fromOffset(184, 184)
	shadow.Position = UDim2.fromOffset(8, 16)
	shadow.AnchorPoint = Vector2.new(0.5, 0.5)
	shadow.BackgroundColor3 = Theme.shadow
	shadow.BackgroundTransparency = 0.55
	shadow.BorderSizePixel = 0
	shadow.Parent = holder
	Theme.corner(shadow, 46)

	-- botão
	local button = Instance.new("TextButton")
	button.Name = "TapButton"
	button.Size = UDim2.fromOffset(184, 184)
	button.AnchorPoint = Vector2.new(0.5, 0.5)
	button.Position = UDim2.fromScale(0.5, 0.5)
	button.BackgroundColor3 = Color3.fromRGB(110, 195, 250)
	button.BorderSizePixel = 0
	button.AutoButtonColor = false
	button.Text = ""
	button.Parent = holder
	Theme.corner(button, 46)
	Theme.stroke(button, Color3.fromRGB(70, 140, 210), 6)
	Theme.gradient(button, Color3.fromRGB(160, 225, 255), Color3.fromRGB(90, 170, 235))

	-- "dedo" desenhado com partes (sem asset)
	local finger = Theme.label(button, {
		text = "👆",
		size = UDim2.fromScale(0.72, 0.72),
		position = UDim2.fromScale(0.5, 0.44),
		anchor = Vector2.new(0.5, 0.5),
		textSize = 96,
		strokeTransparency = 1,
		zIndex = 5,
	})
	finger.Rotation = -12

	-- selo "+1" no topo, como no print
	local badgeFrame = Instance.new("Frame")
	badgeFrame.Size = UDim2.fromOffset(74, 44)
	badgeFrame.Position = UDim2.fromScale(0.62, 0.02)
	badgeFrame.AnchorPoint = Vector2.new(0.5, 0.5)
	badgeFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	badgeFrame.BorderSizePixel = 0
	badgeFrame.ZIndex = 8
	badgeFrame.Parent = holder
	Theme.corner(badgeFrame, 14)
	Theme.stroke(badgeFrame, Color3.fromRGB(60, 130, 200), 4)

	Theme.label(badgeFrame, {
		text = "+1",
		size = UDim2.fromScale(1, 1),
		textSize = 26,
		color = Color3.fromRGB(70, 150, 220),
		strokeTransparency = 1,
		zIndex = 9,
	})

	local scale = Instance.new("UIScale")
	scale.Parent = button

	local function doTap()
		scale.Scale = 0.9
		TweenService:Create(scale, TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Scale = 1,
		}):Play()
		onTap()
	end

	button.MouseButton1Click:Connect(doTap)
	-- mobile: mousebutton1click cobre touch; adiciona também atalho espaço
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.Space then
			doTap()
		end
	end)

	refs.button = button
	refs.finger = finger

	local lastPower = 1
	State.subscribe(function(snapshot)
		lastPower = snapshot.tapPower or 1
		local badge = badgeFrame:FindFirstChildOfClass("TextLabel")
		if badge then
			badge.Text = "+" .. Format.number(lastPower)
		end
	end)

	return holder
end

function TapButton.showReward(amount)
	spawnPlusOne(amount)
end

return TapButton
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Theme</string>
            <string name="Source"><![CDATA[-- Theme
-- Visual cartoon dos tycoons de ovo: cantos bem grandes, contorno escuro
-- grosso, gradiente pastel, sombra chapada embaixo. Fonte FredokaOne.
-- Nada de painel cinza de programador.

local Theme = {}

Theme.text = Color3.fromRGB(255, 255, 255)
Theme.textDark = Color3.fromRGB(74, 52, 38)
Theme.outline = Color3.fromRGB(64, 44, 30)

Theme.green = Color3.fromRGB(126, 217, 87)
Theme.greenDark = Color3.fromRGB(74, 160, 60)
Theme.yellow = Color3.fromRGB(255, 206, 61)
Theme.yellowDark = Color3.fromRGB(226, 158, 26)
Theme.blue = Color3.fromRGB(96, 186, 255)
Theme.blueDark = Color3.fromRGB(52, 132, 216)
Theme.purple = Color3.fromRGB(178, 130, 255)
Theme.purpleDark = Color3.fromRGB(124, 78, 205)
Theme.pink = Color3.fromRGB(255, 138, 190)
Theme.pinkDark = Color3.fromRGB(215, 84, 145)
Theme.red = Color3.fromRGB(255, 106, 106)
Theme.cyan = Color3.fromRGB(96, 240, 235)
Theme.white = Color3.fromRGB(255, 252, 245)
Theme.panel = Color3.fromRGB(255, 248, 232)
Theme.panelStroke = Color3.fromRGB(206, 168, 116)
Theme.shadow = Color3.fromRGB(38, 26, 18)

Theme.font = Enum.Font.FredokaOne
Theme.fontBody = Enum.Font.FredokaOne
Theme.fontNum = Enum.Font.FredokaOne

local function corner(instance, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 18)
	c.Parent = instance
	return c
end
Theme.corner = corner

local function stroke(instance, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color or Theme.outline
	s.Thickness = thickness or 3
	s.Transparency = transparency or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.LineJoinMode = Enum.LineJoinMode.Round
	s.Parent = instance
	return s
end
Theme.stroke = stroke

local function gradient(instance, top, bottom, rotation)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(top, bottom)
	g.Rotation = rotation or 90
	g.Parent = instance
	return g
end
Theme.gradient = gradient

-- botão principal: pílula com gradiente, contorno grosso e sombra
function Theme.button(parent, props)
	local button = Instance.new("TextButton")
	button.Name = props.name or "Button"
	button.AutoButtonColor = false
	button.BorderSizePixel = 0
	button.Size = props.size or UDim2.fromOffset(200, 56)
	button.Position = props.position or UDim2.fromOffset(0, 0)
	button.AnchorPoint = props.anchor or Vector2.zero
	button.Font = props.font or Theme.font
	button.Text = props.text or ""
	button.TextColor3 = props.textColor or Theme.text
	button.TextSize = props.textSize or 22
	button.TextStrokeTransparency = props.textStrokeTransparency or 0.25
	button.TextStrokeColor3 = Theme.outline
	button.BackgroundColor3 = props.color or Theme.green
	button.LayoutOrder = props.layoutOrder or 0
	button.ZIndex = props.zIndex or 2
	button.Parent = parent

	corner(button, props.radius or (button.AbsoluteSize.Y > 0 and math.floor(button.AbsoluteSize.Y / 2) or 22))
	stroke(button, props.strokeColor or Theme.outline, props.strokeThickness or 3)
	gradient(button, props.gradientTop or Color3.new(1, 1, 1), props.gradientBottom or Color3.fromRGB(228, 228, 228))

	if props.shadow ~= false then
		local shadow = Instance.new("Frame")
		shadow.Name = "Shadow"
		shadow.BackgroundColor3 = props.shadowColor or Theme.shadow
		shadow.BackgroundTransparency = 0.6
		shadow.BorderSizePixel = 0
		shadow.Size = UDim2.fromScale(1, 1)
		shadow.Position = UDim2.fromOffset(0, props.shadowOffset or 5)
		shadow.ZIndex = button.ZIndex - 1
		shadow.Parent = parent
		corner(shadow, props.radius or 22)
		stroke(shadow, Theme.outline, props.strokeThickness or 3)
		shadow.LayoutOrder = -1

		button.AncestryChanged:Connect(function()
			shadow:Destroy()
		end)

		-- acompanha posição e tamanho do botão
		local function sync()
			shadow.Position = button.Position + UDim2.fromOffset(0, props.shadowOffset or 5)
			shadow.Size = button.Size
			shadow.AnchorPoint = button.AnchorPoint
			shadow.Visible = button.Visible
		end
		button:GetPropertyChangedSignal("Position"):Connect(sync)
		button:GetPropertyChangedSignal("Size"):Connect(sync)
		button:GetPropertyChangedSignal("Visible"):Connect(sync)
		sync()
	end

	-- feedback de press
	local scale = Instance.new("UIScale")
	scale.Parent = button
	button.MouseButton1Down:Connect(function()
		scale.Scale = 0.94
	end)
	button.MouseButton1Up:Connect(function()
		scale.Scale = 1
	end)
	button.MouseLeave:Connect(function()
		scale.Scale = 1
	end)

	return button
end

function Theme.panel(parent, props)
	local frame = Instance.new("Frame")
	frame.Name = props.name or "Panel"
	frame.BackgroundColor3 = props.color or Theme.panel
	frame.BorderSizePixel = 0
	frame.Size = props.size or UDim2.fromOffset(420, 520)
	frame.Position = props.position or UDim2.new(0.5, 0, 0.5, 0)
	frame.AnchorPoint = props.anchor or Vector2.new(0.5, 0.5)
	frame.ZIndex = props.zIndex or 10
	frame.Parent = parent

	corner(frame, props.radius or 26)
	stroke(frame, props.strokeColor or Theme.panelStroke, 4)
	return frame
end

function Theme.label(parent, props)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = props.size or UDim2.fromScale(1, 1)
	label.Position = props.position or UDim2.fromOffset(0, 0)
	label.AnchorPoint = props.anchor or Vector2.zero
	label.Font = props.font or Theme.font
	label.Text = props.text or ""
	label.TextColor3 = props.color or Theme.text
	label.TextSize = props.textSize or 20
	label.TextXAlignment = props.xAlign or Enum.TextXAlignment.Center
	label.TextYAlignment = props.yAlign or Enum.TextYAlignment.Center
	label.TextScaled = props.scaled or false
	label.TextWrapped = props.wrapped or false
	label.RichText = props.rich or false
	label.TextStrokeTransparency = props.stroke == false and 1 or (props.strokeTransparency or 0.35)
	label.TextStrokeColor3 = props.strokeColor or Theme.outline
	label.ZIndex = props.zIndex or 2
	label.LayoutOrder = props.layoutOrder or 0
	label.Parent = parent
	return label
end

-- container vertical com espaçamento
function Theme.list(parent, props)
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = props and props.direction or Enum.FillDirection.Vertical
	layout.Padding = UDim.new(0, props and props.padding or 10)
	layout.HorizontalAlignment = props and props.hAlign or Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = props and props.vAlign or Enum.VerticalAlignment.Top
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = parent
	return layout
end

function Theme.padding(parent, px)
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, px)
	pad.PaddingBottom = UDim.new(0, px)
	pad.PaddingLeft = UDim.new(0, px)
	pad.PaddingRight = UDim.new(0, px)
	pad.Parent = parent
	return pad
end

-- ícone de pet: círculo colorido com emoji grande
function Theme.petIcon(parent, pet, props)
	props = props or {}
	local size = props.size or 72

	local holder = Instance.new("Frame")
	holder.Size = UDim2.fromOffset(size, size)
	holder.BackgroundColor3 = pet.color or Theme.white
	holder.BorderSizePixel = 0
	holder.ZIndex = props.zIndex or 3
	holder.Parent = parent
	corner(holder, math.floor(size / 2))
	stroke(holder, Theme.outline, props.strokeThickness or 3)

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = pet.emoji or "🐾"
	label.ZIndex = holder.ZIndex + 1
	label.Parent = holder

	return holder, label
end

-- arrastar painel pelo cabeçalho
function Theme.makeDraggable(frame, handle)
	local UserInputService = game:GetService("UserInputService")
	local dragging, dragStart, startPos = false, nil, nil

	(handle or frame).InputBegan:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			dragging = false
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end
		if
			input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		then
			local delta = input.Position - dragStart
			frame.Position =
				UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
end

-- Clareia uma cor. Complementa o Style.darken/lighten do servidor: a UI não
-- pode depender de shared/Style (que é do mundo), então tem o dela.
function lighten(color, amount)
	amount = amount or 0.25
	return Color3.new(
		math.min(1, color.R + (1 - color.R) * amount),
		math.min(1, color.G + (1 - color.G) * amount),
		math.min(1, color.B + (1 - color.B) * amount)
	)
end
Theme.lighten = lighten

---------------------------------------------------------------------------
-- VOCABULÁRIO DAS REFERÊNCIAS (placa + cartão de item)
---------------------------------------------------------------------------

-- Placa de título: a plaquinha ESCURA que fica pendurada na borda de cima do
-- painel, com o nome escrito em branco. É o detalhe que dá "loja de verdade"
-- em vez de "formulário de programa". Aparece em todo painel da referência.
function Theme.titleTag(parent, text, props)
	props = props or {}
	local tag = Instance.new("Frame")
	tag.Name = props.name or "TitleTag"
	tag.AnchorPoint = Vector2.new(0.5, 0)
	tag.Position = UDim2.new(0.5, 0, 0, props.offset or -22)
	tag.Size = UDim2.fromOffset(props.width or 220, props.height or 46)
	tag.BackgroundColor3 = props.color or Color3.fromRGB(46, 46, 52)
	tag.BorderSizePixel = 0
	tag.ZIndex = (props.zIndex or 10) + 4
	tag.Parent = parent

	Theme.corner(tag, props.radius or 12)
	Theme.stroke(tag, Color3.fromRGB(26, 26, 30), 3)

	local textLabel = Theme.label(tag, {
		text = text,
		size = UDim2.fromScale(1, 1),
		textSize = props.textSize or 24,
		color = props.textColor or Color3.fromRGB(255, 255, 255),
		strokeTransparency = 1,
		zIndex = tag.ZIndex + 1,
	})
	-- devolve o LABEL, não o frame: o ShopPanel troca o texto entre LOJA e
	-- GEMAS, e agora o texto mora dentro da placa.
	return textLabel
end

-- Cartão de item: o quadrado escuro arredondado da loja, com um "medalhão"
-- redondo no meio e o preço em botão verde embaixo.
-- props: { title, icon (emoji), accent (cor do medalhão), price, onBuy }
function Theme.itemCard(parent, props)
	props = props or {}
	local card = Instance.new("Frame")
	card.Name = props.name or "ItemCard"
	card.Size = props.size or UDim2.fromOffset(150, 176)
	card.BackgroundColor3 = props.color or Color3.fromRGB(58, 58, 64)
	card.BorderSizePixel = 0
	card.ZIndex = props.zIndex or 12
	card.LayoutOrder = props.layoutOrder or 0
	card.Parent = parent

	Theme.corner(card, 18)
	Theme.stroke(card, Color3.fromRGB(30, 30, 34), 3)

	if props.title then
		Theme.label(card, {
			text = props.title,
			size = UDim2.new(1, -10, 0, 34),
			position = UDim2.fromOffset(5, 6),
			textSize = props.titleSize or 15,
			color = Color3.fromRGB(255, 255, 255),
			strokeTransparency = 0.15,
			wrapped = true,
			zIndex = card.ZIndex + 1,
		})
	end

	-- medalhão: círculo com brilho no meio
	local medal = Instance.new("Frame")
	medal.Name = "Medal"
	medal.AnchorPoint = Vector2.new(0.5, 0)
	medal.Position = UDim2.new(0.5, 0, 0, 44)
	medal.Size = UDim2.fromOffset(props.medal or 78, props.medal or 78)
	medal.BackgroundColor3 = props.accent or Color3.fromRGB(120, 200, 120)
	medal.BorderSizePixel = 0
	medal.ZIndex = card.ZIndex + 1
	medal.Parent = card
	Theme.corner(medal, math.floor((props.medal or 78) / 2))
	Theme.stroke(medal, Color3.fromRGB(30, 30, 34), 3)
	if props.accent then
		Theme.gradient(medal, Theme.lighten(props.accent, 0.35), props.accent)
	end

	Theme.label(medal, {
		text = props.icon or "?",
		size = UDim2.fromScale(1, 1),
		textSize = props.iconSize or 34,
		strokeTransparency = 1,
		zIndex = medal.ZIndex + 1,
	})

	-- preço: botão verde com moeda, igual à referência
	if props.price then
		local buy = Theme.button(card, {
			text = "⬤ " .. tostring(props.price),
			size = UDim2.new(1, -16, 0, 34),
			position = UDim2.new(0, 8, 1, -42),
			color = Color3.fromRGB(120, 214, 90),
			textSize = 19,
			radius = 10,
			zIndex = card.ZIndex + 2,
			strokeThickness = 2,
			shadow = false,
		})
		buy.TextXAlignment = Enum.TextXAlignment.Center
		if props.onBuy then
			buy.MouseButton1Click:Connect(props.onBuy)
		end
		card.Buy = buy
	end

	return card
end

return Theme
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Toasts</string>
            <string name="Source"><![CDATA[-- Toasts
-- Mensagens curtas no topo, no estilo dos tycoons (pílula branca com contorno).

local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)

local Toasts = {}

local container

function Toasts.init(gui)
	container = Instance.new("Frame")
	container.Name = "Toasts"
	container.BackgroundTransparency = 1
	container.Size = UDim2.fromOffset(420, 260)
	container.Position = UDim2.new(0.5, 0, 0, 130)
	container.AnchorPoint = Vector2.new(0.5, 0)
	container.Parent = gui

	Theme.list(container, { padding = 8 })
end

function Toasts.push(text, kind)
	if not container then
		return
	end

	local color = Color3.fromRGB(255, 255, 255)
	local textColor = Theme.textDark
	if kind == "error" then
		color = Color3.fromRGB(255, 200, 200)
		textColor = Color3.fromRGB(170, 50, 50)
	elseif kind == "success" then
		color = Color3.fromRGB(205, 255, 205)
		textColor = Color3.fromRGB(50, 130, 70)
	end

	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromOffset(400, 46)
	frame.BackgroundColor3 = color
	frame.BorderSizePixel = 0
	frame.BackgroundTransparency = 1
	frame.ZIndex = 35
	frame.Parent = container
	Theme.corner(frame, 23)

	local label = Theme.label(frame, {
		text = text,
		size = UDim2.new(1, -28, 1, 0),
		position = UDim2.fromOffset(14, 0),
		textSize = 18,
		color = textColor,
		strokeTransparency = 1,
		zIndex = 36,
	})

	TweenService:Create(frame, TweenInfo.new(0.18), { BackgroundTransparency = 0 }):Play()
	TweenService:Create(label, TweenInfo.new(0.18), { TextTransparency = 0 }):Play()

	task.delay(2.4, function()
		TweenService:Create(frame, TweenInfo.new(0.35), { BackgroundTransparency = 1 }):Play()
		TweenService:Create(label, TweenInfo.new(0.35), { TextTransparency = 1 }):Play()
		task.wait(0.4)
		frame:Destroy()
	end)
end

return Toasts
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">WorldUI</string>
            <string name="Source"><![CDATA[-- WorldUI
-- Liga as placas do mapa aos paineis: clicar num ovo abre OVOS,
-- clicar na loja abre LOJA, no portal abre RENASCIMENTO, etc.
-- Também desenha o pet equipado flutuando atrás do jogador.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Net = require(Shared.Net)

local WorldUI = {}

local handlers = {}

function WorldUI.build(handlerMap)
	handlers = handlerMap
	local folder = Workspace:WaitForChild("EggTycoon", 15)
	if not folder then
		warn("[WorldUI] pasta do mapa não encontrada")
		return
	end

	-- Itera os ClickDetectors e roteia o PAI deles. Roteando o detector, o nome
	-- seria "ClickDetector" e nenhuma zona abriria.
	for _, detector in ipairs(folder:GetDescendants()) do
		if detector:IsA("ClickDetector") then
			local target = detector.Parent or detector
			detector.MouseClick:Connect(function(player)
				if player ~= Players.LocalPlayer then
					return
				end
				WorldUI.route(target)
			end)
		end
	end
end

function WorldUI.route(instance)
	local name = instance.Name
	local eggId = instance:GetAttribute("EggId")

	if eggId then
		if handlers.selectEgg then
			handlers.selectEgg(eggId)
		end
		return
	end

	-- Portais: o nome do detector/veu carrega o bioma de destino.
	if name == "PortalClick" then
		local parent = instance.Parent
		local biomeId = parent and parent:GetAttribute("BiomeId")
		if biomeId and handlers.travel then
			handlers.travel(biomeId)
		end
		return
	end

	if name:sub(1, 5) == "Zone_" then
		local zone = name:sub(6)
		if zone:sub(1, 4) == "egg_" then
			local id = zone:sub(5)
			-- "egg_halloween" e zona de loja; ovo normal abre a UI ja no ovo certo
			if GameConfig.egg(id) then
				if handlers.selectEgg then
					handlers.selectEgg(id)
				end
			elseif handlers.zone then
				handlers.zone(zone)
			end
		elseif handlers.zone then
			handlers.zone(zone)
		end
	end
end

---------------------------------------------------------------------------
-- PET FLUTUANTE ATRÁS DO JOGADOR
---------------------------------------------------------------------------

local rigs = {} -- [player] = { models = {}, lastKey }

local function buildPetModel(pet)
	local model = Instance.new("Model")
	model.Name = "Pet_" .. pet.id

	local body = Instance.new("Part")
	body.Size = Vector3.new(3.2, 3.2, 3.2)
	body.Shape = Enum.PartType.Ball
	body.Color = pet.color
	body.Material = pet.rarity == "secret" and Enum.Material.Neon or Enum.Material.SmoothPlastic
	body.Anchored = true
	body.CanCollide = false
	body.CanQuery = false
	body.TopSurface = Enum.SurfaceType.Smooth
	body.Parent = model

	-- olhinhos
	for _, side in ipairs({ -1, 1 }) do
		local eye = Instance.new("Part")
		eye.Size = Vector3.new(0.62, 0.62, 0.62)
		eye.Shape = Enum.PartType.Ball
		eye.Color = Color3.fromRGB(30, 30, 40)
		eye.Material = Enum.Material.SmoothPlastic
		eye.Anchored = true
		eye.CanCollide = false
		eye.CanQuery = false
		eye.Position = body.Position + Vector3.new(side * 0.85, 0.7, -1.35)
		eye.Parent = model
	end

	-- orelhinhas
	local ears = Instance.new("Part")
	ears.Size = Vector3.new(2.6, 1.2, 0.7)
	ears.Color = pet.color
	ears.Material = Enum.Material.SmoothPlastic
	ears.Anchored = true
	ears.CanCollide = false
	ears.CanQuery = false
	ears.Position = body.Position + Vector3.new(0, 1.7, 0)
	ears.Parent = model

	return model, body
end

local PIPE = Instance.new("Folder")
PIPE.Name = "PetRigs"
PIPE.Parent = Workspace

local function ensureRig(player)
	if not rigs[player] then
		rigs[player] = { models = {}, key = "" }
	end
	return rigs[player]
end

function WorldUI.syncPets(snapshot)
	local player = Players.LocalPlayer
	local rig = ensureRig(player)

	local equipped = snapshot.equipped or {}
	local ids = {}
	for _, uid in ipairs(equipped) do
		ids[#ids + 1] = tostring(uid)
	end
	local key = table.concat(ids, ",")
	if key == rig.key then
		return
	end
	rig.key = key

	for _, model in ipairs(rig.models) do
		model:Destroy()
	end
	rig.models = {}

	local petsById = {}
	for _, instance in ipairs(snapshot.pets or {}) do
		petsById[instance.uid] = instance
	end

	local limit = math.min(#equipped, 8) -- visual: no máximo 8 flutuando
	for index = 1, limit do
		local uid = equipped[index]
		local instance = petsById[uid]
		if instance then
			local pet = GameConfig.pet(instance.petId)
			if pet then
				local model, body = buildPetModel(pet)
				model.Parent = PIPE
				rig.models[index] = model
			end
		end
	end
end

function WorldUI.stepPets(dt)
	local player = Players.LocalPlayer
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end

	local rig = rigs[player]
	if not rig then
		return
	end

	local now = os.clock()
	local total = #rig.models
	for index, model in pairs(rig.models) do
		if model.Parent then
			local angle = (index - 1) / math.max(total, 1) * math.pi * 2 + now * 0.8
			local radius = 5.5
			local bob = math.sin(now * 2 + index) * 0.45
			local base = root.Position + Vector3.new(math.cos(angle) * radius, 3 + bob, math.sin(angle) * radius)
			local look = CFrame.lookAt(base, root.Position + Vector3.new(0, 3, 0))

			local body = model:FindFirstChildOfClass("Part")
			if body then
				-- guarda o offset de cada filho relativo ao corpo pra acompanhar
				for _, child in ipairs(model:GetChildren()) do
					if child:IsA("BasePart") and child ~= body then
						if not child:GetAttribute("Offset") then
							child:SetAttribute("Offset", child.Position - body.Position)
						end
					end
				end
				body.CFrame = look
				for _, child in ipairs(model:GetChildren()) do
					if child:IsA("BasePart") and child ~= body then
						local offset = child:GetAttribute("Offset")
						if offset then
							child.CFrame = look * CFrame.new(offset)
						end
					end
				end
			end
		end
	end
end

return WorldUI
]]></string>
