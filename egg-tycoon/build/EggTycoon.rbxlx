		unlock = { kind = "hatched", value = 3 },
		blurb = "Árvores gigantes e cogumelos que brilham.",
		theme = "forest",
		center = { x = 190, y = 0, z = 329 },
		radius = 105,
		colors = {
			grass = { 66, 182, 92 },
			grassDark = { 40, 142, 74 },
			rock = { 152, 174, 158 },
			sand = { 214, 206, 168 },
			accent = { 130, 235, 150 },
			water = { 72, 176, 168 },
		},
		light = {
