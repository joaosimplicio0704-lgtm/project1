      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Noise</string>
          <string name="Source"><![CDATA[-- Noise
-- Ruído determinístico puro (sem Random.new) para gerar terreno.
-- Hash inteiro -> [0,1), interpolação suave e fractal. Tudo função pura:
-- mesma seed + mesmas coordenadas = mesmo mundo em qualquer máquina.

local Noise = {}

local function fract(x)
	return x - math.floor(x)
end

-- Hash 2D barato e estável. Evita `~` (Luau não tem xor) e usa só mul/mod.
local function hash2(ix, iy, seed)
	local h = ix * 374761393 + iy * 668265263 + seed * 1442695040888963407
	h = fract(h / 4294967296) * 4294967296
	h = fract(h * 1103515245 / 65536) * 65536
	return fract(h / 65536)
end

local function smooth(t)
	return t * t * (3 - 2 * t)
end

function Noise.value(x, y, seed)
	seed = seed or 0
	local x0 = math.floor(x)
	local y0 = math.floor(y)
	local fx = smooth(x - x0)
	local fy = smooth(y - y0)

	local a = hash2(x0, y0, seed)
	local b = hash2(x0 + 1, y0, seed)
	local c = hash2(x0, y0 + 1, seed)
	local d = hash2(x0 + 1, y0 + 1, seed)

	local top = a + (b - a) * fx
	local bottom = c + (d - c) * fx
	return top + (bottom - top) * fy
end

-- Soma de oitavas: relevo grande + detalhe fino. Retorna ~[0,1].
function Noise.fbm(x, y, seed, octaves)
	octaves = octaves or 4
	local total, amplitude, frequency, maxValue = 0, 1, 1, 0
	for i = 1, octaves do
		total += Noise.value(x * frequency, y * frequency, (seed or 0) + i * 37) * amplitude
		maxValue += amplitude
		amplitude *= 0.5
		frequency *= 2
	end
	return total / maxValue
end

-- Cume: valor alto vira pico afiado. Bom para montanha nevada.
function Noise.ridged(x, y, seed, octaves)
	local n = Noise.fbm(x, y, seed, octaves)
	return 1 - math.abs(n * 2 - 1)
end

-- Escolhe um item de uma lista ponderada {peso, item} de forma determinística.
function Noise.pick(weighted, t)
	local total = 0
	for _, entry in ipairs(weighted) do
		total += entry[1]
	end
	local target = (t or 0) * total
	local cursor = 0
	for _, entry in ipairs(weighted) do
		cursor += entry[1]
		if target <= cursor then
			return entry[2]
		end
	end
	return weighted[#weighted][2]
end

return Noise
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Pets</string>
          <string name="Source"><![CDATA[-- Pets
-- Estado dos pets de UM jogador: inventário, equipar, renda passiva, fusão.
-- Puro: não conhece `game`, recebe data e devolve resultados.

local GameConfig = require(script.Parent.GameConfig)

local Pets = {}

local MAX_EQUIPPED = 99

function Pets.new(data)
	return data
end

function Pets.find(data, uid)
	for index, instance in ipairs(data.pets) do
		if instance.uid == uid then
			return instance, index
		end
	end
	return nil
end

function Pets.isEquipped(data, uid)
	for _, id in ipairs(data.equipped) do
		if id == uid then
			return true
		end
	end
	return false
end

-- Adiciona um pet novo. Retorna a instância criada.
function Pets.add(data, petId, golden)
	local pet = GameConfig.pet(petId)
	if not pet then
		return nil
	end

	local instance = {
		uid = data.nextUid,
		petId = petId,
		golden = golden or false,
	}
	data.nextUid += 1
	table.insert(data.pets, instance)

	-- raridade maxima já obtida (para a UI mostrar progresso)
	local order = GameConfig.rarity(pet.rarity).order
	if order > (data.stats.bestRarity or 0) then
		data.stats.bestRarity = order
	end
	data.stats.hatched += 1

	return instance
end

-- Equipa se houver slot livre. Retorna ok, motivo.
function Pets.equip(data, uid)
	local instance = Pets.find(data, uid)
	if not instance then
		return false, "pet não encontrado"
	end
	if Pets.isEquipped(data, uid) then
		return false, "já equipado"
	end
	if #data.equipped >= GameConfig.petSlots(data) then
		return false, "sem espaço — compre mais slots"
	end
	table.insert(data.equipped, uid)
	return true
end

function Pets.unequip(data, uid)
	for index, id in ipairs(data.equipped) do
		if id == uid then
			table.remove(data.equipped, index)
			return true
		end
	end
	return false
end

-- Valor efetivo de um pet (renda com bônus dourado)
local function petValue(instance)
	local pet = GameConfig.pet(instance.petId)
	if not pet then
		return 0
	end
	return pet.income * (instance.golden and 1.5 or 1)
end
Pets.value = petValue

-- Equipa o MELHOR conjunto possível: monta a lista do zero e não só preenche
-- slot vazio. Sem isso, o jogador fica preso com os primeiros pets para sempre.
function Pets.autoEquip(data)
	local slots = GameConfig.petSlots(data)
	local ranked = {}
	for _, instance in ipairs(data.pets) do
		if petValue(instance) > 0 then
			ranked[#ranked + 1] = instance
		end
	end
	table.sort(ranked, function(a, b)
		return petValue(a) > petValue(b)
	end)

	local equipped = {}
	for index = 1, math.min(slots, #ranked) do
		equipped[index] = ranked[index].uid
	end
	data.equipped = equipped
end

-- Auto-venda: pets piores que o pior equipado viram moedas.
-- Retorna quantos foram vendidos e quanto rendeu.
function Pets.sellWorseThanEquipped(data)
	if #data.pets == 0 then
		return 0, 0
	end

	local weakest = math.huge
	for _, uid in ipairs(data.equipped) do
		local instance = Pets.find(data, uid)
		if instance then
			weakest = math.min(weakest, petValue(instance))
		end
	end
	if weakest == math.huge then
		return 0, 0
	end

	local count, total = 0, 0
	for index = #data.pets, 1, -1 do
		local instance = data.pets[index]
		if not Pets.isEquipped(data, instance.uid) and petValue(instance) < weakest then
			total += Pets.sellValue(instance)
			table.remove(data.pets, index)
			count += 1
		end
	end

	data.coins += total
	data.stats.coinsEarned += total
	return count, total
end

function Pets.income(data)
	return GameConfig.equippedIncome(data)
end

-- Vende um pet por moedas (proporcional à renda).
function Pets.sellValue(instance)
	local pet = GameConfig.pet(instance.petId)
	if not pet then
		return 0
	end
	return math.floor(pet.income * 120 * (instance.golden and 1.5 or 1))
end

function Pets.sell(data, uid)
	local instance, index = Pets.find(data, uid)
	if not instance then
		return false, "pet não encontrado"
	end
	local value = Pets.sellValue(instance)
	Pets.unequip(data, uid)
	table.remove(data.pets, index)
	data.coins += value
	data.stats.coinsEarned += value
	return true, value
end

-- Fusão: junta 3 pets do mesmo raro+ e devolve 1 do próximo tier.
-- Retorna ok, petResultante | motivo
function Pets.fuse(data, uids)
	if #uids ~= 3 then
		return false, "precisa de 3 pets"
	end

	local targetId, targetGolden
	local rarityOrder = -1

	for _, uid in ipairs(uids) do
		local instance = Pets.find(data, uid)
		if not instance then
			return false, "pet não encontrado"
		end
		local pet = GameConfig.pet(instance.petId)
		if not pet then
			return false, "pet inválido"
		end
		local order = GameConfig.rarity(pet.rarity).order
		if order < 3 then
			return false, "só pets Raro+ podem ser fundidos"
		end
		if targetId then
			if pet.id ~= targetId then
				return false, "os 3 pets precisam ser iguais"
			end
		else
			targetId = pet.id
			targetGolden = instance.golden
			rarityOrder = order
		end
	end

	-- Fusão: escolhe o pet de menor renda com raridade ESTRITAMENTE acima.
	-- Sempre existe um tier acima, então a fusão nunca morre num pet de topo de ovo.
	local base = GameConfig.pet(targetId)
	local upgrade
	local bestIncome = math.huge
	for _, pet in ipairs(GameConfig.Pets) do
		if not pet.secret and GameConfig.rarity(pet.rarity).order > rarityOrder then
			if pet.income < bestIncome then
				bestIncome = pet.income
				upgrade = pet
			end
		end
	end

	-- segurança extra: se o resultado for pior que a base, não funde
	if upgrade and upgrade.income <= base.income then
		upgrade = nil
	end

	if not upgrade then
		return false, "não há tier acima para fundir"
	end

	-- consome os 3
	for _, uid in ipairs(uids) do
		local _, index = Pets.find(data, uid)
		if index then
			Pets.unequip(data, uid)
			table.remove(data.pets, index)
		end
	end

	local created = Pets.add(data, upgrade.id, targetGolden)
	return true, created
end

-- Capacidade total de pets no inventário
Pets.MAX_STORAGE = 200

function Pets.storageFull(data)
	return #data.pets >= Pets.MAX_STORAGE
end

return Pets
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Style</string>
          <string name="Source"><![CDATA[-- Style
-- A linguagem visual do jogo, num lugar só.
--
-- Referência: packs low-poly/cartoon de Roblox (o padrão do gênero) usam
-- COR CHAPADA + superfície lisa, sem material texturizado. Grass/Slate/Rock
-- do Roblox têm ruído fotográfico: de perto parece foto colada no bloco, e
-- de longe o ruído some e vira lama cinza. Trocar por SmoothPlastic com
-- cores saturadas é o que faz a peça ler como "desenho animado".
--
-- Regra: material texturizado só onde o texto É o assunto (areia da praia,
-- água do mar). O resto é cor chapada.

local Style = {}

---------------------------------------------------------------------------
-- MATERIAIS
---------------------------------------------------------------------------

-- Superfície padrão de tudo: cor chapada, sem ruído.
Style.flat = Enum.Material.SmoothPlastic
-- Pedra em bloco: ainda lisa, só que a cor já vem escura/dura.
Style.rock = Enum.Material.SmoothPlastic
-- Brilho (luz, ovo raro, portal): emissivo.
Style.glow = Enum.Material.Neon
-- Água e areia mantêm textura de propósito: são o único lugar onde o
-- material ajuda a ler o que é.
Style.water = Enum.Material.Water
Style.sand = Enum.Material.Sand

---------------------------------------------------------------------------
-- PALETA
-- Saturação alta e valor médio-alto: é assim que o cartoon funciona. Cor
-- pastel demais lava, cor escura demais parece sujeira.
---------------------------------------------------------------------------

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

Style.color = {
	grass = rgb(124, 214, 96),
	grassLight = rgb(150, 232, 118),
	grassDark = rgb(92, 176, 74),
	dirt = rgb(196, 138, 92),
	dirtDark = rgb(158, 104, 66),
	sand = rgb(250, 228, 168),
	sandDark = rgb(232, 202, 140),
	rock = rgb(176, 190, 208),
	rockDark = rgb(134, 148, 170),
	rockDeep = rgb(96, 110, 134),
	wood = rgb(178, 122, 74),
	woodDark = rgb(136, 90, 54),
	white = rgb(252, 252, 255),
	black = rgb(48, 44, 60),
	gold = rgb(255, 200, 60),
	goldDark = rgb(228, 160, 30),
	pink = rgb(255, 158, 202),
	purple = rgb(172, 126, 240),
	blue = rgb(96, 168, 250),
	cyan = rgb(120, 232, 244),
	red = rgb(248, 104, 104),
	orange = rgb(255, 156, 74),
}

-- Escurece uma cor mantendo o matiz. Usado para a "cara de baixo" das peças
-- (a sombra chapada do cartoon) sem virar cinza.
function Style.darken(color, amount)
	amount = amount or 0.18
	return Color3.new(
		math.max(0, color.R * (1 - amount)),
		math.max(0, color.G * (1 - amount)),
		math.max(0, color.B * (1 - amount))
	)
end

function Style.lighten(color, amount)
	amount = amount or 0.18
	return Color3.new(
		math.min(1, color.R + (1 - color.R) * amount),
		math.min(1, color.G + (1 - color.G) * amount),
		math.min(1, color.B + (1 - color.B) * amount)
	)
end

-- Contorno: o "traço preto" do desenho. Um tom bem escuro do próprio matiz
-- funciona melhor que preto puro, que fica cru no 3D.
function Style.outline(color)
	return Color3.new(color.R * 0.42, color.G * 0.40, color.B * 0.48)
end

return Style
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Terrain</string>
          <string name="Source"><![CDATA[-- Terrain
-- Gera o relevo de cada ilha: uma grade de células cúbicas empilhadas.
-- Puro e determinístico (usa Noise), então o mesmo mapa sai em qualquer lugar.
--
-- A grade é local ao bioma, centrada em (0,0); quem chama posiciona as células
-- somando o centro do bioma. Assim o mesmo bioma pode ser desenhado em qualquer
-- bioma sem recalcular ruído.

local Noise = require(script.Parent.Noise)

local Terrain = {}

-- Grade 23x23 (era 17).
-- Com 17, numa ilha de raio 105 cada célula tinha ~13 studs: o relevo virava
-- 4 degraus gigantes e, visto de cima, parecia um xadrez de blocos com vão
-- de areia entre eles — não chão.
-- 23 deixa a célula em ~9 studs, que já lê como chão maciço. Testei 33
-- (célula de 6): o chão fica melhor, mas o .rbxlx saltou de 8 para 24 MB,
-- porque cada célula ocupa ~3 KB de XML. 23 é o ponto de equilíbrio.
Terrain.GridSize = 23
-- Tamanho da célula é derivado do raio do bioma: a grade SEMPRE cobre a
-- ilha inteira. Antes era fixo em 14.95 e, quando as ilhas cresceram, sobrava
-- um anel de ilha sem terreno — chão nenhum, só a base de pedra.
Terrain.CellSize = 14.95
Terrain.CellThickness = 3.2
Terrain.SeaLevel = 0
Terrain.PlateauFloor = 3
Terrain.PlateauRadius = 0.34 -- fração do raio: miolo plano para o ovo

-- Altura do platô central: o miolo da ilha é plano para o ovo e o spawn.
-- Sem isso o ruído faz uma colina no centro e o pedestal afunda no chão.
function Terrain.plateauHeight(biome)
	return biome.height.base + biome.height.amp * 0.3
end

-- Nível da praia na borda da ilha (um pouco abaixo do mar).
Terrain.BeachLevel = -1

-- Altura do relevo (em studs) num ponto normalizado (-1..1 no raio da ilha).
-- Forma: platô plano no miolo, ruído só na encosta, praia caindo na borda.
function Terrain.heightAt(biome, nx, nz)
	local spec = biome.height
	local distance = math.min(1, math.sqrt(nx * nx + nz * nz))
	local plateau = Terrain.plateauHeight(biome)

	-- 1 no centro, 0 na borda. Cúbico para a encosta não cair de repente.
	local blend = 1 - distance * distance * distance

	-- o ruído some dentro do platô e cresce na encosta
	local noiseFade = 0
	if distance > Terrain.PlateauRadius then
		noiseFade = (distance - Terrain.PlateauRadius) / (1 - Terrain.PlateauRadius)
		noiseFade = math.min(1, noiseFade)
	end

	local sample
	if spec.ridged then
		sample = Noise.ridged(nx * 2.4, nz * 2.4, biome.seed or 7, spec.detail)
	else
		sample = Noise.fbm(nx * 2.4, nz * 2.4, biome.seed or 7, spec.detail)
	end

	local relief = plateau + (sample - 0.5) * spec.amp * noiseFade
	-- mistura com a praia: em distance = 1 a altura é BeachLevel
	return Terrain.BeachLevel + (relief - Terrain.BeachLevel) * blend
end

-- Deslocamento do bioma para o centro do mundo, para quem só quer ler posição.
function Terrain.offsetFor(biome)
	return Vector3.new(biome.center.x, biome.center.y, biome.center.z)
end

-- Lista de células: { x, y, z, size, material, color, kind }
-- `kind` é "top" (superfície andável) ou "fill" (enchimento interno).
function Terrain.generate(biome)
	local cells = {}
	local half = math.floor(Terrain.GridSize / 2)
	local thickness = Terrain.CellThickness
	-- cobre 96% do raio do bioma; os 4% restantes viram a praia que já existe
	local radiusCells = biome.radius * 0.96
	local cell = (radiusCells * 2) / (half * 2 + 1)
	-- Cada cubo e desenhado 12% MAIOR que o passo da grade.
	-- Antes era exatamente do tamanho da celula: como as posicoes sao
	-- gx*cell, os cubos se tocavam na borda e qualquer arredondamento
	-- abria uma fresta. Visto de cima o chao virava um xadrez de blocos
	-- soltos com vao entre eles — nada parecia terreno solido.
	-- A sobreposicao fecha os vaos; 12% e invisivel e nao "arredonda"
	-- o relevo.
	local cellFill = cell * 1.12

	for gx = -half, half do
		for gz = -half, half do
			local lx = gx * cell
			local lz = gz * cell
			local distance = math.sqrt(lx * lx + lz * lz) / radiusCells
			if distance <= 1 then
				local height = Terrain.heightAt(biome, lx / radiusCells, lz / radiusCells)
				local topY = math.floor(height / thickness) * thickness
				local columnBase = Terrain.SeaLevel - thickness

				-- praia quando a coluna é rasa
				local kind, color
				if topY < Terrain.BeachLevel + thickness then
					kind = "sand"
					color = biome.colors.sand
				elseif distance > 0.72 then
					kind = "grass"
					color = biome.colors.grassDark
				else
					kind = "grass"
					color = biome.colors.grass
				end

				-- superfície
				cells[#cells + 1] = {
					x = lx,
					y = topY,
					z = lz,
					sx = cellFill,
					sy = thickness,
					sz = cellFill,
					color = color,
					kind = kind,
					top = true,
				}

				-- enchimento até a base, limitado para não criar 40 partes por coluna
				local fillSteps = math.min(4, math.floor((topY - columnBase) / thickness))
				for step = 1, fillSteps do
					cells[#cells + 1] = {
						x = lx,
						y = topY - step * thickness,
						z = lz,
						sx = cellFill,
						sy = thickness,
						sz = cellFill,
						color = biome.colors.grassDark,
						kind = "fill",
						top = false,
					}
				end
			end
		end
	end

	Terrain.lastCellSize = cell
	return cells
end

-- Altura jogável (topo das células) num ponto local do bioma, para apoiar
-- objetos de decoração sem flutuar. Varre a célula mais próxima.
function Terrain.heightAtCell(biome, cells, lx, lz)
	local best, bestDistance = nil, math.huge
	for _, c in ipairs(cells) do
		if c.top then
			local dx, dz = c.x - lx, c.z - lz
			local d = dx * dx + dz * dz
			if d < bestDistance then
				bestDistance, best = d, c
			end
		end
	end
	local reach = (Terrain.lastCellSize or Terrain.CellSize) * 1.6
	if best and bestDistance < reach * reach then
		return best.y + Terrain.CellThickness / 2
	end
	return Terrain.PlateauFloor + Terrain.CellThickness / 2
end

return Terrain
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="12">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="13">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- init.server
-- Bootstrap do servidor: mundo -> remotes -> sessoes -> loop.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Net = require(Shared.Net)

local World = require(script.World)
local Remotes = require(script.Remotes)
local PlayerData = require(script.PlayerData)
local Sessions = require(script.Sessions)
local Game = require(script.Game)
local Effects = require(script.Effects)

World.build()
Effects.init(workspace)

-- Viagem entre biomas: o Game decide SE pode ir, o init.server faz o teleporte.
Game.arrivalFor = function(session, biomeId)
	local character = session.player.Character
	if not character then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local cframe = World.biomeArrival(biomeId)
	if cframe then
		root.CFrame = cframe
	end
end

-- ---------------------------------------------------------------------------
-- FEEDBACK NO MUNDO
-- Cada ação do jogador tem que deixar marca no espaço. Sem isso a mecânica
-- só mexe em número de painel: quem entra no jogo (ou vê um print) não vê
-- nada acontecendo. Onde o efeito nasce: no pé do personagem.
-- ---------------------------------------------------------------------------
local function feetPosition(session)
	local character = session.player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return nil
	end
	return root.Position - Vector3.new(0, 2.6, 0)
end

-- Cor por raridade vem da PROPRIA config (GameConfig.Rarities), em vez de uma
-- tabela duplicada aqui: duplicar garante divergir quando alguem ajustar a
-- paleta, e o efeito sai com a cor errada.
local function rarityColor(rarityId)
	local rarity = GameConfig.RarityById and GameConfig.RarityById[rarityId]
	if rarity and rarity.color then
		return rarity.color
	end
	return Color3.fromRGB(210, 215, 225)
end

Game.fx.tap = function(session, gained)
	local pos = feetPosition(session)
	if not pos then
		return
	end
	-- uma moeda por clique: o jogador vê o dinheiro sair do chão
	Effects.coinBurst(pos + Vector3.new(0, 2, 0), Color3.fromRGB(255, 205, 60), 1)
	Effects.shockwave(pos, Color3.fromRGB(255, 235, 150), 9, 0.4)
end

Game.fx.hatch = function(session, pet, instance)
	local pos = feetPosition(session)
	if not pos then
		return
	end
	local rarity = pet.rarity or "common"
	local color = rarityColor(rarity)
	Effects.hatchBurst(pos + Vector3.new(0, 4, 0), color, rarity == "secret")
	Effects.floatText(pos + Vector3.new(0, 8, 0), pet.name or "Pet", color, 26)
end

Game.fx.equip = function(session)
	local data = session.data
	local equipped = {}
	-- o campo da instancia e petId (nao id): comparar pet.id dava nil e o
	-- pet orbitando nunca aparecia
	for _, uid in ipairs(data.equipped or {}) do
		for _, pet in ipairs(data.pets or {}) do
			if pet.uid == uid then
				local config = GameConfig.pet(pet.petId)
				equipped[#equipped + 1] = {
					color = rarityColor(config and config.rarity or "common"),
					name = config and config.name or "Pet",
				}
			end
		end
	end
	Effects.setOrbit(session.player, equipped)
end

Game.fx.upgrade = function(session, kind, level)
	local pos = feetPosition(session)
	if not pos then
		return
	end
	-- nomes reais em GameConfig.defaultData().upgrades: tap / slots / mult
	local labels = {
		tap = "FORÇA",
		slots = "ESPAÇO DO PET",
		mult = "MULTIPLICADOR",
	}
	Effects.floatText(
		pos + Vector3.new(0, 9, 0),
		string.format("%s NÍVEL %d", labels[kind] or string.upper(kind), level),
		Color3.fromRGB(140, 255, 180),
		20
	)
	Effects.burst(pos + Vector3.new(0, 3, 0), Color3.fromRGB(140, 255, 180), 12, 16, 1.8)
end

-- MINA: o pet volta com o minério na mão. Sem efeito, a mecânica só mexe
-- número no painel e quem está olhando o mundo não vê nada acontecer.
Game.fx.mine = function(session, ore)
	local character = session.player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not ore then
		return
	end
	local color = Color3.fromRGB(ore.color[1], ore.color[2], ore.color[3])
	local at = root.Position + Vector3.new(0, 3, 0)
	Effects.burst(at, color, 26, 20, 3.2)
	Effects.shockwave(at, color, 18, 0.55)
end

Game.fx.rebirth = function(session, rebirths)
	local pos = feetPosition(session)
	if not pos then
		return
	end
	Effects.rebirthWave(pos)
	Effects.floatText(
		pos + Vector3.new(0, 14, 0),
		string.format("REBIRTH %d!", rebirths),
		Color3.fromRGB(255, 225, 110),
		40
	)
end

local remotes = Remotes.setup()
Game.init(remotes)
PlayerData.start()
Game.start()

---------------------------------------------------------------------------
-- SESSAO
---------------------------------------------------------------------------

local function startSession(player)
	local data = PlayerData.load(player.UserId)
	local session = {
		player = player,
		data = data,
		dirty = false,
		tapWindow = {},
		lastSnapshot = 0,
		pendingToast = nil,
	}
	Sessions.byPlayer[player] = session

	-- auto-equipa o melhor em slot livre ao entrar
	require(Shared.Pets).autoEquip(data)

	local character = player.Character or player.CharacterAdded:Wait()
	local root = character and character:WaitForChild("HumanoidRootPart", 10)
	if root and World.spawnCFrame then
		root.CFrame = World.spawnCFrame()
	end
end

local function endSession(player)
	local session = Sessions.get(player)
	if not session then
		return
	end
	Sessions.byPlayer[player] = nil
	PlayerData.release(player.UserId)
end

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function()
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root and World.spawnCFrame then
			task.wait(0.2)
			root.CFrame = World.spawnCFrame()
		end
	end)
	task.spawn(startSession, player)
end)

-- pets orbitando: anda junto com o personagem, então precisa de tick próprio
task.spawn(function()
	while true do
		local dt = task.wait(0.05)
		Effects.step(dt)
	end
end)

Players.PlayerRemoving:Connect(function(player)
	Effects.removePlayer(player)
	endSession(player)
end)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(startSession, player)
end

---------------------------------------------------------------------------
-- ACOES
---------------------------------------------------------------------------

local A = Net.ActionKind

-- ClickDetector dos portais: o jogador clica na placa e viaja.
local zoneBindings = World.getZoneBindings()
for name, binding in pairs(zoneBindings) do
	if binding.portal and binding.detector then
		local targetBiome = name == "portal_hub" and "meadow" or name:gsub("^portal_", "")
		binding.detector.MouseClick:Connect(function(player)
			local session = Sessions.get(player)
			if not session then
				return
			end
			local ok, err = Game.handlers.travel(session, targetBiome)
			if ok then
				Game.pushSnapshot(session)
			elseif err then
				remotes.event:FireClient(player, Net.EventKind.Toast, { text = err, kind = "error" })
			end
		end)
	end
end

remotes.action.OnServerEvent:Connect(function(player, kind, payload)
	local session = Sessions.get(player)
	if not session then
		return
	end

	local ok, err = Game.handle(session, kind, payload)
	if not ok and err then
		remotes.event:FireClient(player, Net.EventKind.Toast, { text = err, kind = "error" })
	end
end)

print(string.format("[EggTycoon] Servidor pronto · %d pets · %d ovos", #GameConfig.Pets, #GameConfig.Eggs))
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Effects</string>
          <string name="Source"><![CDATA[-- Effects
-- Feedback visível NO MUNDO para cada ação do jogador.
--
-- O problema que isto resolve: a mecânica sempre existiu (clicar, chocar ovo,
-- equipar pet, subir de nível, rebirth), mas ela só acontecia no servidor e
-- aparecia em painel de números. Quem olhava o mapa — ou um print dele — não
-- via jogo nenhum acontecendo. Aqui cada ação deixa rastro no espaço:
--
--   tap      -> moeda dourada sobe e some, anel de choque no chão
--   chocar   -> ovo racha, explosão de cor, pet nasce e é lançado pro alto
--   equipar  -> o pet fica orbitando o jogador
--   upgrade  -> letreiro "NÍVEL 2!" subindo
--   rebirth  -> anel gigante atravessa o mapa, tela inteira sente
--
-- Tudo é feito de Part/Neon e TweenService: nada de asset externo.

local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")

local Effects = {}

local folder

function Effects.init(parent)
	folder = Instance.new("Folder")
	folder.Name = "Effects"
	folder.Parent = parent or workspace
end

local function newPart(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = folder
	return p
end

local function tween(part, info, goal)
	local t = TweenService:Create(part, info, goal)
	t:Play()
	return t
end

---------------------------------------------------------------------------
-- PEQUENOS
---------------------------------------------------------------------------

-- Moeda que sobe e some. Uma por clique, com vida de 0.8s.
function Effects.coinBurst(position, color, count)
	count = count or 1
	color = color or Color3.fromRGB(255, 205, 60)
	for i = 1, count do
		local coin = newPart({
			Name = "CoinPop",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.5, 2.6, 2.6),
			Position = position + Vector3.new((math.random() - 0.5) * 5, math.random() * 2, (math.random() - 0.5) * 5),
			Color = color,
		})
		coin.CFrame = CFrame.new(coin.Position) * CFrame.Angles(0, 0, math.pi / 2)
		local dx = (math.random() - 0.5) * 6
		local dz = (math.random() - 0.5) * 6
		tween(coin, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = coin.Position + Vector3.new(dx, 14, dz),
			Transparency = 1,
			Size = Vector3.new(0.3, 0.4, 0.4),
		})
		Debris:AddItem(coin, 0.9)
	end
end

-- Anel de choque no chão: o "tum" de cada clique.
function Effects.shockwave(position, color, radius, lifetime)
	radius = radius or 12
	lifetime = lifetime or 0.45
	local ring = newPart({
		Name = "ShockRing",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 2, 2),
		Position = position + Vector3.new(0, 0.4, 0),
		Color = color or Color3.fromRGB(255, 255, 255),
		Transparency = 0.15,
	})
	ring.CFrame = CFrame.new(ring.Position) * CFrame.Angles(0, 0, math.pi / 2)
	tween(ring, TweenInfo.new(lifetime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.6, radius * 2, radius * 2),
		Transparency = 1,
	})
	Debris:AddItem(ring, lifetime + 0.05)
end

-- Explosão de partículas de cor: nascimento de pet, level up, rebirth.
function Effects.burst(position, color, count, speed, size)
	count = count or 16
	speed = speed or 26
	size = size or 2.4
	for i = 1, count do
		local angle = (i / count) * math.pi * 2 + math.random() * 0.4
		local lift = 0.35 + math.random() * 0.9
		local dir = Vector3.new(math.cos(angle), lift, math.sin(angle))
		local p = newPart({
			Name = "Burst",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(size, size, size) * (0.6 + math.random() * 0.7),
			Position = position,
			Color = color,
			Transparency = 0.05,
		})
		tween(p, TweenInfo.new(0.7 + math.random() * 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = position + dir * (speed * (4 + math.random() * 4)),
			Transparency = 1,
			Size = p.Size * 0.2,
		})
		Debris:AddItem(p, 1.1)
	end
end

-- Texto flutuante no mundo (não é GUI, é parte 3D: aparece em print e de longe).
function Effects.floatText(position, text, color, height)
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(260, 90)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 0, 0)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color or Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0.2
	label.TextStrokeColor3 = Color3.fromRGB(40, 20, 60)
	label.Text = text
	label.Parent = billboard

	local anchor = newPart({
		Name = "FloatAnchor",
		Size = Vector3.new(0.2, 0.2, 0.2),
		Position = position,
		Transparency = 1,
	})
	anchor.Material = Enum.Material.SmoothPlastic
	anchor.CanCollide = false
	billboard.Parent = anchor

	tween(billboard, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		StudsOffsetWorldSpace = Vector3.new(0, height or 16, 0),
	})
	tween(label, TweenInfo.new(1.1), { TextTransparency = 1, TextStrokeTransparency = 1 })
	Debris:AddItem(anchor, 1.2)
end

---------------------------------------------------------------------------
-- GRANDES
---------------------------------------------------------------------------

-- Chocar ovo: o ovo racha em pedaços, um clarão sai de dentro e o pet sobe.
function Effects.hatchBurst(position, rarityColor, isSecret)
	local power = isSecret and 2.2 or 1
	Effects.burst(position, rarityColor, math.floor(20 * power), 22 * power, 2.8 * power)
	Effects.shockwave(position, rarityColor, 26 * power, 0.7)

	local flash = newPart({
		Name = "HatchFlash",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(8, 8, 8),
		Position = position,
		Color = rarityColor,
		Transparency = 0.1,
	})
	tween(flash, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = Vector3.new(34, 34, 34),
		Transparency = 1,
	})
	Debris:AddItem(flash, 0.5)

	-- cascas voando
	for i = 1, 8 do
		local angle = (i / 8) * math.pi * 2
		local shell = newPart({
			Name = "EggShell",
			Size = Vector3.new(2.6, 0.7, 3.4),
			Position = position,
			Color = Color3.fromRGB(250, 244, 232),
		})
		shell.Material = Enum.Material.SmoothPlastic
		tween(shell, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = position + Vector3.new(math.cos(angle) * 18, 10 + math.random() * 8, math.sin(angle) * 18),
			Rotation = shell.Rotation + Vector3.new(math.random() * 200, math.random() * 200, 0),
			Transparency = 1,
		})
		Debris:AddItem(shell, 0.9)
	end

	if isSecret then
		-- arco de luz para o secreto: sobe 60 studs
		local beam = newPart({
			Name = "SecretBeam",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(70, 5, 5),
			Position = position + Vector3.new(0, 34, 0),
			Color = rarityColor,
			Transparency = 0.15,
		})
		beam.CFrame = CFrame.new(beam.Position)
		tween(beam, TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = Vector3.new(80, 22, 22),
			Transparency = 1,
		})
		Debris:AddItem(beam, 1.5)
	end
end

-- Rebirth: um anel que cruza o mapa inteiro, visível de qualquer ilha.
function Effects.rebirthWave(position)
	for i = 0, 2 do
		task.delay(i * 0.18, function()
			local ring = newPart({
				Name = "RebirthWave",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(1.5, 8, 8),
				Position = position + Vector3.new(0, 1, 0),
				Color = Color3.fromRGB(255, 215, 90),
				Transparency = 0.1,
			})
			ring.CFrame = CFrame.new(ring.Position) * CFrame.Angles(0, 0, math.pi / 2)
			tween(ring, TweenInfo.new(1.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Size = Vector3.new(1.5, 900, 900),
				Transparency = 1,
			})
			Debris:AddItem(ring, 1.9)
		end)
	end
	Effects.burst(position + Vector3.new(0, 6, 0), Color3.fromRGB(255, 220, 120), 40, 40, 4)
end

---------------------------------------------------------------------------
-- PET ORBITANDO
---------------------------------------------------------------------------

-- Cada jogador com pet equipado ganha uma cópia 3D do pet girando em volta.
-- Sem isso, "equipar" só muda um número no painel: não há nada no mapa.
local orbits = {}

function Effects.setOrbit(player, petsTable)
	local previous = orbits[player]
	if previous then
		previous.model:Destroy()
		orbits[player] = nil
	end
	if not petsTable or #petsTable == 0 then
		return
	end

	local model = Instance.new("Model")
	model.Name = "PetOrbit_" .. player.Name
	model.Parent = folder

	local orbit = {
		model = model,
		pets = petsTable,
		angle = 0,
		parts = {},
	}
	orbits[player] = orbit
end

-- Chamado pelo loop do servidor: faz os pets girarem em volta do jogador.
function Effects.step(dt)
	for player, orbit in pairs(orbits) do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not root then
			continue
		end
		orbit.angle += dt * 1.1
		local count = math.max(1, #orbit.pets)
		for index, pet in ipairs(orbit.pets) do
			local slot = orbit.parts[index]
			if not slot then
				slot = Instance.new("Part")
				slot.Name = "OrbitPet"
				slot.Shape = Enum.PartType.Ball
				slot.Size = Vector3.new(5, 5, 5)
				slot.Anchored = true
				slot.CanCollide = false
				slot.CanQuery = false
				slot.CanTouch = false
				slot.CastShadow = false
				slot.Material = Enum.Material.SmoothPlastic
				slot.Color = pet.color or Color3.fromRGB(255, 255, 255)
				slot.Parent = orbit.model
				-- bolinha de olho, para ler como bichinho e não como bola
				local eye = Instance.new("Part")
				eye.Name = "Eye"
				eye.Shape = Enum.PartType.Ball
				eye.Size = Vector3.new(1.1, 1.1, 1.1)
				eye.Anchored = true
				eye.CanCollide = false
				eye.CanQuery = false
				eye.CastShadow = false
				eye.Color = Color3.fromRGB(30, 24, 40)
				eye.Parent = orbit.model
				slot:SetAttribute("EyeRef", eye.Name)
				orbit.parts[index] = slot
				orbit.parts["eye" .. index] = eye
			end
			local angle = orbit.angle + (index / count) * math.pi * 2
			local radius = 9 + count * 1.4
			local pos = root.Position
				+ Vector3.new(
					math.cos(angle) * radius,
					6 + math.sin(orbit.angle * 2 + index) * 1.6,
					math.sin(angle) * radius
				)
			slot.CFrame = CFrame.new(pos)
			local eye = orbit.parts["eye" .. index]
			if eye then
				eye.CFrame = CFrame.new(pos + Vector3.new(0, 0.4, 1.9))
			end
		end
	end
end

function Effects.removePlayer(player)
	local orbit = orbits[player]
	if orbit then
		orbit.model:Destroy()
		orbits[player] = nil
	end
end

return Effects
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Game</string>
          <string name="Source"><![CDATA[-- Game
-- Lógica central do servidor: tick de renda, ações do jogador, rebirth.
-- Não desenha nada, não conhece GUI.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.GameConfig)
local Net = require(Shared.Net)
local Pets = require(Shared.Pets)
local Format = require(Shared.Format)

local Sessions = require(script.Parent.Sessions)
local PlayerData = require(script.Parent.PlayerData)
local MineServer = require(script.Parent.MineServer)

local Game = {}

local TICK = 0.25
local remotes
local rng = Random.new(os.time())

function Game.init(remoteSet)
	remotes = remoteSet
	MineServer.init(GameConfig)
end

---------------------------------------------------------------------------
-- HELPERS
---------------------------------------------------------------------------

local function toast(session, text, kind)
	remotes.event:FireClient(session.player, Net.EventKind.Toast, { text = text, kind = kind or "info" })
end

local function addCoins(session, amount)
	local data = session.data
	data.coins += amount
	data.stats.coinsEarned += amount
end

local function addGems(session, amount)
	session.data.gems += amount
end

local function bumpQuest(session)
	-- avança quests automaticamente quando o objetivo é atingido
	local data = session.data
	while true do
		local quest = GameConfig.Quests[data.questIndex]
		if not quest then
			break
		end
		if GameConfig.questProgress(data, quest) < quest.target then
			break
		end
		data.questIndex += 1
		addCoins(session, quest.reward)
		toast(session, "✅ " .. quest.text .. "  +🪙" .. string.format("%d", quest.reward), "success")
	end
end

Game.toast = toast
Game.addCoins = addCoins
Game.bumpQuest = bumpQuest

---------------------------------------------------------------------------
-- TICK
---------------------------------------------------------------------------

function Game.tick(dt)
	for player, session in pairs(Sessions.all()) do
		if player.Parent == Players then
			local data = session.data
			local income = Pets.income(data)
			if income > 0 then
				addCoins(session, income * dt)
			end
			bumpQuest(session)
		end
	end
end

function Game.start()
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(TICK)
			local now = os.clock()
			local dt = math.min(now - last, 2)
			last = now
			Game.tick(dt)
			for player, session in pairs(Sessions.all()) do
				if player.Parent == Players then
					Game.pushSnapshot(session)
				end
			end
		end
	end)

	-- save periódico
	task.spawn(function()
		while true do
			task.wait(30)
			for player, session in pairs(Sessions.all()) do
				if player.Parent == Players then
					PlayerData.markDirty(player.UserId)
				end
			end
		end
	end)
end

---------------------------------------------------------------------------
-- SNAPSHOT
---------------------------------------------------------------------------

function Game.snapshot(session)
	local data = session.data
	return {
		coins = data.coins,
		gems = data.gems,
		crystals = data.crystals,
		rebirths = data.rebirths,
		pets = data.pets,
		equipped = data.equipped,
		upgrades = data.upgrades,
		gemUpgrades = data.gemUpgrades,
		selectedEgg = data.selectedEgg,
		stats = data.stats,
		questIndex = data.questIndex,
		income = Pets.income(data),
		tapPower = GameConfig.tapPower(data),
		slots = GameConfig.petSlots(data),
		luck = GameConfig.luck(data),
		eggBought = data.eggBought,
		rebirthCost = GameConfig.rebirthCost(GameConfig.rate(data), data.rebirths),
		rate = GameConfig.rate(data),
		mine = MineServer.snapshot(session.player, data),
		mineRate = MineServer.rate(session.player, data),
		biome = data.biome or "meadow",
		biomes = Biomes.unlockedMap({
			hatched = data.stats and data.stats.hatched or 0,
			rebirths = data.rebirths or 0,
		}),
	}
end

function Game.pushSnapshot(session)
	remotes.state:FireClient(session.player, Game.snapshot(session))
end

-- snapshot de estado estático (pets, ovos) — enviado uma vez ao entrar
function Game.staticState()
	local eggs = {}
	for _, egg in ipairs(GameConfig.Eggs) do
		eggs[#eggs + 1] = {
			id = egg.id,
			name = egg.name,
			emoji = egg.emoji,
			cost = egg.cost,
			rarities = egg.drops,
		}
	end
	return {
		eggs = eggs,
		pets = GameConfig.Pets,
		rarities = GameConfig.Rarities,
		upgrades = GameConfig.Upgrades,
		gemUpgrades = GameConfig.GemUpgrades,
		rebirth = GameConfig.Rebirth,
		quests = GameConfig.Quests,
	}
end

---------------------------------------------------------------------------
-- AÇÕES
---------------------------------------------------------------------------

local function fail(session, message)
	toast(session, message, "error")
	return false, message
end

-- Ganchos preenchidos pelo init.server (o Game nao conhece jogador/CFrame).
Game.arrivalFor = function() end
-- Feedback no mundo: cada acao deixa rastro visivel (moeda, anel, pet).
-- Sem isto a mecanica so muda numeros no painel e quem olha o mapa nao ve
-- jogo nenhum acontecendo.
Game.fx = {
	tap = function() end,
	hatch = function() end,
	equip = function() end,
	upgrade = function() end,
	rebirth = function() end,
	mine = function() end,
}

Game.handlers = {}

function Game.handlers.tap(session, payload)
	local data = session.data
	local count = math.clamp(tonumber(payload) or 1, 1, 10)
	local gained = GameConfig.tapPower(data) * count
	addCoins(session, gained)
	data.stats.taps += count
	Game.fx.tap(session, gained)
	bumpQuest(session)
	return true
end

function Game.handlers.hatch(session, payload)
	local data = session.data
	local egg = GameConfig.egg(data.selectedEgg)
	if not egg then
		return fail(session, "ovo inválido")
	end
	local bought = data.eggBought[egg.id] or 0
	local price = GameConfig.eggPrice(egg.id, bought)
	if data.coins < price then
		return fail(session, "faltam moedas")
	end
	if Pets.storageFull(data) then
		return fail(session, "inventário cheio — venda alguns pets")
	end
	data.coins -= price
	data.eggBought[egg.id] = bought + 1
	local pet =
		GameConfig.rollPet(egg.id, rng:NextNumber(), rng:NextNumber(), GameConfig.SecretChance / GameConfig.luck(data))
	if not pet then
		return fail(session, "erro ao abrir ovo")
	end
	local instance = Pets.add(data, pet.id, false)

	-- auto-venda: descarta o que é pior que o pior equipado (inventário não trava)
	local soldCount, soldValue = Pets.sellWorseThanEquipped(data)
	Pets.autoEquip(data)
	if soldCount > 0 then
		toast(session, string.format("🪙 %d pets auto-vendidos · +%s", soldCount, Format.number(soldValue)), "info")
	end

	bumpQuest(session)
	remotes.event:FireClient(
		session.player,
		Net.EventKind.Hatch,
		{ petId = pet.id, uid = instance.uid, rarity = pet.rarity }
	)
	Game.fx.hatch(session, pet, instance)
	return true
end

-- MINA DOS PETS
-- Recolhe o minério que os pets trouxeram. Sem uid, recolhe todos os prontos.
function Game.handlers.collectMine(session, uid)
	local data = session.data
	local collected, coins = MineServer.collect(session.player, data, tonumber(uid))
	if #collected == 0 then
		return fail(session, "nenhum pet voltou ainda")
	end

	addCoins(session, coins)

	local best = collected[1].ore
	for _, entry in ipairs(collected) do
		if entry.ore.value > best.value then
			best = entry.ore
		end
	end

	remotes.event:FireClient(session.player, Net.EventKind.Mine, {
		ores = (function()
			local out = {}
			for _, entry in ipairs(collected) do
				out[#out + 1] =
					{ id = entry.ore.id, name = entry.ore.name, color = entry.ore.color, value = entry.ore.value }
			end
			return out
		end)(),
		coins = coins,
		best = { id = best.id, name = best.name, color = best.color },
	})
	Game.fx.mine(session, best)
	Game.pushSnapshot(session)
	return true
end

-- Apressa um pet que está na mina.
function Game.handlers.rushMine(session, uid)
	local ok, reason = MineServer.rush(session.player, session.data, tonumber(uid))
	if not ok then
		return fail(session, reason)
	end
	Game.pushSnapshot(session)
	return true
end

function Game.handlers.equip(session, uid)
	local data = session.data
	uid = tonumber(uid)
	local ok, reason = Pets.equip(data, uid)
	if not ok then
		return fail(session, reason)
	end
	MineServer.sync(session.player, session.data)
	Game.fx.equip(session)
	return true
end

function Game.handlers.unequip(session, uid)
	Pets.unequip(session.data, tonumber(uid))
	MineServer.sync(session.player, session.data)
	Game.fx.equip(session)
	return true
end

function Game.handlers.selectEgg(session, eggId)
	local egg = GameConfig.egg(eggId)
	if not egg then
		return fail(session, "ovo inválido")
	end
	session.data.selectedEgg = eggId
	return true
end

function Game.handlers.buyUpgrade(session, kind)
	local data = session.data
	local tier = data.upgrades[kind]
	if tier == nil then
		return fail(session, "upgrade inválido")
	end
	local cost = GameConfig.upgradeCost(kind, tier)
	if not cost then
		return fail(session, "nível máximo")
	end
	if data.coins < cost then
		return fail(session, "faltam moedas")
	end
	data.coins -= cost
	data.upgrades[kind] = tier + 1
	Game.fx.upgrade(session, kind, tier + 1)
	bumpQuest(session)
	return true
end

function Game.handlers.buyGemUpgrade(session, kind)
	local data = session.data
	local rank = data.gemUpgrades[kind]
	if rank == nil then
		return fail(session, "melhoria inválida")
	end
	local cost = GameConfig.gemCost(kind, rank)
	if not cost then
		return fail(session, "rank máximo")
	end
	if data.gems < cost then
		return fail(session, "faltam gemas")
	end
	data.gems -= cost
	data.gemUpgrades[kind] = rank + 1
	return true
end

function Game.handlers.rebirth(session)
	local data = session.data
	if data.rebirths >= GameConfig.Rebirth.Max then
		return fail(session, "rebirth máximo")
	end
	local cost = GameConfig.rebirthCost(GameConfig.rate(data), data.rebirths)
	if data.coins < cost then
		return fail(session, "faltam " .. Format.number(cost) .. " moedas")
	end

	local crystals = GameConfig.rebirthCrystals(data.rebirths)
	local fresh = GameConfig.defaultData()
	fresh.rebirths = data.rebirths + 1
	fresh.crystals = data.crystals + crystals
	fresh.gems = data.gems
	fresh.gemUpgrades = data.gemUpgrades
	fresh.questIndex = data.questIndex
	fresh.selectedEgg = data.selectedEgg
	fresh.stats = data.stats
	fresh.nextUid = data.nextUid
	-- a coleção de pets é permanente: só moedas, upgrades e ovos comprados resetam
	fresh.pets = data.pets
	fresh.equipped = data.equipped
	fresh.eggBought = {}

	for key, value in pairs(fresh) do
		data[key] = value
	end

	Pets.autoEquip(data)
	remotes.event:FireClient(session.player, Net.EventKind.Rebirth, { rebirths = data.rebirths, crystals = crystals })
	Game.fx.rebirth(session, data.rebirths)
	return true
end

function Game.handlers.sellPet(session, uid)
	local ok, value = Pets.sell(session.data, tonumber(uid))
	if not ok then
		return fail(session, value)
	end
	toast(session, "🪙 +" .. Format.number(value), "success")
	return true
end

function Game.handlers.fuse(session, uids)
	if type(uids) ~= "table" then
		return fail(session, "seleção inválida")
	end
	local ok, result = Pets.fuse(session.data, uids)
	if not ok then
		return fail(session, result)
	end
	toast(session, "✨ " .. GameConfig.pet(result.petId).name, "success")
	return true
end

function Game.handlers.setZone(session, zone)
	-- o servidor informa ao cliente qual UI abrir; usado pelo mundo
	return true
end

-- Viagem entre biomas. O cliente manda o id; o servidor confere o desbloqueio
-- com os dados da sessao e so entao autoriza. Nunca confiar no cliente: sem
-- isso um jogador com 0 rebirths abriria a nebulosa cosmica clicando no portal.
function Game.handlers.travel(session, biomeId)
	local data = session.data
	local biome = Biomes.ById[biomeId]
	if not biome then
		return false, "Mundo desconhecido"
	end

	local unlocked = Biomes.unlockedMap({
		hatched = data.stats and data.stats.hatched or 0,
		rebirths = data.rebirths or 0,
	})

	if not unlocked[biomeId] then
		return false, "🔒 " .. biome.name .. " — " .. Biomes.unlockLabel(biome)
	end

	data.biome = biomeId
	Game.arrivalFor(session, biomeId)
	return true
end

Game.handlers.claimQuest = function(session)
	bumpQuest(session)
	return true
end

-- golden pet event: converte um pet aleatório em dourado
function Game.handlers.golden(session)
	local data = session.data
	local pool = {}
	for _, instance in ipairs(data.pets) do
		if not instance.golden then
			pool[#pool + 1] = instance
		end
	end
	if #pool == 0 then
		return fail(session, "nenhum pet para dourar")
	end
	if data.coins < 50000 then
		return fail(session, "faltam 50K moedas")
	end
	data.coins -= 50000
	local target = pool[rng:NextInteger(1, #pool)]
	target.golden = true
	toast(session, "🌟 " .. GameConfig.pet(target.petId).name .. " ficou dourado!", "success")
	return true
end

function Game.handle(session, kind, payload)
	local handler = Game.handlers[kind]
	if not handler then
		return false, "ação desconhecida"
	end
	local ok, reason = handler(session, payload)
	if ok == nil then
		-- handler antigo sem retorno explicito: trata como sucesso, nunca nil
		return true
	end
	return ok, reason
end

return Game
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">MineServer</string>
          <string name="Source"><![CDATA[-- MineServer.luau — o ciclo da Mina dos Pets no servidor.
--
-- Cada pet EQUIPADO tem uma viagem em andamento. O ciclo é:
--   1. o pet sai (estado "away"), com um minério já sorteado no embarque
--   2. depois de Mine.TripSeconds ele fica "ready" — o minério está na mão
--   3. o jogador recolhe (ou o auto-recolhe faz sozinho, se comprado)
--   4. o pet sai de novo
--
-- O minério é sorteado no EMBARQUE, não na volta. Parece detalhe, mas não é:
-- assim o jogador pode clicar para apressar sabendo o que vai receber, e o
-- valor da taxa é honesto.
--
-- Tudo aqui é determinístico dado o timestamp: o teste consegue rodar o
-- ciclo inteiro sem esperar 7 segundos de verdade.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Mine = require(ReplicatedStorage.Shared.Mine)

local MineServer = {}

-- [player] = { [uid] = { ore = <ore>, startedAt = <clock>, readyAt = <clock> } }
local trips = {}

-- Raridade do pet, para o sorteio. Vem do GameConfig, que é a fonte única.
local config
function MineServer.init(gameConfig)
	config = gameConfig
end

local function now()
	return os.clock()
end

local function newTrip(rarity, rng)
	local ore = Mine.rollOre(rarity, rng())
	return {
		ore = ore,
		startedAt = now(),
		readyAt = now() + Mine.TripSeconds,
	}
end

-- Garante que todo pet equipado tenha uma viagem. Chamar sempre que o jogador
-- equipa, desequipa, entra ou troca de pet: assim a mina nunca fica com vaga
-- fantasma nem com pet trabalhando sem estar equipado.
function MineServer.sync(player, data)
	-- Chave de tabela NÃO pode ser nil em Lua: `trips[nil] = x` é erro de
	-- execução, não de lógica. No jogo player nunca é nil, mas isto aqui é
	-- chamado por snapshot/rate/collect em cadeia, e uma chamada sem player
	-- derrubava o servidor inteiro em silêncio.
	local key = player or "anon"
	local own = trips[key]
	if not own then
		own = {}
		trips[key] = own
	end

	local equipped = {}
	for _, uid in ipairs(data.equipped or {}) do
		equipped[uid] = true
	end

	-- pet que saiu do equipamento perde a vaga
	for uid in pairs(own) do
		if not equipped[uid] then
			own[uid] = nil
		end
	end

	-- pet equipado sem viagem ganha uma
	local rng = Random.new(#data.equipped * 7919 + (data.stats and data.stats.hatched or 0))
	for _, uid in ipairs(data.equipped or {}) do
		if not own[uid] then
			local instance = nil
			for _, pet in ipairs(data.pets or {}) do
				if pet.uid == uid then
					instance = pet
					break
				end
			end
			if instance then
				local pet = config.pet(instance.petId)
				if pet then
					own[uid] = newTrip(pet.rarity, function()
						return rng:NextNumber()
					end)
				end
			end
		end
	end
end

-- Estado atual da mina para o cliente. `progress` é 0..1; `ore` só vai
-- quando o pet já voltou (senão o cliente saberia o prêmio antes da hora).
function MineServer.snapshot(player, data)
	MineServer.sync(player, data)
	local own = trips[player or "anon"] or {}
	local t = now()
	local out = {}

	for _, uid in ipairs(data.equipped or {}) do
		local trip = own[uid]
		if trip then
			local ready = t >= trip.readyAt
			out[#out + 1] = {
				uid = uid,
				progress = Mine.progress(t - trip.startedAt),
				ready = ready,
				oreId = ready and trip.ore.id or nil,
				oreName = ready and trip.ore.name or nil,
				-- o que o pet está buscando: pode mostrar, é o que dá vontade
				-- de esperar. O VALOR é que fica escondido até voltar.
				oreColor = ready and trip.ore.color or nil,
				rushCost = ready and 0 or Mine.rushCost(trip.ore),
			}
		end
	end

	return {
		trips = out,
		best = (data.mine and data.mine.best) or "",
		dug = (data.mine and data.mine.total) or 0,
		tripSeconds = Mine.TripSeconds,
		ores = Mine.ores,
	}
end

-- Recolhe o que o pet trouxe. `uid` nil = recolhe todos os prontos.
-- Devolve uma lista de { ore = <ore>, uid = <uid> } recolhidos e o total.
function MineServer.collect(player, data, uid)
	MineServer.sync(player, data)
	local own = trips[player or "anon"] or {}
	local t = now()
	local collected = {}
	local coins = 0

	local function take(u)
		local trip = own[u]
		if not trip or t < trip.readyAt then
			return
		end
		collected[#collected + 1] = { ore = trip.ore, uid = u }
		coins = coins + trip.ore.value
		data.mine.dug[u] = (data.mine.dug[u] or 0) + 1
		data.mine.total = (data.mine.total or 0) + 1
		-- melhor minério já achado: guarda o de maior valor
		local best = Mine.byId[data.mine.best]
		if not best or trip.ore.value > best.value then
			data.mine.best = trip.ore.id
		end
		-- o pet já sai para a próxima: sem isso o jogador recolhe uma vez e
		-- a mina morre até ele sair e voltar do bioma
		local instance = nil
		for _, pet in ipairs(data.pets or {}) do
			if pet.uid == u then
				instance = pet
				break
			end
		end
		if instance then
			local pet = config.pet(instance.petId)
			if pet then
				local rng = Random.new(t * 1000 + u)
				own[u] = newTrip(pet.rarity, function()
					return rng:NextNumber()
				end)
			end
		end
	end

	if uid then
		take(uid)
	else
		-- BUG que isto evita: `take` recria a viagem (own[u] = newTrip...),
		-- então iterar `pairs(own)` enquanto ele escreve na tabela pode
		-- pular pet ou rodar para sempre. Coleta a lista ANTES.
		local uids = {}
		for u in pairs(own) do
			uids[#uids + 1] = u
		end
		for _, u in ipairs(uids) do
			take(u)
		end
	end

	return collected, coins
end

-- Apressa um pet: cobra o custo e libera o minério na hora.
-- Devolve ok, motivo.
function MineServer.rush(player, data, uid)
	MineServer.sync(player, data)
	local own = trips[player or "anon"] or {}
	local trip = own[uid]
	if not trip then
		return false, "esse pet não está na mina"
	end
	if now() >= trip.readyAt then
		return false, "já voltou — recolha"
	end
	local cost = Mine.rushCost(trip.ore)
	if data.coins < cost then
		return false, "faltam moedas para apressar"
	end
	data.coins = data.coins - cost
	trip.readyAt = now()
	return true
end

-- Quanto a mina rende por segundo no total (todos os pets prontos ou não).
-- Serve para o painel mostrar "isto vale X por minuto" e o jogador comparar
-- com a renda passiva.
function MineServer.rate(player, data)
	MineServer.sync(player, data)
	local own = trips[player or "anon"] or {}
	local total = 0
	for _, trip in pairs(own) do
		total = total + trip.ore.value
	end
	if total <= 0 then
		return 0
	end
	return total / Mine.TripSeconds
end

function MineServer.forget(player)
	trips[player or "anon"] = nil
end

return MineServer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">PlayerData</string>
          <string name="Source"><![CDATA[-- PlayerData
-- Persistencia com DataStoreService + fallback em memoria (Studio sem API).
-- Toda escrita passa por aqui, com retry e BindToClose.

local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))

local PlayerData = {}

local store
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(GameConfig.SaveStore)
	end)
	if ok then
		store = result
	else
		warn("[PlayerData] DataStore indisponivel, salvando apenas em memoria:", result)
	end
end

local cache = {} -- [userId] = data
local dirty = {} -- [userId] = true

local function reconcile(defaults, saved)
	for key, value in pairs(defaults) do
		if type(value) == "table" then
			if type(saved[key]) ~= "table" then
				saved[key] = {}
			end
			reconcile(value, saved[key])
		elseif saved[key] == nil or type(saved[key]) ~= type(value) then
			saved[key] = value
		end
	end
	return saved
end

local function key(userId)
	return "u_" .. tostring(userId)
end

local function read(userId)
	if not store then
		return nil
	end
	local ok, result = pcall(function()
		return store:GetAsync(key(userId))
	end)
	if ok then
		return result
	end
	warn("[PlayerData] GetAsync falhou:", result)
	return nil
end

local function write(userId, data)
	if not store then
		return true
	end
	for attempt = 1, 4 do
		local ok, err = pcall(function()
			store:SetAsync(key(userId), data)
		end)
		if ok then
			return true
		end
		warn(string.format("[PlayerData] SetAsync tentativa %d falhou: %s", attempt, tostring(err)))
		task.wait(1 + attempt)
	end
	return false
end

function PlayerData.load(userId)
	if cache[userId] then
		return cache[userId]
	end

	local saved = read(userId)
	local data = reconcile(GameConfig.defaultData(), type(saved) == "table" and saved or {})
	cache[userId] = data
	return data
end

function PlayerData.get(userId)
	return cache[userId]
end

function PlayerData.markDirty(userId)
	dirty[userId] = true
end

function PlayerData.save(userId)
	local data = cache[userId]
	if not data then
		return
	end
	if write(userId, data) then
		dirty[userId] = nil
	end
end

function PlayerData.release(userId)
	PlayerData.save(userId)
	cache[userId] = nil
	dirty[userId] = nil
end

function PlayerData.start()
	task.spawn(function()
		while true do
			task.wait(90)
			for userId in pairs(dirty) do
				PlayerData.save(userId)
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() then
			return
		end
		for userId in pairs(cache) do
			PlayerData.save(userId)
		end
	end)
end

return PlayerData
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- Remotes
-- Cria/lê os RemoteEvents. Servidor cria, cliente espera.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local Remotes = {}

local function ensure(className, name, parent)
	local instance = parent:FindFirstChild(name)
	if not instance then
		instance = Instance.new(className)
		instance.Name = name
		instance.Parent = parent
	end
	return instance
end

function Remotes.setup()
	local folder = ReplicatedStorage:FindFirstChild(Net.FolderName)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = Net.FolderName
		folder.Parent = ReplicatedStorage
	end
	return {
		folder = folder,
		state = ensure("RemoteEvent", Net.State, folder),
		action = ensure("RemoteEvent", Net.Action, folder),
		event = ensure("RemoteEvent", Net.Event, folder),
	}
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Sessions</string>
          <string name="Source"><![CDATA[-- Sessions
-- Uma sessao por jogador. Fonte unica de verdade no servidor.

local Sessions = {}

Sessions.byPlayer = {} -- [Player] = { data, farm, base }

function Sessions.get(player)
	return Sessions.byPlayer[player]
end

function Sessions.data(player)
	local session = Sessions.byPlayer[player]
	return session and session.data
end

function Sessions.farm(player)
	local session = Sessions.byPlayer[player]
	return session and session.farm
end

function Sessions.all()
	return Sessions.byPlayer
end

return Sessions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[-- World
-- Mapa cartoon low-poly construído em código, no estilo dos tycoons de ovo:
-- palco central, ilhas de ovo, lojas, portal de rebirth e a fonte.
-- Nada de asset externo: tudo Instance.new com cores chapadas.

local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local Net = require(ReplicatedStorage.Shared.Net)
local Biomes = require(ReplicatedStorage.Shared.Biomes)
local Terrain = require(ReplicatedStorage.Shared.Terrain)
local Style = require(ReplicatedStorage.Shared.Style)

local World = {}

-- forward declaration: a cerca do hub e chamada no comeco de World.build(),
-- antes de buildFence estar definida mais abaixo.
local buildFence

local PALETTE = {
	grass = Color3.fromRGB(104, 196, 90),
	grassDark = Color3.fromRGB(76, 160, 70),
	path = Color3.fromRGB(238, 196, 141),
	pathLight = Color3.fromRGB(252, 222, 176),
	pathEdge = Color3.fromRGB(214, 166, 110),
	wood = Color3.fromRGB(150, 100, 62),
	woodDark = Color3.fromRGB(110, 72, 44),
	rock = Color3.fromRGB(178, 190, 205),
	rockDark = Color3.fromRGB(140, 155, 175),
	water = Color3.fromRGB(90, 205, 235),
	sand = Color3.fromRGB(240, 226, 190),
	flower = Color3.fromRGB(255, 150, 190),
	stem = Color3.fromRGB(70, 150, 65),
	white = Color3.fromRGB(250, 250, 250),
	gold = Color3.fromRGB(255, 190, 50),
	goldDark = Color3.fromRGB(230, 150, 30),
	purple = Color3.fromRGB(150, 110, 220),
	purpleDark = Color3.fromRGB(105, 70, 175),
	pink = Color3.fromRGB(255, 170, 210),
	blue = Color3.fromRGB(90, 150, 240),
	portal = Color3.fromRGB(150, 235, 255),
	portalDark = Color3.fromRGB(70, 150, 200),
	stone = Color3.fromRGB(205, 210, 220),
	stoneDark = Color3.fromRGB(150, 158, 172),
	cosmic = Color3.fromRGB(180, 150, 255),
}

World.palette = PALETTE

local function part(props, parent)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = true
	p.Material = props.material or Style.flat
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		if key ~= "material" then
			p[key] = value
		end
	end
	p.Parent = parent

	return p
end

local function ball(props, parent)
	local p = part(props, parent)
	p.Shape = Enum.PartType.Ball
	p.CanCollide = false
	return p
end

local function wedge(props, parent)
	local p = Instance.new("WedgePart")
	p.Anchored = true
	for key, value in pairs(props) do
		p[key] = value
	end
	p.Parent = parent
	return p
end

---------------------------------------------------------------------------
-- INFRA
---------------------------------------------------------------------------

local root

function World.build()
	-- LUZ AMBIENTE GLOBAL
	-- O ambiente do Roblox é escuro por padrão: sombra quase preta, e as ilhas
	-- longe do sol somem. Aqui a luz é lavada de propósito, para o mapa parecer
	-- um desenho: ambiente alto, sombra suave, névoa leve no horizonte.
	-- Números vindos do render, não do olho no Studio: o preview lê estes
	-- valores do build (tools/preview.py, lighting_gain). Com Brightness 3.1
	-- e Exposure 0.35 a ilha estourava — pedra virava branco puro, grama
	-- virava neon e perdia todo o matiz. Cartoon é cor saturada e legível,
	-- não luz forte.
	-- SATURAÇÃO DE LUZ: o problema que o jogador viu na tela.
	--
	-- Três coisas somavam para lavar tudo em branco:
	--   1. Brightness 2.0 + Exposure 0 = a luz do sol já ia no limite
	--   2. as PointLights dos biomas (corrigidas acima, no buildBiome)
	--   3. o Sol em ClockTime 14.2, quase a pino: face horizontal recebe
	--      incidência máxima e é justamente o chão que o jogador olha.
	--
	-- Agora: sol mais baixo (17.5) e mais fraco, exposição levemente
	-- NEGATIVA. Exposição negativa puxa o branco de volta para a cor, é o
	-- ajuste que faz sombra existir e matiz aparecer. Cartoon não é imagem
	-- estourada; é cor chapada com contraste legível.
	-- O alvo NÃO é escurecer: é manter a cor legível. Escuro demais também é
	-- ruim (some o matiz, vira sopa cinza). O que estourava era a SOMA:
	-- sol forte + ambiente altíssimo + holofote na ilha. Tirei o holofote
	-- (buildBiome), trouxe sol e ambiente para perto do padrão do Roblox.
	Lighting.Ambient = Color3.fromRGB(118, 128, 150)
	Lighting.OutdoorAmbient = Color3.fromRGB(156, 170, 196)
	Lighting.Brightness = 1.9
	Lighting.ClockTime = 15.4
	Lighting.GeographicLatitude = -15
	Lighting.EnvironmentDiffuseScale = 0.45
	Lighting.EnvironmentSpecularScale = 0.12
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.55
	Lighting.ExposureCompensation = -0.25
	Lighting.FogColor = Color3.fromRGB(196, 216, 240)
	Lighting.FogStart = 900
	Lighting.FogEnd = 4000

	-- O céu não é opcional: sem um Sky o horizonte fica cinza e as ilhas
	-- distantes somem. Nada de asset pago — o Sky padrão do Roblox já serve.
	if not Lighting:FindFirstChildOfClass("Sky") then
		local sky = Instance.new("Sky")
		sky.SkyboxBk = "rbxasset://textures/sky/sky512_bk.tex"
		sky.SkyboxDn = "rbxasset://textures/sky/sky512_dn.tex"
		sky.SkyboxFt = "rbxasset://textures/sky/sky512_ft.tex"
		sky.SkyboxLf = "rbxasset://textures/sky/sky512_lf.tex"
		sky.SkyboxRt = "rbxasset://textures/sky/sky512_rt.tex"
		sky.SkyboxUp = "rbxasset://textures/sky/sky512_up.tex"
		sky.Parent = Lighting
	end

	local existing = Lighting:FindFirstChildOfClass("Atmosphere")
	local atmosphere = existing or Instance.new("Atmosphere")
	-- Haze alto lava tudo que está longe e Glare cria aquele "borrão de
	-- sol" na tela. Os dois estavam altos demais para um jogo onde a criança
	-- precisa LER o mapa.
	atmosphere.Density = 0.18
	atmosphere.Haze = 0.30
	atmosphere.Glare = 0.0
	atmosphere.Color = Color3.fromRGB(210, 226, 245)
	atmosphere.Decay = Color3.fromRGB(130, 150, 175)
	atmosphere.Parent = Lighting

	local old = Workspace:FindFirstChild("EggTycoon")
	if old then
		old:Destroy()
	end
	root = Instance.new("Folder")
	root.Name = "EggTycoon"
	root.Parent = Workspace

	-- MAR
	-- MAR ORGÂNICO — anéis concêntricos
	-- Histórico das tentativas, porque cada uma falhou por um motivo:
	--   1. quadrado de 760  -> desenhava um QUADRADO em volta das ilhas redondas
	--   2. fatias em anel   -> virou RODA DE BICICLETA (costura entre fatias)
	--   3. placas fora de grade -> cheio de LINHA DE COSTURA onde as bordas se
	--      sobrepunham em degraus
	-- A que funciona: poucos anéis concêntricos, cada um um único cilindro
	-- enorme. Um cilindro não tem costura; e como cada anel tem raio e Y
	-- próprios, não há briga de pixel entre eles.
	local function seaRing(name, radius, y, color, transparency, material)
		local disc = part({
			Name = name,
			Size = Vector3.new(2.4, radius * 2, radius * 2),
			Position = Vector3.new(0, y, 0),
			Color = color,
			Material = material,
			Transparency = transparency,
			CanCollide = false,
			Shape = Enum.PartType.Cylinder,
		}, root)
		disc.CFrame = CFrame.new(disc.Position) * CFrame.Angles(0, 0, math.pi / 2)
		return disc
	end

	-- degraus de água: do centro para fora, cada anel mais escuro
	seaRing("SeaFloor", 596, -34, Color3.fromRGB(56, 132, 150), 0, Enum.Material.Sand)
	seaRing("ShallowWater", 580, -6.0, Color3.fromRGB(126, 228, 238), 0.28, Enum.Material.Water)
	-- halo: a borda do primeiro anel, um tom acima, para a transição não ser
	-- um corte seco de círculo perfeito
	seaRing("SeaHalo", 604, -6.6, Color3.fromRGB(146, 236, 244), 0.52, Enum.Material.Water)

	-- mar fundo: escuro, cobre o horizonte até a névoa
	part({
		Name = "Ocean",
		Size = Vector3.new(4000, 6, 4000),
		Position = Vector3.new(0, -10, 0),
		Color = Color3.fromRGB(44, 132, 186),
		Material = Enum.Material.Water,
		Transparency = 0.18,
		CanCollide = false,
	}, root)

	-- espuma na borda do arquipélago: um anel branco que quebra a linha reta
	for i = 1, 44 do
		local angle = (i / 44) * math.pi * 2
		local wobble = 1 + math.sin(i * 2.7) * 0.06
		local radius = 610 * wobble
		local foam = part({
			Name = "Foam",
			Size = Vector3.new(30, 1.2, 16),
			Position = Vector3.new(math.cos(angle) * radius, -3.4, math.sin(angle) * radius),
			Color = Color3.fromRGB(238, 252, 255),
			Material = Enum.Material.SmoothPlastic,
			Transparency = 0.25,
			CanCollide = false,
		}, root)
		foam.CFrame = CFrame.new(foam.Position) * CFrame.Angles(0, -angle, 0)
	end

	-- ILHA DO HUB — redonda, como as ilhas dos biomas.
	-- Antes era um quadrado de 430 com uma praça quadrada de 300 por cima:
	-- visto de cima parecia uma piscina. Redondo lê como "ilha".
	local hubRadius = 215

	local hubGrass = part({
		Name = "Island",
		Size = Vector3.new(10, hubRadius * 2, hubRadius * 2),
		Position = Vector3.new(0, -4, 0),
		Color = PALETTE.grass,
		Material = Style.flat,
		Shape = Enum.PartType.Cylinder,
	}, root)
	hubGrass.CFrame = CFrame.new(hubGrass.Position) * CFrame.Angles(0, 0, math.pi / 2)

	local dirtRing = part({
		Name = "DirtRing",
		Size = Vector3.new(8, hubRadius * 2.06, hubRadius * 2.06),
		Position = Vector3.new(0, -7, 0),
		Color = Color3.fromRGB(170, 110, 70),
		Material = Style.flat,
		Shape = Enum.PartType.Cylinder,
		CanCollide = false,
	}, root)
	dirtRing.CFrame = CFrame.new(dirtRing.Position) * CFrame.Angles(0, 0, math.pi / 2)

	-- Praia ABAIXO da grama: com o topo dela no mesmo y da grama, ela cobria
	-- a ilha inteira de areia (era isso o "losango marrom" do render).
	local hubBeach = part({
		Name = "Beach",
		Size = Vector3.new(6, hubRadius * 2.12, hubRadius * 2.12),
		Position = Vector3.new(0, -4.2, 0),
		Color = Color3.fromRGB(240, 220, 170),
		Material = Enum.Material.Sand,
		Shape = Enum.PartType.Cylinder,
		CanCollide = false,
	}, root)
	hubBeach.CFrame = CFrame.new(hubBeach.Position) * CFrame.Angles(0, 0, math.pi / 2)

	-- praça central redonda
	local plaza = part({
		Name = "Plaza",
		Size = Vector3.new(3, 190, 190),
		Position = Vector3.new(0, 1.6, 0),
		Color = PALETTE.path,
		Material = Style.flat,
		Shape = Enum.PartType.Cylinder,
	}, root)
	plaza.CFrame = CFrame.new(plaza.Position) * CFrame.Angles(0, 0, math.pi / 2)

	-- ANEL DE CAMINHOS — a roda dentada ligando praça e portais.
	-- É o que faz o hub se ler como "mapa de jogo" e não como um pátio.
	local PORTAL_RING = 138
	local PATH_W = 26
	for i = 1, 56 do
		local angle = (i / 56) * math.pi * 2
		local seg = part({
			Name = "Path",
			Size = Vector3.new(PATH_W, 1.2, 30),
			Position = Vector3.new(math.cos(angle) * PORTAL_RING, 2.2, math.sin(angle) * PORTAL_RING),
			Color = PALETTE.pathLight,
			Material = Style.flat,
			CanCollide = false,
		}, root)
		seg.CFrame = CFrame.new(seg.Position) * CFrame.Angles(0, -angle, 0)
	end

	-- raios: da praça até o anel, um para cada portal
	for i = 1, 7 do
		local angle = (i / 7) * math.pi * 2
		local mid = (95 + PORTAL_RING) / 2
		local spoke = part({
			Name = "Spoke",
			Size = Vector3.new(22, 1.1, PORTAL_RING - 95 + 20),
			Position = Vector3.new(math.cos(angle) * mid, 2.15, math.sin(angle) * mid),
			Color = PALETTE.pathLight,
			Material = Style.flat,
			CanCollide = false,
		}, root)
		spoke.CFrame = CFrame.new(spoke.Position) * CFrame.Angles(0, -angle + math.pi / 2, 0)
	end

	-- cerca do hub: fica FORA do anel de portais (138) e DENTRO da grama (215).
	-- 190 deixa uma faixa de grama entre a cerca e a praia; em 178 sobrava
	-- praia vazia demais e a ilha parecia ter um "colarinho".
	buildFence(Vector3.new(0, 0, 0), 190, 40, Style.color.wood, Style.color.woodDark, root, 2.2, math.pi / 2)

	-- canteiros de grama alta na borda (silhueta cartoon)
	local rng = Random.new(31)
	for i = 1, 26 do
		local angle = (i / 26) * math.pi * 2
		-- Canteiros na borda do hub. O raio sozinho nao basta: com 21 de
		-- largura, um bloco centrado em r=200 avanca ate r=210.5 e passa do
		-- raio 215 da ilha — sobrava um canto flutuando no mar. O raio tem
		-- de descontar a meia-largura.
		local w = 16 + rng:NextNumber() * 10
		local radius = 215 - w / 2 - 6 - rng:NextNumber() * 10
		local x = math.cos(angle) * radius
		local z = math.sin(angle) * radius
		-- A grama do hub tem o topo em y=1.
		--
		-- Antes: UM bloco de até 26x18x27 por canteiro. De perto lia como
		-- caixote verde jogado no gramado, não vegetação. Agora cada canteiro
		-- é um tufo de 3 esferas achatadas de tamanhos diferentes: a silhueta
		-- irregular é o que faz ler como arbusto, e a variação de tom dá
		-- volume sem textura.
		local GROUND_TOP = 1
		local bush = Instance.new("Model")
		bush.Name = "Bush"
		bush.Parent = root
		local base = Vector3.new(x, GROUND_TOP, z)
		for lobe = 1, 3 do
			local d = (w * 0.42) * (1.15 - lobe * 0.16)
			ball({
				Name = "Leaf",
				Size = Vector3.new(d * 1.25, d * 0.72, d * 1.1),
				Position = base + Vector3.new(
					(lobe - 2) * d * 0.42 + rng:NextNumber() * 2,
					d * 0.34,
					(lobe % 2 == 0 and 1 or -1) * d * 0.3 + rng:NextNumber() * 2
				),
				Color = lobe == 2 and Style.color.grass
					or (lobe == 1 and Style.color.grassDark or Style.color.grassLight),
				Material = Style.flat,
			}, bush)
		end
	end

	World.buildTrees()
	World.buildFountain()
	World.buildFestival()
	World.buildEggStands()
	World.buildShop()
	World.buildGemShop()
	World.buildGoldenCrate()
	World.buildMine()
	World.buildFusion()
	World.buildRebirthPortal()
	World.buildTradePost()
	World.buildHalloween()
	World.buildBiomes()

	-- SpawnLocation: sem isso o Roblox joga o jogador no vazio/default do template
	local spawnPad = part({
		Name = "SpawnLocation",
		Size = Vector3.new(18, 1, 18),
		Position = Vector3.new(0, 3.2, 62),
		Color = PALETTE.path,
		Material = Style.flat,
	}, root)

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Size = Vector3.new(16, 0.4, 16)
	spawn.Position = Vector3.new(0, 3.9, 62)
	spawn.Anchored = true
	spawn.CanCollide = false
	spawn.Transparency = 1
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.Parent = root

	-- anel neon marcando o spawn
	part({
		Name = "SpawnRing",
		Size = Vector3.new(17, 0.25, 17),
		Position = Vector3.new(0, 3.75, 62),
		Color = Color3.fromRGB(96, 240, 235),
		Material = Enum.Material.Neon,
		CanCollide = false,
	}, root)

	World.spawnPoint = Vector3.new(0, 5, 62)
end

function World.spawnCFrame()
	return CFrame.new(World.spawnPoint or Vector3.new(0, 5, 60)) * CFrame.Angles(0, math.pi, 0)
end

---------------------------------------------------------------------------
-- DECORACAO
---------------------------------------------------------------------------

-- Árvore low-poly cartoon.
--
-- DOIS defeitos corrigidos aqui:
--   1. A copa usava a paleta GLOBAL. Resultado: bola verde idêntica no
--      prado, no deserto e no gelo. Árvore de bioma tem que puxar a cor do
--      bioma, senão a ilha perde a identidade. `colors` é opcional: sem ele
--      cai na paleta global (é o caso das árvores do hub).
--   2. O tronco era um bloco de 3,6x9 — mais largo que alto, lia como
--      caixote embaixo da copa. Agora são três segmentos afinando para
--      cima, que é como um tronco lê de longe.
-- perfis de árvore: sem isto, uma floresta de 54 árvores é a MESMA árvore
-- 54 vezes. A silhueta é o que diferencia uma árvore da outra de longe, então
-- variamos altura do tronco, largura da copa e inclinação.
local TREE_SHAPES = {
	-- alta e esguia (pinheiro de folha larga)
	{ trunk = 1.55, spread = 0.78, lean = 0 },
	-- clássica, redonda
	{ trunk = 1.0, spread = 1.0, lean = 0 },
	-- baixa e gorda (árvore velha)
	{ trunk = 0.72, spread = 1.25, lean = 0 },
	-- inclinada, como quem cresceu brigando com o vento
	{ trunk = 1.1, spread = 0.95, lean = 0.16 },
}

local function tree(position, scale, parent, colors, shapeIndex)
	local model = Instance.new("Model")
	model.Name = "Tree"
	model.Parent = parent

	-- `colors` chega como tabela {r, g, b} (é o formato de Biomes.luau),
	-- não como Color3. Precisa converter antes de misturar.
	local function toColor(rgb, fallback)
		if not rgb then
			return fallback
		end
		return Color3.fromRGB(rgb[1], rgb[2], rgb[3])
	end

	local leafMain = toColor(colors and colors.grass, Style.color.grass)
	local leafDark = toColor(colors and colors.grassDark, Style.color.grassDark)
	-- `accent` NÃO serve de tom de copa: no prado ele é rosa, e a árvore
	-- ficava com bolas cor-de-rosa. O tom de cima tem que ser o verde
	-- clareado, que é o que o sol bate.
	local leafLight = Style.lighten(leafMain, 0.30)
	local trunkColor = colors and Style.darken(leafDark, 0.32) or Style.color.woodDark

	-- perfil da árvore: escolhido por quem chama (ou sorteado), para a
	-- floresta não ser 54 cópias da mesma silhueta
	local shape = TREE_SHAPES[shapeIndex or 2] or TREE_SHAPES[2]
	local spread = shape.spread
	local lean = shape.lean

	-- tronco: três segmentos, cada um mais fino que o de baixo.
	-- `lean` desloca cada segmento para o lado: tronco torto, não reto.
	local segmentH = 6 * shape.trunk
	for i = 1, 3 do
		local w = 3.4 - (i - 1) * 0.62
		part({
			Name = "Trunk",
			Size = Vector3.new(w, segmentH, w) * scale,
			Position = position + Vector3.new(lean * segmentH * (i - 0.5) * scale, (segmentH * (i - 0.5)) * scale, 0),
			Color = i == 1 and trunkColor or Style.lighten(trunkColor, 0.06),
			Material = Style.flat,
		}, model)
	end

	-- copa: 5 esferas em volta de uma central, cada uma num tom.
	-- A variação de tom é o que dá volume sem precisar de textura.
	local trunkH = segmentH * 3
	local crown = position + Vector3.new(lean * trunkH * scale, trunkH * 1.0 * scale, 0)
	local lobes = {
		{ 0, 0, 0, 1.0, leafLight },
		{ -1.05, -0.18, 0.15, 0.72, leafDark },
		{ 1.05, -0.14, -0.2, 0.78, leafMain },
		{ 0.18, 0.62, 0.55, 0.62, leafLight },
		{ -0.2, 0.5, -0.62, 0.58, leafDark },
	}
	for i, lobe in ipairs(lobes) do
		local d = 11.5 * lobe[4] * spread * scale
		ball({
			Name = "Leaf",
			Size = Vector3.new(d, d * 0.92, d),
			Position = crown + Vector3.new(lobe[1] * 9 * scale, lobe[2] * 7 * scale, lobe[3] * 9 * scale),
			Color = lobe[5],
			Material = Style.flat,
		}, model)
	end
	return model
end

local function flower(position, parent)
	local model = Instance.new("Model")
	model.Name = "Flower"
	model.Parent = parent

	part({
		Size = Vector3.new(0.5, 3, 0.5),
		Position = position + Vector3.new(0, 1.5, 0),
		Color = PALETTE.stem,
		Material = Style.flat,
		CanCollide = false,
	}, model)

	ball({
		Size = Vector3.new(2.4, 2.4, 2.4),
		Position = position + Vector3.new(0, 3.4, 0),
		Color = PALETTE.flower,
		Material = Enum.Material.SmoothPlastic,
	}, model)
	return model
end

function World.buildTrees()
	local rng = Random.new(77)
	for i = 1, 22 do
		local angle = rng:NextNumber() * math.pi * 2
		local radius = 100 + rng:NextNumber() * 62
		local x, z = math.cos(angle) * radius, math.sin(angle) * radius
		tree(Vector3.new(x, 0, z), 1 + rng:NextNumber() * 0.55, root)
	end

	for i = 1, 40 do
		local angle = rng:NextNumber() * math.pi * 2
		local radius = 88 + rng:NextNumber() * 70
		flower(Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius), root)
	end
end

---------------------------------------------------------------------------
-- FONTE CENTRAL
---------------------------------------------------------------------------

function World.buildFountain()
	local model = Instance.new("Model")
	model.Name = "Fountain"
	model.Parent = root

	part({
		Size = Vector3.new(30, 2, 30),
		Position = Vector3.new(0, 1.6, 0),
		Color = PALETTE.white,
		Material = Style.flat,
	}, model)

	part({
		Size = Vector3.new(26, 1.2, 26),
		Position = Vector3.new(0, 2.5, 0),
		Color = PALETTE.water,
		Material = Enum.Material.Water,
		Transparency = 0.2,
		CanCollide = false,
	}, model)

	for i = 1, 2 do
		local size = 26 - i * 7
		part({
			Size = Vector3.new(size, 1.4, size),
			Position = Vector3.new(0, 3 + i * 3.4, 0),
			Color = PALETTE.white,
			Material = Style.flat,
			CanCollide = false,
		}, model)
		part({
			Size = Vector3.new(size - 3, 1, size - 3),
			Position = Vector3.new(0, 3.4 + i * 3.4, 0),
			Color = PALETTE.water,
			Material = Enum.Material.Water,
			Transparency = 0.25,
			CanCollide = false,
		}, model)
	end

	-- bichinho dourado no topo
	ball({
		Size = Vector3.new(7, 7, 7),
		Position = Vector3.new(0, 15, 0),
		Color = PALETTE.gold,
		Material = Enum.Material.Neon,
	}, model)

	ball({
		Size = Vector3.new(4.5, 4.5, 4.5),
		Position = Vector3.new(0, 19.5, 0),
		Color = PALETTE.gold,
		Material = Enum.Material.Neon,
	}, model)
end

---------------------------------------------------------------------------
-- UI DE MUNDO (placa + click detector)
---------------------------------------------------------------------------

-- `facing` e o ponto para onde a placa OLHA (por padrao: o centro do mapa).
-- Sem isso todas as 15 placas nasciam viradas para -Z: a placa do bioma que
-- fica do lado oposto do arquipelago mostrava as costas para quem chegava.
local function makeSign(position, text, color, parent, facing)
	local board = part({
		Name = "Sign_" .. text,
		Size = Vector3.new(16, 6, 0.8),
		Position = position,
		Color = PALETTE.wood,
		Material = Style.flat,
		CanCollide = false,
	}, parent)

	local target = facing or Vector3.new(0, position.Y, 0)
	local dx = target.X - position.X
	local dz = target.Z - position.Z
	if math.sqrt(dx * dx + dz * dz) > 0.5 then
		-- NormalId.Front aponta para -Z local: apontamos o -Z para o alvo
		-- olhando PARA TRAS do alvo.
		local from = Vector3.new(position.X, position.Y, position.Z)
		local to = Vector3.new(from.X - dx, from.Y, from.Z - dz)
		board.CFrame = CFrame.lookAt(from, to)
	end

	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(400, 150)
	gui.LightInfluence = 0.2
	gui.Parent = board

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color or Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0.35
	label.TextStrokeColor3 = Color3.fromRGB(60, 40, 20)
	label.Text = text
	label.Parent = gui

	return board
end

local zoneBindings = {}

local function makeZone(name, position, size, color)
	local hitbox = part({
		Name = "Zone_" .. name,
		Size = size,
		Position = position,
		Color = color or PALETTE.pink,
		Material = Enum.Material.Neon,
		Transparency = 0.72,
		CanCollide = false,
		CanQuery = true,
	}, root)

	local detector = Instance.new("ClickDetector")
	detector.MaxActivationDistance = 32
	detector.CursorIcon = "rbxasset://textures/GunCursor.png"
	detector.Parent = hitbox

	zoneBindings[name] = { part = hitbox, detector = detector, color = color }
	return hitbox
end

function World.getZoneBindings()
	return zoneBindings
end

---------------------------------------------------------------------------
-- OVOS
---------------------------------------------------------------------------

function World.buildEggStands()
	-- O hub nao guarda mais os ovos: cada ovo mora no seu bioma. No lugar
	-- fica a arcada de portais, que e o que o jogador ve ao nascer.
	local deck = part({
		Name = "PortalDeck",
		Size = Vector3.new(150, 2, 40),
		Position = Vector3.new(0, 2.2, -44),
		Color = PALETTE.stone,
		Material = Style.flat,
	}, root)
	deck.CanCollide = true

	part({
		Name = "PortalDeckTrim",
		Size = Vector3.new(152, 0.6, 42),
		Position = Vector3.new(0, 1.4, -44),
		Color = PALETTE.gold,
		Material = Enum.Material.Neon,
		CanCollide = false,
	}, root)

	makeSign(Vector3.new(0, 26, -52), "MUNDOS", Color3.fromRGB(255, 255, 255), root)
end

---------------------------------------------------------------------------
-- LOJAS
---------------------------------------------------------------------------

function World.buildShop()
	local origin = Vector3.new(-104, 0, -14)

	part({
		Size = Vector3.new(28, 1, 24),
		Position = origin + Vector3.new(0, 1.6, 0),
		Color = PALETTE.pathEdge,
		Material = Style.flat,
	}, root)

	-- parede de madeira
	part({
		Size = Vector3.new(26, 18, 2),
		Position = origin + Vector3.new(0, 10, -8),
		Color = PALETTE.wood,
		Material = Style.flat,
	}, root)

	-- telhado azul
	local roof = part({
		Size = Vector3.new(30, 2, 20),
		Position = origin + Vector3.new(0, 20, -2),
		Color = PALETTE.blue,
		Material = Style.flat,
	}, root)
	roof.CFrame = CFrame.new(roof.Position) * CFrame.Angles(math.rad(-18), 0, 0)

	-- vitrine
	part({
		Size = Vector3.new(18, 9, 1),
		Position = origin + Vector3.new(0, 8, -7),
		Color = Color3.fromRGB(255, 240, 200),
		Material = Enum.Material.Neon,
		CanCollide = false,
	}, root)

	-- balcão
	part({
		Size = Vector3.new(22, 4, 5),
		Position = origin + Vector3.new(0, 4, -3),
		Color = PALETTE.woodDark,
		Material = Style.flat,
	}, root)

	for i = -2, 2 do
		ball({
			Size = Vector3.new(3.4, 3.4, 3.4),
			Position = origin + Vector3.new(i * 4, 7.5, -3),
			Color = i % 2 == 0 and PALETTE.gold or PALETTE.pink,
			Material = Enum.Material.Neon,
		}, root)
	end

	makeZone(Net.Zones.Shop, origin + Vector3.new(0, 4, 4), Vector3.new(24, 1, 14), Color3.fromRGB(120, 220, 255))
	makeSign(origin + Vector3.new(0, 25, -7), "LOJA", Color3.fromRGB(255, 255, 255), root)
end

function World.buildGemShop()
	local origin = Vector3.new(104, 0, -14)

	part({
		Size = Vector3.new(28, 1, 24),
		Position = origin + Vector3.new(0, 1.6, 0),
		Color = PALETTE.pathEdge,
		Material = Style.flat,
	}, root)

	part({
		Size = Vector3.new(26, 18, 2),
		Position = origin + Vector3.new(0, 10, -8),
		Color = PALETTE.white,
		Material = Enum.Material.SmoothPlastic,
	}, root)

	local roof = part({
		Size = Vector3.new(30, 2, 20),
		Position = origin + Vector3.new(0, 20, -2),
		Color = PALETTE.purple,
		Material = Style.flat,
	}, root)
	roof.CFrame = CFrame.new(roof.Position) * CFrame.Angles(math.rad(-18), 0, 0)

	-- gema gigante na frente
	local gem = part({
		Size = Vector3.new(7, 9, 7),
		Position = origin + Vector3.new(0, 9, -1),
		Color = Color3.fromRGB(90, 220, 255),
		Material = Enum.Material.Neon,
	}, root)
	gem.CFrame = CFrame.new(gem.Position) * CFrame.Angles(0, math.rad(45), 0)

	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(120, 230, 255)
	light.Brightness = 1.7
	light.Range = 26
	light.Parent = gem

	makeZone(Net.Zones.GemShop, origin + Vector3.new(0, 4, 4), Vector3.new(24, 1, 14), Color3.fromRGB(200, 150, 255))
	makeSign(origin + Vector3.new(0, 25, -7), "MELHORIAS DE GEMAS", Color3.fromRGB(230, 200, 255), root)
end

---------------------------------------------------------------------------
-- CRIAÇÃO DOURADA (o "oven" dourado dos prints)
---------------------------------------------------------------------------

---------------------------------------------------------------------------
-- MINA DOS PETS
---------------------------------------------------------------------------

-- A mina é o lugar onde o pet TRABALHA (ver server/MineServer.luau).
-- Visual: um poço de pedra com trilho de madeira saindo dele. O trilho é o
-- que faz ler "daqui sai minério" sem nenhum texto — a criança vê o carrinho
-- parado no fim da linha e entende que o pet vai e volta por ali.
function World.buildMine()
	local origin = Vector3.new(-96, 0, -62)

	-- laje de pedra
	part({
		Size = Vector3.new(34, 1, 30),
		Position = origin + Vector3.new(0, 1.6, 0),
		Color = Style.color.rockDark,
		Material = Style.rock,
	}, root)

	-- boca do poço: aro de pedra
	local shaft = ball({
		Name = "MineShaft",
		Size = Vector3.new(18, 4, 18),
		Position = origin + Vector3.new(0, 2.4, 2),
		Color = Style.color.rockDeep,
		Material = Style.rock,
	})
	shaft.Shape = Enum.PartType.Cylinder
	shaft.CFrame = CFrame.new(shaft.Position) * CFrame.Angles(0, 0, math.pi / 2)

	-- aro de pedras em volta da boca
	for i = 1, 10 do
		local angle = (i / 10) * math.pi * 2
		ball({
			Name = "ShaftRock",
			Size = Vector3.new(3.4, 3, 3.4),
			Position = origin + Vector3.new(math.cos(angle) * 10, 3, 2 + math.sin(angle) * 10),
			Color = i % 2 == 0 and Style.color.rock or Style.color.rockDark,
			Material = Style.rock,
		})
	end

	-- dois postes de madeira da mina (a "torre" do poço)
	for _, side in ipairs({ -1, 1 }) do
		part({
			Name = "MinePost",
			Size = Vector3.new(2.4, 22, 2.4),
			Position = origin + Vector3.new(side * 9, 12, -6),
			Color = Style.color.wood,
			Material = Style.flat,
		}, root)
	end
	part({
		Name = "MineBeam",
		Size = Vector3.new(22, 2.4, 2.4),
		Position = origin + Vector3.new(0, 23, -6),
		Color = Style.color.woodDark,
		Material = Style.flat,
	}, root)

	-- trilho saindo do poço até a plataforma
	for i = 0, 5 do
		local z = 10 + i * 5
		part({
			Name = "TrackSleeper",
			Size = Vector3.new(11, 1, 2),
			Position = origin + Vector3.new(0, 2.2, z),
			Color = Style.color.woodDark,
			Material = Style.flat,
		}, root)
		for _, side in ipairs({ -1, 1 }) do
			part({
				Name = "TrackRail",
				Size = Vector3.new(1, 1, 5.4),
				Position = origin + Vector3.new(side * 3.4, 3.1, z),
				Color = Style.color.rock,
				Material = Style.flat,
			}, root)
		end
	end

	-- carrinho de minério no fim do trilho
	local cart = Vector3.new(origin.X, origin.Y + 4.6, origin.Z + 36)
	part({
		Name = "MineCart",
		Size = Vector3.new(9, 5, 7),
		Position = cart,
		Color = Style.color.rock,
		Material = Style.rock,
	}, root)
	-- minério brilhando dentro do carrinho
	ball({
		Name = "CartOre",
		Size = Vector3.new(4.6, 3.4, 4.2),
		Position = cart + Vector3.new(0, 2.6, 0),
		Color = Style.color.cyan,
		Material = Style.glow,
	}, root)
	for _, side in ipairs({ -1, 1 }) do
		for _, back in ipairs({ -1, 1 }) do
			local wheel = ball({
				Name = "CartWheel",
				Size = Vector3.new(3.2, 3.2, 1.2),
				Position = cart + Vector3.new(side * 3.6, -3, back * 2.4),
				Color = Style.color.black,
				Material = Style.flat,
			})
			wheel.Shape = Enum.PartType.Cylinder
			wheel.CFrame = CFrame.new(wheel.Position) * CFrame.Angles(0, 0, math.pi / 2)
		end
	end

	-- zona clicável em cima da laje: abre o painel da mina
	local hitbox = makeZone("mine", origin + Vector3.new(0, 8, 6), Vector3.new(30, 16, 26), Style.color.cyan)
	return hitbox
end

function World.buildGoldenCrate()
	local origin = Vector3.new(-96, 0, 62)

	part({
		Size = Vector3.new(26, 1, 22),
		Position = origin + Vector3.new(0, 1.6, 0),
		Color = PALETTE.gold,
		Material = Enum.Material.Neon,
	}, root)

	-- dois "fornos" brancos com painel azul
	for i, offset in ipairs({ Vector3.new(-6, 0, 0), Vector3.new(6, 0, 0) }) do
		local body = part({
			Size = Vector3.new(9, 12, 8),
			Position = origin + offset + Vector3.new(0, 8, 0),
			Color = PALETTE.white,
			Material = Enum.Material.SmoothPlastic,
		}, root)

		part({
			Size = Vector3.new(5.5, 4.5, 0.6),
			Position = body.Position + Vector3.new(0, 0.5, -4.2),
			Color = Color3.fromRGB(90, 200, 245),
			Material = Enum.Material.Neon,
			CanCollide = false,
		}, root)

		part({
			Size = Vector3.new(9.4, 1.2, 8.4),
			Position = body.Position + Vector3.new(0, 6.6, 0),
			Color = PALETTE.gold,
			Material = Enum.Material.Neon,
			CanCollide = false,
		}, root)

		ball({
			Size = Vector3.new(1.6, 1.6, 1.6),
			Position = body.Position + Vector3.new(0, 8.2, 0),
			Color = PALETTE.gold,
			Material = Enum.Material.Neon,
		}, root)
	end

	part({
		Size = Vector3.new(14, 1, 14),
		Position = origin + Vector3.new(0, 3.2, 9),
		Color = PALETTE.gold,
		Material = Enum.Material.Neon,
		Shape = Enum.PartType.Cylinder,
		Transparency = 0.15,
		CanCollide = false,
	}, root)

	makeZone(Net.Zones.Golden, origin + Vector3.new(0, 4, 10), Vector3.new(16, 1, 16), PALETTE.gold)
	makeSign(origin + Vector3.new(0, 20, -1), "CRIAÇÃO DOURADA", PALETTE.gold, root)
end

---------------------------------------------------------------------------
-- FUSÃO SECRETA
---------------------------------------------------------------------------

function World.buildFusion()
	local origin = Vector3.new(96, 0, 62)

	part({
		Size = Vector3.new(26, 1, 22),
		Position = origin + Vector3.new(0, 1.6, 0),
		Color = PALETTE.purpleDark,
		Material = Style.flat,
	}, root)

	-- tubos rosa neon
	for i, offset in ipairs({ Vector3.new(-8, 0, -3), Vector3.new(0, 0, -5), Vector3.new(8, 0, -3) }) do
		local height = i == 2 and 14 or 11
		part({
			Size = Vector3.new(5, height, 5),
			Position = origin + offset + Vector3.new(0, height / 2 + 2, 0),
			Color = PALETTE.pink,
			Material = Enum.Material.Neon,
			Transparency = 0.15,
		}, root)

		part({
			Size = Vector3.new(6, 1.2, 6),
			Position = origin + offset + Vector3.new(0, height + 2.4, 0),
			Color = PALETTE.white,
			Material = Enum.Material.SmoothPlastic,
		}, root)
	end

	part({
		Size = Vector3.new(12, 1, 10),
		Position = origin + Vector3.new(0, 3.2, 8),
		Color = PALETTE.pink,
		Material = Enum.Material.Neon,
		CanCollide = false,
	}, root)

	makeZone(Net.Zones.Fusion, origin + Vector3.new(0, 4, 9), Vector3.new(16, 1, 16), PALETTE.pink)
	makeSign(origin + Vector3.new(0, 22, -4), "FUSÃO SECRETA", Color3.fromRGB(255, 220, 245), root)
end

